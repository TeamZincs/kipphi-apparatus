<script>
    import type { JudgeLine } from 'kipphi';
    import Self from './JudgeLineManager.grain';

    import {
        selectedLineNumber,
        activeSecondarySidebar,
        SecondarySidebar,
        operationList,
        registerReflow
    } from './store';
    import { Op } from 'kipphi';

    let { level = 0, target, children, show = true } = $props<{
        level?: number;
        target: JudgeLine;
        children?: JudgeLine[];
        show?: boolean;
    }>();

    let refreshKey = $state(0);

    let root: HTMLDivElement;

    const values = $node({
        get: () => ({
            moveX: target.moveX,
            moveY: target.moveY,
            rotate: target.rotate,
            alpha: target.alpha,
            refreshKey
        })
    });

    let folded = $state(false);
    let lineName = $state(target.name);

    const displays = $node({
        get: () => selectedLineNumber.get() === target.id,
        listen: (update) => selectedLineNumber.subscribe(update)
    });

    function scrollIntoView() {
        if (selectedLineNumber.get() !== target.id || !root) return;

        // 滚动前先检测一下：root 往上找祖先，如果祖先的 scrollTop 为 0 则不平滑滚动
        let cur: HTMLElement = root;

        while (cur && !cur.matches('.judgelines-manager')) {
            cur = cur.parentElement;
        }

        root.scrollIntoView({
            behavior: cur?.scrollTop <= 20 ? 'instant' : 'smooth',
            block: 'center',
            inline: 'center'
        });
    }

    function handleClick() {
        if (displays) {
            // 已经激活，则全局跳转到此判定线管理
            activeSecondarySidebar.set(SecondarySidebar.LINE);
        } else {
            selectedLineNumber.set(target.id);
        }
    }
</script>

<div class="judgeline-manager {displays ? 'selected' : ''}"
    style="margin-left: {level}em; display: {show ? '' : 'none'}; position: {children?.length ? 'sticky' : ''}; z-index: {children?.length ? 1 : 0}; top: {level * 3}em"
    onclick={handleClick}
    bind:this={root}
    >
    <span class="id">{target.id}</span>
    <input class="name" bind:value={lineName} onclick={(e) => e.stopPropagation()}
        onchange={() => operationList.do(new Op.JudgeLineRenameOperation(target, lineName))}
    >
    <span>x</span><span>{values.moveX?.toFixed?.(2)}</span>
    <span>y</span><span>{values.moveY?.toFixed?.(2)}</span>
    <span class="triangle {children?.length > 0 ? '' : 'hidden'} {folded ? 'folded' : ''}"
        onclick={(e) => {folded = !folded; e.stopPropagation()}}
        ></span>
    <span>θ</span><span>{values.rotate !== undefined ? (values.rotate * 180 / Math.PI).toFixed?.(2) : "N/A"}</span>
    <span>α</span><span>{values.alpha !== undefined ? Math.round(values.alpha).toString?.(16) + "/" + Math.round(values.alpha) : "N/A"}</span>
</div>
{#if children}
    {#for child of children}
        <Self
            target={child}
            children={[...child.children].sort((a, b) => a.id - b.id)}
            level={level + 1}
            show={!folded}
        />
    {/for}
{/if}

<script onmount>
    // 父级要"重画判线列表"时喊一声：bump 一下 refreshKey，`values` 跟着重算
    registerReflow(() => (refreshKey += 1));
    selectedLineNumber.subscribe(scrollIntoView);
</script>

<style>
.judgeline-manager {
  display: grid;
  grid-template-columns: 2.8em repeat(2, 1fr 3fr);
  grid-template-rows: auto 1fr 1fr auto;
  grid-gap: 0.1em;
  font-size: var(--font-size-smaller);
  padding: 0.5em;
  width: 100%;
  background-color: #ddd;
  border-radius: 4px;
  box-sizing: border-box;
  top: 0;
  contain: layout;
}
.judgeline-manager.selected {
  background-color: aquamarine;
}
.id {
  grid-row: 1 / 3;
  font-size: var(--font-size-small);
}
.name {
  grid-column: 2 / 6;
  font-size: 150%;
}
.triangle {
  grid-row: 3 / 4;
  grid-column: 1 / 2;
  display: inline-block;
  width: 0;
  height: 0;
  border-left: 0.5em solid transparent;
  border-right: 0.5em solid transparent;
  border-top: 1em solid black;
}
.triangle.folded {
  transform: rotate(-90deg);
}
.triangle.hidden {
  border-top-color: transparent;
}
span {
  overflow: clip;
  width: 100%;
}
</style>
