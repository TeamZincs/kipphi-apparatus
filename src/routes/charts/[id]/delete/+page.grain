<script>
    import Navigator from "#/components/Navigator.grain";
    import { route } from "@graints/runtime";
    import { _ } from "#/i18n";
    import { disposeChart as delChart, queryCharts, queryMeta, readChart } from "#/background";
    import ImageLoader from "#/components/ImageLoader.grain";
    import DestructiveButton from "#/components/buttons/DestructiveButton.grain";

    // 原来是 `+page.ts` 的 load
    let chartInfo = $state(null);
    let inKPA = $state(false);
    let time = $state(0);
    let meta = $state({ TRASH_DIR: '' });

    async function deleteChart() {
        if (!chartInfo) return;

        await delChart(chartInfo.identifier);
        window.location.href = '/';
    }
</script>

<main>
    <Navigator />
    <div id="content">
        {#if chartInfo}
            <p>
                {_("delete.confirm", {
                    values: {
                        name: chartInfo.title,
                        id: chartInfo.identifier,
                    },
                })}<br>
                {    inKPA
                ? _("delete.alreadyWritten", {values: {mins: Math.round(time / 60) ?? 0}})
                : _("delete.notKPA")
                }<br>
                {
                    _("delete.hint", {values: {path: meta.TRASH_DIR}})
                }
            </p>
            <DestructiveButton onclick={deleteChart}>{_("delete.delete")}</DestructiveButton>
        {:else}
            <p>{_("delete.notFound")}</p>
        {/if}
    </div>
    {#if chartInfo}
    <ImageLoader chartId={chartInfo?.identifier} filename={chartInfo?.illustration} alt={chartInfo?.identifier} style="object-fit: cover; height: 100%"/>
    {/if}
</main>

<script onmount>
    void (async () => {
        const id = route.get().params.id;
        const infos = await queryCharts();

        chartInfo = infos.find((info) => info.identifier === id) ?? null;

        if (chartInfo) {
            const loaded = await readChart(id, chartInfo.chartPath);

            if ('META' in loaded) {
                inKPA = false;
                time = 0;
            } else {
                inKPA = true;
                time = (loaded as { chartTime: number }).chartTime;
            }
        }

        meta = (await queryMeta()) as { TRASH_DIR: string };
    })();
</script>

<style>
    main {
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    #content {
        position: relative;
        font-size: 4vh;
        z-index: 1;
        position: absolute;
        width: 100%;
        height: 100%;
        backdrop-filter: blur(16px) brightness(40%);
        color: white;
        padding-top: 10vh;
        padding-left: 10vw;
        padding-right: 10vw;
        box-sizing: border-box;
        flex: 1;
        align-content: center;
    }
</style>
