<script>
  let { value = $bindable([0, 0, 0] as [number, number, number]), disabled = false } = $props<{
    value?: [number, number, number];
    disabled?: boolean;
  }>();

  /**
   * 整元组替换。
   *
   * 原先是 `bind:value={value[0]}` —— 直接改数组元素。grain 里那样改的是同一个数组引用，
   * 父组件的绑定感知不到，所以这里改成"换一个新数组再写回"。
   */
  function setAt(index: 0 | 1 | 2, next: number) {
    const tuple: [number, number, number] = [value[0], value[1], value[2]];

    tuple[index] = Number.isFinite(next) ? next : 0;
    // 阻止分母为 0
    if (tuple[2] === 0) tuple[2] = 1;

    value = tuple;
  }
</script>

<div class="fraction-input">
  <!-- 第一行：输入框 -->
  <input
    type="number"
    class="input-cell integer"
    bind:value={ get: () => value[0], set: (v) => setAt(0, v) }
    disabled={disabled}
  />
  <input
    type="number"
    class="input-cell numerator"
    bind:value={ get: () => value[1], set: (v) => setAt(1, v) }
    disabled={disabled}
  />

  <!-- 第二行：分数线 -->
  <div class="divider"></div>
  <div></div>

  <!-- 第三行：分母输入框 -->
  <input
    type="number"
    class="input-cell denominator"
    bind:value={ get: () => value[2], set: (v) => setAt(2, v) }
    disabled={disabled}
  />
</div>

<style>
.fraction-input {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr auto 1fr;
  gap: 4px;
}
.integer {
  grid-row: 1 / 4;
}
.numerator {
  grid-column: 2 / 3;
  grid-row: 1 / 2;
}
.denominator {
  grid-column: 2 / 3;
  grid-row: 3 / 4;
}
.input-cell {
  border: var(--input-border-width) solid var(--input-border-color);
  border-radius: var(--border-radius);
  font-family: 'phigros';
  padding-inline: 0.25em;
  min-width: 0;
  width: 4em;
  margin: auto;
  text-align: center;
  font-size: var(--font-size-smaller);
  box-sizing: border-box;
  padding: 0.1em;
}
.input-cell:focus {
  font-family: 'Consolas', monospace;
}
.input-cell:focus {
  outline: none;
  border-color: #2196F3;
  box-shadow: 0 0 0 2px rgba(33, 150, 243, 0.2);
}
.divider {
  grid-column: 2;
  grid-row: 2 / 3;
  border-bottom: 2px solid #eee;
  width: 90%;
  margin: 0 auto;
}
</style>
