<script>
    let { value = $bindable(0), label, title, max, min, suffix, loops, step = 1 } = $props<{
        value?: number;
        label?: string;
        title?: string;
        max?: number;
        min?: number;
        suffix?: string;
        loops?: boolean;
        step?: number;
    }>();

    /** 夹到 [min, max]；`loops` 时越界就绕回另一端 */
    function normalize(candidate: number) {
        if (max !== undefined && candidate > max) return loops ? min : max;
        if (min !== undefined && candidate < min) return loops ? max : min;

        return candidate;
    }

    function apply(candidate: number) {
        value = normalize(candidate);
    }

    function nudge(delta: number) {
        value = normalize(value + delta);
    }

    function len(str: string) {
        return str.replace(/[^\x00-\xff]/g, 'mm').length / 2;
    }
</script>

<div class="arrowed-input {suffix ? 'has-suffix' : ''}">
    <input type="number" step={step} bind:value={ get: () => value, set: apply }>
    <span class="up" onclick={() => nudge(step)}>↑</span>
    <span class="down" onclick={() => nudge(-step)}>↓</span>
    {#if suffix}
        <span class="suffix" style="font-size: {Math.min(5 / len(suffix), 1)}em; line-height: 2em">{suffix}</span>
    {/if}
</div>

<style>
div.arrowed-input {
  display: grid;
  grid-template-rows: 1fr 1fr;
  grid-template-columns: 1fr auto;
  position: relative;
  margin-inline: auto;
  font-size: var(--font-size-medium);
  gap: 2px;
}
input {
  border: var(--input-border-width) solid var(--input-border-color);
  border-radius: var(--border-radius);
  font-family: 'phigros';
  padding-inline: 0.25em;
  min-width: 0;
  box-sizing: border-box;
  font-size: var(--font-size-medium);
  min-width: 3em;
  grid-row: 1 / 3;
  border-radius: 4px;
}
input:focus {
  font-family: 'Consolas', monospace;
}
.suffix {
  position: absolute;
  right: 3vh;
  bottom: 0;
  color: #888;
  pointer-events: none;
  user-select: none;
  font-size: var(--font-size-medium);
}
span {
  text-align: center;
  cursor: pointer;
}
.up,
.down {
  background-color: white;
  color: black;
  border-radius: 2px;
  font-size: var(--font-size-smaller);
}
</style>
