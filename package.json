{
    "name": "kipphi-apparatus",
    "version": "2.2.0-beta.2",
    "private": true,
    "type": "module",
    "description": "Kipphi Apparatus - monorepo (desktop / mobile / shared / canvas)",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "cd apps/desktop && bun run dev",
        "dev:mobile": "cd apps/mobile && bun run dev:portrait",
        "build": "cd apps/desktop && bun run build",
        "typecheck": "cd apps/desktop && bun run typecheck",
        "tauri": "cd apps/desktop && bun run tauri",
        "locales": "cd apps/desktop && bun run locales",
        "watchLocales": "cd apps/desktop && bun run watchLocales",
        "build:electron": "cd apps/desktop && bun run build:electron",
        "fix:bom": "bun scripts/fix-bom.ts"
    },
    "license": "MIT"
}
