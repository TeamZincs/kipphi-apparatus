<script>
    /*
     * 文本输入框，样式和 `NumField` 保持一致（同一个 padding / 圆角 / 配色）。
     *
     * `value` 用 `bind:value={ get, set }` —— 和 `NumField` 同一套契约
     *（`$node` / `$store` 给的就是绑定对象）。
     *
     * 和 `NumField` 一样**失焦才回传**，避免每敲一个字符就往撤销栈里塞一条。
     */
    let { value, placeholder = "", disabled = false } = $props<{
        value: { get: () => string; set: (next: string) => void };
        placeholder?: string;
        disabled?: boolean;
    }>();

    /** 聚焦期间用本地文本，失焦才写回 */
    let text = $state("");
    let focused = $state(false);

    function onFocus(): void {
        focused = true;
        text = value.get();
    }

    function commit(): void {
        focused = false;

        const next = text.trim();
        const current = value.get();

        // 没变就不回传；空值也不写，免得把已有内容清掉
        if (next.length > 0 && next !== current) value.set(next);
    }
</script>

<!--
    属性必须写成 `name={值}`。

    `{placeholder}` / `{disabled}` 这种简写在这个编译器版本里不会展开 ——
    产物是 `<input {placeholder}="true" {disabled}="true">`，既不生效又会
    让 `value` 相关的插槽错乱（输入框永远是空的）。
-->
<input
    class="text"
    type="text"
    placeholder={placeholder}
    disabled={disabled}
    value={focused ? text : value.get()}
    bind:value={text}
    onfocus={onFocus}
    onblur={commit}
    onkeydown={(event) => {
        if (event.key === "Enter") {
            (event.currentTarget as HTMLInputElement).blur();
        }
    }}
/>

<style>
    .text {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        /* 和 `NumField` 的 `.num` 完全一致 */
        padding: 8px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        appearance: none;
        -webkit-appearance: none;
    }
</style>
