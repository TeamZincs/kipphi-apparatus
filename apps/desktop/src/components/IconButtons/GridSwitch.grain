<script>
    let { onchange: onChange, checked = $bindable(false) } = $props<{
        onchange?: (checked: boolean) => void;
        checked?: boolean;
    }>();

    function toggle() {
        checked = !checked;
        onChange?.(checked);
    }
</script>

<div class="icon-button" role="button" onclick={toggle}>
    <svg
        style="width: 100%; height: 100%;"
        width="200"
        height="200"
        viewBox="0 0 200 200"
        xmlns="http://www.w3.org/2000/svg"
    >
        <g transform-origin="center" transform="scale(0.75, 0.75)" stroke={checked ? '#5f9' : '#f8f9fa'}>
            <path stroke-width="16" stroke-linecap="round" class="grid-line horizontal" d="M20,100 H180" />
            <path stroke-width="16" stroke-linecap="round" class="grid-line horizontal" d="M20,20 H180" />
            <path stroke-width="16" stroke-linecap="round" class="grid-line horizontal" d="M20,180 H180" />

            <path stroke-width="16" stroke-linecap="round" class="grid-line vertical" d="M100,20 V180" />
            <path stroke-width="16" stroke-linecap="round" class="grid-line vertical" d="M20,20 V180" />
            <path stroke-width="16" stroke-linecap="round" class="grid-line vertical" d="M180,20 V180" />
        </g>
    </svg>
</div>
