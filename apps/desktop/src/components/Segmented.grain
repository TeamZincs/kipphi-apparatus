<script>
    /*
     * 排形按钮组：组内密接、无圆角，只有整组圆角；选中填强调色。
     *
     * `value` 用 `bind:value={ get: …, set: … }` 传，写回时由父级负责落操作。
     */
    /*
     * 值由 `bind:value={ get: …, set: … }` 传进来；它的 `listen` 通知由运行时
     * 接到组件的 `setProps`，这里不需要自己订阅。
     */
    let { options, value, variant = "solid" } = $props<{
        /** `[值, 显示文字]` 列表 */
        options: [number, string][];
        value: { get: () => number; set: (v: number) => void };
        /**
         * `solid`（默认）：整组外框 + 选中填充强调色；
         * `plain`：只有文字和项间竖线，选中项文字变强调色。
         */
        variant?: "solid" | "plain";
    }>();
</script>

<div class="segmented {variant}">
    {#for option of options with key = option[0]}
        <button
            class="seg {value.get() === option[0] ? "on" : ""}"
            onclick={() => value.set(option[0])}
        >{option[1]}</button>
    {/for}
</div>

<style>
    .segmented {
        display: flex;
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
    }

    .seg {
        flex: 1 1 0;
        min-width: 0;
        /* 纵向收紧：这排常用值是辅助，不该占掉一整行的高度 */
        padding: 3px 8px;
        border: none;
        border-right: 1px solid var(--border);
        background: var(--bg);
        color: var(--text-dim);
        font: inherit;
        font-size: 11px;
        line-height: 1.4;
        text-align: center;
        /* 不要把内容藏进省略号：宁可挤，也要完整显示 */
        white-space: nowrap;
        cursor: pointer;
    }

    .seg:last-child {
        border-right: none;
    }

    .seg.on {
        background: var(--accent, #4c8dff);
        color: #fff;
    }

    /* 无框形式：只有文字 + 项间竖线，选中项文字上色 */
    .segmented.plain {
        border: none;
        border-radius: 0;
        overflow: visible;
    }

    .segmented.plain .seg {
        padding: 2px 8px;
        background: none;
        border-right: none;
        color: var(--text-dim);
    }

    .segmented.plain .seg + .seg {
        border-left: 1px solid var(--border);
    }

    .segmented.plain .seg.on {
        background: none;
        color: var(--accent, #4c8dff);
        font-weight: 600;
    }
</style>
