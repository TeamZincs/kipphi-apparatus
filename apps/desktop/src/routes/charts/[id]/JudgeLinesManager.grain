<script>
import type { Chart } from "kipphi";
import { JudgeLineGroup as KPJudgeLineGroup } from "kipphi";
import JudgeLinePalette from "./JudgeLineManager.grain";

import { _ } from "#/i18n";
    import PopupOption from "#/components/PopupOption/PopupOption.grain";
    import JudgeLineGroup from "./JudgeLineGroup.grain";
    import ProgressiveButton from "#/components/buttons/ProgressiveButton.grain";
    import { reflowAll } from "./store";

const ORDERED = 0b001;
const TREE = 0b010;
const GROUPED = 0b100;

let { chart } = $props<{ chart: Chart }>();

let layout = $state(ORDERED);
let newGroupName = $state("");

let key = $state(0);
let judgeLineGroups = $state([...chart.judgeLineGroups]);

export function ForceReflow() {
    key++;
}

/** 兼容旧调用点：真正干活的判线节点自己登记在 store 的 reflow 表里 */
export function update() {
    reflowAll();
}
</script>

<PopupOption wide
    displayTexts={[
        _("main.sidebar.judgeLineLayout.ordered"),
        _("main.sidebar.judgeLineLayout.tree"),
        _("main.sidebar.judgeLineLayout.group")]}
    options={[ORDERED, TREE, GROUPED]}
    bind:currentOption={layout}
    ></PopupOption>
<div class="judgelines-manager" data-key={key}>
    {#if layout === ORDERED}
        {#for judgeLine of chart.judgeLines with key = judgeLine}
            <!-- 按序布局是平的：不展开子判定线 -->
            <JudgeLinePalette target={judgeLine} flat={true}/>
        {/for}
    {:else if layout === TREE}
        {#for judgeLine of chart.orphanLines with key = judgeLine}
            <JudgeLinePalette level={0} target={judgeLine}/>
        {/for}
    {:else if layout === GROUPED}
        {#for group of judgeLineGroups with key = group}
            <JudgeLineGroup target={group}/>
        {/for}
        <div class="flex-row">
        <input type="text" placeholder={_("main.lines.name")} bind:value={newGroupName}/>
        <ProgressiveButton onclick={
            () => {
                const group = new KPJudgeLineGroup(newGroupName);
                chart.judgeLineGroups.push(group);
                judgeLineGroups = [...chart.judgeLineGroups];
                // 暂时不做删除组，创建组是非操作，不入栈

            }
        }>+</ProgressiveButton>
        </div>
        
    {/if}
</div>

<style>
.judgelines-manager {
  display: flex;
  flex-direction: column;
  contain: layout;
  width: 100%;
  padding: 4px;
  box-sizing: border-box;
  gap: 4px;
  height: auto;
  min-height: 50vh;
  overflow: auto;
  scrollbar-width: none;
}
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
}
.flex-row input {
  border: var(--input-border-width) solid var(--input-border-color);
  border-radius: var(--border-radius);
  font-family: 'phigros';
  padding-inline: 0.25em;
  min-width: 0;
  font-size: var(--font-size-small);
  height: 100%;
  box-sizing: border-box;
}
.flex-row input:focus {
  font-family: 'Consolas', monospace;
}
</style>