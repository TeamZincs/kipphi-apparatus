<script>
    /*
     * 历史版本：读 `history.json`，列出每次保存产生的版本，并支持还原。
     *
     * 还原不是"把指针拨回去"—— 那样原文件会被悄悄覆盖掉。`restoreChartVersion`
     * 会把目标版本复制成一个新文件、更新 metadata 并追加一条历史记录，
     * 所以还原本身也是可回溯的。
     */
    import Navigator from "#/components/Navigator.grain";
    import ProgressiveButton from "#/components/buttons/ProgressiveButton.grain";
    import { route } from "@graints/runtime";
    import { notify } from "#/notify";
    import { _ } from "#/i18n";
    import {
        queryChartHistory,
        restoreChartVersion,
        type ChartHistoryEntry,
    } from "#/background";

    const chartId = route.get().params.id;

    /** 最新的排最前 */
    let versions = $state<ChartHistoryEntry[]>([]);
    let loading = $state(true);
    /** 正在还原的那个版本的文件名（同时用来禁用按钮） */
    let restoring = $state<string | null>(null);
    let error = $state<string | null>(null);

    async function refresh(): Promise<void> {
        loading = true;

        try {
            const history = await queryChartHistory(chartId);

            versions = [...(history ?? [])].reverse();
        } catch (e) {
            error = e instanceof Error ? e.message : String(e);
        } finally {
            loading = false;
        }
    }

    async function restore(entry: ChartHistoryEntry): Promise<void> {
        if (restoring) return;

        restoring = entry.filename;
        error = null;

        try {
            await restoreChartVersion(chartId, entry.filename);
            notify(_("history.restored"), "info");
            await refresh();
        } catch (e) {
            error = e instanceof Error ? e.message : String(e);
            notify(error, "error");
        } finally {
            restoring = null;
        }
    }

    function formatTime(time: number): string {
        const date = new Date(time);
        const pad = (value: number) => String(value).padStart(2, "0");

        return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
    }
</script>

<script onmount>
    void refresh();
</script>

<main>
    <Navigator />
    <div id="content">
        <h1>{_("history.title")}</h1>

        {#if loading}
            <p class="hint">{_("history.loading")}</p>
        {:else if versions.length === 0}
            <p class="hint">{_("history.empty")}</p>
        {:else}
            <div class="list">
                {#for entry of versions with key = entry.filename}
                    <div class="row">
                        <div class="info">
                            <span class="time">{formatTime(entry.time)}</span>
                            <span class="summary">
                                {entry.summary || entry.filename}
                            </span>
                        </div>
                        <ProgressiveButton
                            disabled={restoring !== null}
                            onclick={() => restore(entry)}
                        >
                            {restoring === entry.filename
                                ? _("history.restoring")
                                : _("history.restore")}
                        </ProgressiveButton>
                    </div>
                {/for}
            </div>
        {/if}

        {#if error}
            <p class="error">{error}</p>
        {/if}
    </div>
</main>

<style>
    main {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    #content {
        position: relative;
        z-index: 1;
        position: absolute;
        width: 100%;
        height: 100%;
        backdrop-filter: blur(16px) brightness(40%);
        color: white;
        padding: 8vh 8vw 4vh;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 2vh;
    }

    h1 {
        margin: 0;
        font-size: 4vh;
        font-weight: 600;
    }

    .hint {
        margin: 0;
        font-size: 2.4vh;
        color: rgba(255, 255, 255, 0.7);
    }

    .list {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1.2vh;
        padding-right: 0.6vw;
    }

    .row {
        display: flex;
        align-items: center;
        gap: 2vw;
        padding: 1.4vh 1.6vw;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 1.2vh;
        background: rgba(0, 0, 0, 0.28);
    }

    .info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4vh;
    }

    .time {
        font-size: 2.2vh;
        color: rgba(255, 255, 255, 0.85);
        font-variant-numeric: tabular-nums;
    }

    .summary {
        font-size: 1.8vh;
        color: rgba(255, 255, 255, 0.55);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .error {
        margin: 0;
        font-size: 2vh;
        color: #ff8080;
    }
</style>
