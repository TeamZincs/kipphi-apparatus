<script>
    /*
     * 移动端历史版本页。
     *
     * 数据层和桌面端同一份（`#/background` → `@kpa/shared/background/tauri`）：
     * 还原同样是"复制成新版本"，不是把 metadata 指回去。
     */
    import { navigate, route } from "@graints/runtime";
    import {
        queryChartHistory,
        restoreChartVersion,
        type ChartHistoryEntry,
    } from "#/background";

    const chartId = route.get().params.id;

    /** 最新的排最前 */
    let versions = $state<ChartHistoryEntry[]>([]);
    let loading = $state(true);
    /** 正在还原的那个版本的文件名（同时用来禁用按钮） */
    let restoring = $state<string | null>(null);
    let error = $state<string | null>(null);
    let message = $state<string | null>(null);

    async function refresh(): Promise<void> {
        loading = true;

        try {
            const history = await queryChartHistory(chartId);

            versions = [...(history ?? [])].reverse();
        } catch (e) {
            error = e instanceof Error ? e.message : String(e);
        } finally {
            loading = false;
        }
    }

    async function restore(entry: ChartHistoryEntry): Promise<void> {
        if (restoring) return;

        restoring = entry.filename;
        error = null;
        message = null;

        try {
            await restoreChartVersion(chartId, entry.filename);
            message = `已还原到 ${formatTime(entry.time)} 的版本`;
            await refresh();
        } catch (e) {
            error = e instanceof Error ? e.message : String(e);
        } finally {
            restoring = null;
        }
    }

    function formatTime(time: number): string {
        const date = new Date(time);
        const pad = (value: number) => String(value).padStart(2, "0");

        return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
    }

    function back(): void {
        navigate(`/charts/${chartId}`);
    }
</script>

<script onmount>
    void refresh();
</script>

<main>
    <header class="bar">
        <button class="back" onclick={back} aria-label="返回">‹</button>
        <h1>历史版本</h1>
        <span class="count">{versions.length}</span>
    </header>

    <section class="body">
        {#if loading}
            <p class="hint">正在读取历史…</p>
        {:else if versions.length === 0}
            <p class="hint">还没有保存过版本。</p>
        {:else}
            {#for entry of versions with key = entry.filename}
                <div class="row">
                    <div class="info">
                        <span class="time">{formatTime(entry.time)}</span>
                        <span class="summary">
                            {entry.summary || entry.filename}
                        </span>
                    </div>
                    <button
                        class="restore"
                        disabled={restoring !== null}
                        onclick={() => restore(entry)}
                    >
                        {restoring === entry.filename ? "还原中…" : "还原"}
                    </button>
                </div>
            {/for}
        {/if}

        {#if message}
            <p class="ok">{message}</p>
        {/if}

        {#if error}
            <p class="err">{error}</p>
        {/if}
    </section>
</main>

<style>
    main {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--bg);
        color: var(--text);
    }

    .bar {
        flex: none;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: calc(8px + env(safe-area-inset-top)) 12px 8px;
        border-bottom: 1px solid var(--border);
    }

    .back {
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 8px;
        background: none;
        color: var(--text);
        font-size: 22px;
        line-height: 1;
    }

    h1 {
        flex: 1;
        margin: 0;
        font-size: 15px;
        font-weight: 600;
    }

    .count {
        font-size: 12px;
        color: var(--text-dim);
    }

    .body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 10px 14px calc(16px + env(safe-area-inset-bottom));
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface);
    }

    .info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .time {
        font-size: 13px;
        font-variant-numeric: tabular-nums;
    }

    .summary {
        font-size: 11px;
        color: var(--text-dim);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .restore {
        flex: none;
        padding: 6px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        font-size: 12px;
    }

    .restore:disabled {
        opacity: 0.45;
    }

    .hint {
        margin: 0;
        font-size: 13px;
        color: var(--text-dim);
    }

    .ok {
        margin: 0;
        font-size: 12px;
        color: var(--accent);
    }

    .err {
        margin: 0;
        font-size: 12px;
        color: #ff8080;
        word-break: break-word;
    }
</style>
