<script>
    import type { JudgeLine } from 'kipphi';
    import Self from './JudgeLineManager.grain';

    import {
        selectedLineNumber,
        activeSecondarySidebar,
        SecondarySidebar,
        operationList,
        registerReflow
    } from './store';
    import { Op } from 'kipphi';

    let { level = 0, target, show = true, flat = false } = $props<{
        level?: number;
        target: JudgeLine;
        show?: boolean;
        /**
         * 平铺模式：不展开子判定线。
         *
         * 以前是父组件"只在树形布局里传 `children`"来区分的。改成组件自己算
         * `sortedChildren` 之后这个语义丢了 —— 按序布局（ORDERED）也会一层层展开，
         * 看着就是一棵树。
         */
        flat?: boolean;
    }>();

    /**
     * 子判定线（按 id 排序）。
     *
     * 以前是父组件在模板里算 `[...child.children].sort()` 当 prop 传进来 ——
     * 每次推 props 都是**新数组**，`!==` 恒成立，于是一路往下重刷。
     *
     * 现在连这里也不再"每次克隆"：数组内容没变就返回**同一份**，让下游的
     * `{#for}` / props 比较能真的判成"没变"。克隆数组永远带全量刷新的语义 ——
     * 一次排序就会把整棵子树重推一遍（Nap 那种行多的谱面直接把循环保护打满）。
     */
    let lastSource: JudgeLine[] = [];
    let lastSorted: JudgeLine[] = [];

    const sortedChildren = $node({
        get: () => {
            // `children` 是 `Set<JudgeLine>`（不是数组）：先展开成数组再逐项比
            // —— 直接用 `Set.length` / `Set.every` 会恒为 undefined，缓存永远失效
            const source = [...target.children];

            const unchanged =
                source.length === lastSource.length &&
                source.every((child, index) => child === lastSource[index]);

            if (unchanged) return lastSorted;

            lastSource = source;
            lastSorted = [...source].sort((a, b) => a.id - b.id);

            return lastSorted;
        }
    });

    let refreshKey = $state(0);

    let root: HTMLDivElement;

    const values = $node({
        get: () => ({
            moveX: target.moveX,
            moveY: target.moveY,
            rotate: target.rotate,
            alpha: target.alpha,
            refreshKey
        })
    });

    let folded = $state(false);
    let lineName = $state(target.name);

    /**
     * 这条线是不是当前选中的。
     *
     * 以前写成 `$node({ get: 读 store, listen: store.subscribe })`，结果刷新函数
     * 自己又会经由订阅回到 `selectedLineNumber`，10ms 里跑满 100 次触发循环保护。
     * 改成"订阅里只在真的变了才写 `$state`"，写入就有下界了。
     */
    let displays = $state(selectedLineNumber.get() === target.id);

    function scrollIntoView() {
        if (selectedLineNumber.get() !== target.id || !root) return;

        // 滚动前先检测一下：root 往上找祖先，如果祖先的 scrollTop 为 0 则不平滑滚动
        let cur: HTMLElement = root;

        while (cur && !cur.matches('.judgelines-manager')) {
            cur = cur.parentElement;
        }

        root.scrollIntoView({
            behavior: cur?.scrollTop <= 20 ? 'instant' : 'smooth',
            block: 'center',
            inline: 'center'
        });
    }

    function handleClick() {
        if (displays) {
            // 已经激活，则全局跳转到此判定线管理
            activeSecondarySidebar.set(SecondarySidebar.LINE);
        } else {
            selectedLineNumber.set(target.id);
        }
    }
</script>

<div class="judgeline-manager {displays ? 'selected' : ''}"
    style="margin-left: {level}em; display: {show ? '' : 'none'}; position: {!flat && sortedChildren.length ? 'sticky' : ''}; z-index: {!flat && sortedChildren.length ? 1 : 0}; top: {level * 3}em"
    onclick={handleClick}
    bind:this={root}
    >
    <span class="id">{target.id}</span>
    <input class="name" bind:value={lineName} onclick={(e) => e.stopPropagation()}
        onchange={() => operationList.do(new Op.JudgeLineRenameOperation(target, lineName))}
    >
    <span>x</span><span>{values.moveX?.toFixed?.(2)}</span>
    <span>y</span><span>{values.moveY?.toFixed?.(2)}</span>
    <span class="triangle {!flat && sortedChildren.length > 0 ? '' : 'hidden'} {folded ? 'folded' : ''}"
        onclick={(e) => {folded = !folded; e.stopPropagation()}}
        ></span>
    <span>θ</span><span>{values.rotate !== undefined ? (values.rotate * 180 / Math.PI).toFixed?.(2) : "N/A"}</span>
    <span>α</span><span>{values.alpha !== undefined ? Math.round(values.alpha).toString?.(16) + "/" + Math.round(values.alpha) : "N/A"}</span>
</div>
{#if !flat && sortedChildren.length > 0}
    <!-- 用判定线对象本身当 key：行复用时不会因为数组重建而整片重刷 -->
    {#for child of sortedChildren with key = child}
        <Self
            target={child}
            level={level + 1}
            show={!folded}
        />
    {/for}
{/if}

<script onmount>
    // 父级要"重画判线列表"时喊一声：bump 一下 refreshKey，`values` 跟着重算
    registerReflow(() => (refreshKey += 1));

    selectedLineNumber.subscribe((lineNumber) => {
        // 只在真的变了才写：无条件写会把"订阅 -> 刷新 -> 写 -> 订阅"接成环
        const next = lineNumber === target.id;

        if (next !== displays) displays = next;

        scrollIntoView();
    });
</script>

<style>
.judgeline-manager {
  display: grid;
  grid-template-columns: 2.8em repeat(2, 1fr 3fr);
  grid-template-rows: auto 1fr 1fr auto;
  grid-gap: 0.1em;
  font-size: var(--font-size-smaller);
  padding: 0.5em;
  width: 100%;
  background-color: #ddd;
  border-radius: 4px;
  box-sizing: border-box;
  top: 0;
  contain: layout;
}
.judgeline-manager.selected {
  background-color: aquamarine;
}
.id {
  grid-row: 1 / 3;
  font-size: var(--font-size-small);
}
.name {
  grid-column: 2 / 6;
  font-size: 150%;
}
.triangle {
  grid-row: 3 / 4;
  grid-column: 1 / 2;
  display: inline-block;
  width: 0;
  height: 0;
  border-left: 0.5em solid transparent;
  border-right: 0.5em solid transparent;
  border-top: 1em solid black;
}
.triangle.folded {
  transform: rotate(-90deg);
}
.triangle.hidden {
  border-top-color: transparent;
}
span {
  overflow: clip;
  width: 100%;
}
</style>
