<script>
    import Label from '#/components/Label.grain';
    import PopupOption from '#/components/PopupOption/PopupOption.grain';
    import { EventType, type ExtendedEventTypeName, KPAError, Op } from 'kipphi';
    import {
        eventsLayer,
        eventsType,
        eventsTimeSpan,
        eventsEditChecked,
        eventsScopeSelectMode,
        operationList,
        useEasing,
        templateName,
        selectedLineNumber,
        newNodeState
    } from './store';
    import { t as _ } from '#/i18n';
    import UnitInput from '#/components/Inputs/UnitInput.grain';
    import TextSwitchButton from '#/components/IconButtons/TextSwitchButton.grain';
    import EasingBox from './EasingBox.grain';
    import ProgressiveButton from '#/components/buttons/ProgressiveButton.grain';
    import { EventSequenceEditor } from '@kpa/canvas/eventCurveEditor';
    import { notify } from '#/notify';
    import { eventSequenceEditors } from './store';
    import { SelectState, NumericEventCurveEditor, NewNodeState } from '@kpa/canvas';
    import SuggestionInput from '#/components/Inputs/SuggestionInput.grain';
    import Tooltip from '#/components/Tooltip.grain';

    // 模板里用到的 store 各开一个本地别名（grain 的 `$xxx` 自动订阅没有对应物）
    const layer = $node({ get: () => eventsLayer.get(), listen: (update) => eventsLayer.subscribe(update) });
    const type = $node({ get: () => eventsType.get(), listen: (update) => eventsType.subscribe(update) });
    const editChecked = $node({
        get: () => eventsEditChecked.get(),
        listen: (update) => eventsEditChecked.subscribe(update)
    });

    const options = $node({
        get: () => {
            if (layer === 'ex') return ['general', 'scaleX', 'scaleY', 'text', 'color'];

            if (layer === 'glb') return ['general', 'bpm', 'video', 'videoAlpha', 'videoDim'];

            return ['general', 'moveX', 'moveY', 'rotate', 'alpha', 'speed', 'easing'];
        },
        listen: (update) => eventsLayer.subscribe(update)
    });

    const texts = $node({
        get: () => options.map((name) => _(`general.eventTypes.${name}`)),
        listen: (update) => eventsLayer.subscribe(update)
    });

    const modes = [SelectState.none, SelectState.extend, SelectState.replace, SelectState.exclude];
    const modeTexts = [
        _('general.modes.none'),
        _('general.modes.extend'),
        _('general.modes.replace'),
        _('general.modes.substract')
    ];

    let rangeInput: HTMLInputElement;

    const restore = () => {
        const activatedEditor = eventSequenceEditors.activatedEditor;

        if (!rangeInput || !(activatedEditor instanceof EventSequenceEditor)) return;

        if (activatedEditor.autoRangeEnabled) {
            rangeInput.value = 'auto';
        } else {
            let value = (activatedEditor as NumericEventCurveEditor).valueRange.join(', ');

            if (activatedEditor.timeGridInterval) {
                value += `, ${activatedEditor.timeGridInterval}`;
            }

            rangeInput.value = value;
        }
    };

    function applyRange(event: Event) {
        const target = event.target as HTMLInputElement;
        const value = target.value;

        if (value === 'auto') {
            eventSequenceEditors.activatedEditor.autoRangeEnabled = true;
            return;
        }

        const match = value.match(/^(\-?\d+)[,\- ]\s?(\-?\d+)(?:[, ]\s?(\d+))?$/);

        if (!match) {
            notify(_('main.events.invalidRange'), 'error');
            restore();
            return;
        }

        const [, start, end, interval] = match;
        const startNum = parseFloat(start);
        const endNum = parseFloat(end);
        const intervalNum = interval && parseFloat(interval);

        if (isNaN(startNum) || isNaN(endNum)) {
            notify(_('main.events.invalidRange'), 'error');
            restore();
            return;
        }

        if (startNum >= endNum) {
            notify(_('main.events.invalidRange'), 'error');
            restore();
            return;
        }

        const activatedEditor = eventSequenceEditors.activatedEditor as NumericEventCurveEditor;

        activatedEditor.valueRange = [startNum, endNum];
        activatedEditor.autoRangeEnabled = false;
        // 属性可以为 undefined，表示自适应密度
        activatedEditor.valueGridInterval = intervalNum;

        eventSequenceEditors.activatedEditor.draw();
    }

    function encapsule() {
        const name = templateName.get();

        if (name === '') return notify(_('main.events.templateNameEmpty'), 'error');

        const lib = operationList.chart.templateEasingLib;

        if (lib.easings.has(name)) return notify(_('main.events.templateNameOccupied'), 'error');

        const evSeqEditor = eventSequenceEditors.activatedEditor as EventSequenceEditor<number>;

        if (evSeqEditor.nodesSelection.size === 0) return notify(_('main.events.noNodeSelected'), 'error');

        const arr = [...evSeqEditor.nodesSelection];
        const hasSelfNodes = arr.some((node) => node.parentSeq === evSeqEditor.target);
        const selection = hasSelfNodes ? arr.filter((node) => node.parentSeq === evSeqEditor.target) : arr;

        try {
            const operation = Op.EncapsuleOperation.encapsule(lib, evSeqEditor.target, new Set(selection), name);

            operationList.do(operation);
        } catch (e) {
            if (e instanceof KPAError) return notify(e.message, 'error');
        }
    }
</script>

<Label>{_('main.sidebar.events')}</Label>
<Label small>{_('main.events.layerAndSeq')}</Label>
<PopupOption wide
    options={['0', '1', '2', '3', 'ex', 'glb']}
    displayTexts={[
        _('main.events.layers.0'),
        _('main.events.layers.1'),
        _('main.events.layers.2'),
        _('main.events.layers.3'),
        _('main.events.layers.ex'),
        _('main.events.layers.glb')
    ]}
    bind:currentOption={$store(eventsLayer)}
></PopupOption>

<PopupOption wide
    options={options} displayTexts={texts}
    bind:currentOption={$store(eventsType)}
></PopupOption>

<Label small>{_('main.events.timeSpan')}</Label>
<UnitInput bind:value={$store(eventsTimeSpan)} unit={_('general.beat')} step={1}></UnitInput>

{#if type !== 'general'}

    <TextSwitchButton wide bgText={_('main.events.addNodePair')}
        onText="+" offText="-" bind:checked={$store(eventsEditChecked)}/>

    <EasingBox bind:value={$store(useEasing)}></EasingBox>

    <Label small>{_('general.multiSelectMode')}</Label>
    <PopupOption wide options={modes} displayTexts={modeTexts}
        bind:currentOption={$store(eventsScopeSelectMode)}
    ></PopupOption>

    {#if ['moveX', 'moveY', 'rotate', 'alpha', 'speed', 'easing', 'scaleX', 'scaleY', 'bpm'].includes(type)}
    <Label small>
    {_('main.events.range')}
    <Tooltip>
        {_('main.events.rangeTooltip')}
    </Tooltip>
    </Label>
    <input bind:this={rangeInput} placeholder="left-right,interval" type="text" class="range" value="auto" onchange={applyRange}>

    <PopupOption wide
        bind:currentOption={$store(newNodeState)}
        options={[NewNodeState.controlsBoth, NewNodeState.controlsStart, NewNodeState.controlsEnd]}
        displayTexts={['both', 'start', 'end']}
    ></PopupOption>

    {#if type !== 'bpm'}
    <SuggestionInput
    getSuggestions={async (s) => operationList.chart.templateEasingLib.easings.keys().toArray().filter(k => k.startsWith(s))}
    placeholder={_('main.events.templateName')}
    bind:value={$store(templateName)}/>

    <ProgressiveButton onclick={encapsule}>{_('main.events.encapsule')}</ProgressiveButton>
    {/if}
    {/if}
{/if}

<script onmount>
    // 原先是一段 $effect：图层 / 序列 / 判线一变就把区间输入框拉回编辑器里的值
    eventsLayer.subscribe(restore);
    eventsType.subscribe(restore);
    selectedLineNumber.subscribe(restore);
</script>

<style>
.template-name,
.range {
  border: var(--input-border-width) solid var(--input-border-color);
  border-radius: var(--border-radius);
  font-family: 'phigros';
  padding-inline: 0.25em;
  min-width: 0;
  font-size: var(--font-size-medium);
  width: 100%;
  box-sizing: border-box;
}
.template-name:focus,
.range:focus {
  font-family: 'Consolas', monospace;
}
</style>
