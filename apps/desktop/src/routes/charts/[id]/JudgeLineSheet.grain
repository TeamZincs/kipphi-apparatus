<script>
    /*
     * 判定线属性面板（移动端）。
     *
     * 入口：判定线行左滑 →「设定」。字段对齐桌面 `JudgeLineEditor.grain`，
     * 先做 anchor.x / anchor.y / zOrder / cover / group / rotatesWithFather。
     *
     * 还没做的两个：
     *   · `father` —— 要带"不能设成自己的子孙"的循环校验，单独一轮；
     *   · `texture` —— 移动端选图走 Tauri dialog，也要单独接。
     *
     * 所有改动都发一条 Operation，`operationList` 是唯一真相；输入框自己
     * 管草稿（`NumField` 失焦才回传）。
     */
    import { JudgeLine, Op } from "kipphi";

    import {
        fetchTexture,
        getTextures,
        uploadTexture
    } from "@kpa/shared/background/tauri";

    import NumField from "#/components/NumField.grain";
    import Switch from "#/components/Switch.grain";

    // 桌面端 store 在 `./store`；`chart` 走 `operationList.chart`
    import {
        chartId,
        operationList,
        player,
        refreshAll,
        reflowAll
    } from "./store";

    const chart = operationList?.chart;

    let { line, onclose } = $props<{
        line: JudgeLine;
        onclose: () => void;
    }>();

    /** 发一条属性修改，然后按需重排 / 刷新列表 */
    function commit(field: string, value: unknown, reflow = false): void {
        operationList?.do(
            new (Op.JudgeLinePropChangeOperation as any)(line, field, value),
        );

        if (reflow) reflowAll();

        refreshAll();
    }

    /** 数字类字段：NaN 直接丢弃（输入框允许空着） */
    function commitNumber(field: string, raw: string): void {
        const value = Number(raw);

        if (!Number.isFinite(value)) return;

        switch (field) {
            case "anchorX":
                commit("anchor", [value, line.anchor[1]]);

                return;
            case "anchorY":
                commit("anchor", [line.anchor[0], value]);

                return;
            case "cover":
                // 遮罩是 0~1
                commit("cover", Math.min(1, Math.max(0, value)));

                return;
            case "zOrder":
                commit("zOrder", value, true);

                return;
            default:
                commit(field, value);
        }
    }

    function commitGroup(name: string): void {
        const group = chart?.judgeLineGroups?.find((item) => item.name === name);

        if (!group) return;

        operationList?.do(new Op.JudgeLineRegroupOperation(line, group));
        refreshAll();
    }

    /** 可选的分组名（没分组时只有一个默认组，也要列出来） */
    const groupOptions = $node(
        () => chart?.judgeLineGroups?.map((item) => item.name) ?? [],
    );

    /**
     * 可选父线：排除自己，且**会成环的标成不可选**。
     *
     * `JudgeLine.checkinterdependency` 就是库里的循环校验，桌面端
     * `checkFather()` 也是拿它提前标红 —— 真正的守卫在
     * `JudgeLineInheritanceChangeOperation` 构造函数里（非法会 `ineffective`），
     * 这里只是让用户点不到。
     */
    const fatherOptions = $node(() =>
        (chart?.judgeLines ?? [])
            .filter((item) => item.id !== line.id)
            .map((item) => ({
                id: item.id,
                invalid: JudgeLine.checkinterdependency(line, item)
            })),
    );

    function commitFather(raw: string): void {
        if (!chart) return;

        const id = Number(raw);
        const father =
            Number.isFinite(id) && id >= 0
                ? chart.judgeLines.find((item) => item.id === id) ?? null
                : null;

        operationList?.do(
            new Op.JudgeLineInheritanceChangeOperation(chart, line, father),
        );
        refreshAll();
    }

    //#region 贴图
    /** 默认贴图：随资源包走，不在谱面目录里 */
    const DEFAULT_TEXTURE = "line.png";

    /** 谱面目录里现有的贴图 */
    let textures = $state<string[]>([]);
    let uploading = $state(false);

    /** 上传按钮用的隐藏 `<input type="file">` */
    let fileInput: HTMLInputElement;

    async function reloadTextures(): Promise<void> {
        if (!chartId) {
            textures = [DEFAULT_TEXTURE];

            return;
        }

        try {
            const list = await getTextures(chartId);

            textures = list.includes(DEFAULT_TEXTURE)
                ? list
                : [DEFAULT_TEXTURE, ...list];
        } catch (error) {
            console.error(error);
            textures = [DEFAULT_TEXTURE];
        }
    }

    /**
     * 选中贴图：改数据 + 立刻写进播放器的贴图表。
     *
     * 桌面端 `JudgeLineEditor.pickTexture()` 是同一套流程；播放器实例从
     * store 拿（那边也是这么放的），所以这里能主动去设。
     */
    async function selectTexture(name: string): Promise<void> {
        if (!chart || !name) return;

        operationList?.do(
            new Op.JudgeLinePropChangeOperation(line, "texture", name),
        );

        if (name === DEFAULT_TEXTURE || !chartId) {
            refreshAll();

            return;
        }

        try {
            const bitmap = await fetchTexture(chartId, name);

            if (bitmap) player?.textureMapping.set(name, bitmap);
        } catch (error) {
            console.error(error);
        }

        refreshAll();
    }

    async function onUpload(event: Event): Promise<void> {
        const input = event.currentTarget as HTMLInputElement;
        const file = input.files?.[0];

        // 不清空的话，再选同一个文件不会再触发 change
        input.value = "";

        if (!file || !chartId) return;

        uploading = true;

        try {
            await uploadTexture(chartId, file);
            await reloadTextures();
            await selectTexture(file.name);
        } catch (error) {
            console.error(error);
        } finally {
            uploading = false;
        }
    }

    void reloadTextures();
    //#endregion
</script>

<div class="panel">
    <header class="head">
        <span class="title">判定线 #{line.id}</span>
        <button class="done" onclick={onclose}>完成</button>
    </header>

    <div class="field">
        <span>横向位置</span>
        <NumField
            bind:value={
                get: () => String(line.anchor[0]),
                set: (value: string) => commitNumber("anchorX", value)
            }
        />
    </div>

    <div class="field">
        <span>纵向位置</span>
        <NumField
            bind:value={
                get: () => String(line.anchor[1]),
                set: (value: string) => commitNumber("anchorY", value)
            }
        />
    </div>

    <div class="field">
        <span>层级（zOrder）</span>
        <NumField
            inputmode="numeric"
            bind:value={
                get: () => String(line.zOrder),
                set: (value: string) => commitNumber("zOrder", value)
            }
        />
    </div>

    <div class="field">
        <span>遮罩（0~1）</span>
        <NumField
            bind:value={
                get: () => String(line.cover),
                set: (value: string) => commitNumber("cover", value)
            }
        />
    </div>

    <div class="field">
        <span>跟随父线旋转</span>
        <Switch
            bind:checked={
                get: () => line.rotatesWithFather,
                set: (value: boolean) => commit("rotatesWithFather", value)
            }
        />
    </div>

    <div class="field">
        <span>分组</span>
        <select
            value={line.group?.name ?? ""}
            onchange={(event: Event) =>
                commitGroup((event.currentTarget as HTMLSelectElement).value)}
        >
            {#for name of groupOptions with key = name}
                <option value={name}>{name}</option>
            {/for}
        </select>
    </div>

    <div class="field">
        <span>父判定线</span>
        <select
            value={String(line.father?.id ?? -1)}
            onchange={(event: Event) =>
                commitFather((event.currentTarget as HTMLSelectElement).value)}
        >
            <option value="-1">（无）</option>
            {#for item of fatherOptions with key = item.id}
                <option value={String(item.id)} disabled={item.invalid}>
                    {item.invalid ? `#${item.id}（会成环）` : `#${item.id}`}
                </option>
            {/for}
        </select>
    </div>

    <div class="field">
        <span>贴图</span>
        <select
            value={line.texture || "line.png"}
            onchange={(event: Event) => {
                void selectTexture(
                    (event.currentTarget as HTMLSelectElement).value,
                );
            }}
        >
            {#for name of textures with key = name}
                <option value={name}>{name}</option>
            {/for}
        </select>
    </div>

    <div class="field">
        <span>上传贴图</span>
        <button
            class="upload"
            disabled={uploading}
            onclick={() => fileInput?.click()}
        >
            {uploading ? "上传中…" : "选择图片"}
        </button>
        <input
            bind:this={fileInput}
            class="file"
            type="file"
            accept="image/png,image/jpeg"
            onchange={onUpload}
        />
    </div>
</div>

<style>
    .panel {
        padding: 4px 16px 18px;
    }

    .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0 14px;
    }

    .title {
        font-size: 16px;
        font-weight: 600;
        color: var(--text);
    }

    .done {
        padding: 6px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--text);
        font: inherit;
        font-size: 13px;
    }

    .field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 9px 0;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        color: var(--text);
    }

    .field > span {
        flex: 0 0 auto;
    }

    .field select {
        flex: 0 1 auto;
        min-width: 0;
        padding: 6px 8px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: 13px;
    }

    .upload {
        padding: 6px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--text);
        font: inherit;
        font-size: 13px;
    }

    .upload:disabled {
        opacity: 0.5;
    }

    /* 真正的 file input 藏起来，用上面的按钮触发 */
    .file {
        display: none;
    }
</style>
