<script>
    import { EasingCanvas } from "@kpa/canvas";
    import type { LTWH } from "@kpa/canvas/notesEditor";
    import {
        Easing,
        EasingType,
        NormalEasing,
        TemplateEasing,
        SegmentedEasing,
        BezierEasing,
        easingArray,
    } from "kipphi";

    import RadioTabs from "#/components/RadioTabs.grain";
    import EasingBox from "./EasingBox.grain";
    import SuggestionInput from "#/components/Inputs/SuggestionInput.grain";
    import BezierEditor from "./BezierEditor.grain";
    import Button from "#/components/buttons/Button.grain";
    import { _ } from "#/i18n";
    import { operationList } from "./store";
    import { rpeEasingArray } from "kipphi";
    import { canvasEditor } from "./bezier";

    type Points = [number, number, number, number];

    const NORMAL = EasingType.normal;
    const BEZIER = EasingType.bezier;
    const TEMPLATE = EasingType.template;

    // `EasingCanvas` 现在在共享包里（`@kpa/canvas`），桌面与移动端共用一份


    // ============================================================
    //  Props / 组件逻辑
    // ============================================================
    let {
        easingType = $bindable(EasingType.normal),
        easing = $bindable(easingArray[1]),
        ongototemplate,
    } = $props<{
        easingType?: EasingType;
        easing?: Easing;
        ongototemplate?: () => void;
    }>();

    // ---- canvas ----
    let canvas: HTMLCanvasElement;
    let easingCanvas: EasingCanvas | null = null;

    /** 写 `easing` 的唯一入口：写完顺手重画曲线（原来是 $effect 干的活） */
    function applyEasing(next: Easing) {
        easing = next;
        easingCanvas?.draw(next as any);
    }

    // ---- easing 辅助访问器 ----
    function getEasingId(): number {
        const inner = easing instanceof SegmentedEasing ? easing.easing : easing;
        console.log("!11")
        return inner instanceof NormalEasing ? inner.id : 1;
    }
    function setEasingId(v: number) {
        const newInner = easingArray[v];
        applyEasing(easing instanceof SegmentedEasing
            ? new SegmentedEasing(newInner, easing.left, easing.right)
            : newInner);
    }

    function getBezierPoints(): Points {
        const inner = easing instanceof SegmentedEasing ? easing.easing : easing;
        if (inner instanceof BezierEasing) {
            return [...inner.cp1, ...inner.cp2] as Points;
        }
        return [0, 0, 1, 1];
    }
    function setBezierPoints(v: Points) {
        const newInner = new BezierEasing([v[0], v[1]], [v[2], v[3]]);
        applyEasing(easing instanceof SegmentedEasing
            ? new SegmentedEasing(newInner, easing.left, easing.right)
            : newInner);
        // 数值输入框改的值也要同步到曲线画布
        canvasEditor.setValue(...v);
    }

    let templateName = $state(easing instanceof TemplateEasing ? easing.name : '');

    function setTemplateName(v: string) {
        const t = operationList.chart.templateEasingLib.get(v);
        templateName = v;
        if (!t) return;
        applyEasing(easing instanceof SegmentedEasing
            ? new SegmentedEasing(t, easing.left, easing.right)
            : t);
    }

    // ---- segment bounds ----
    const segmentLeft = $node({ get: () => (easing instanceof SegmentedEasing ? easing.left : 0) });
    const segmentRight = $node({ get: () => (easing instanceof SegmentedEasing ? easing.right : 1) });

    function updateSegmentBounds(left: number, right: number) {
        const inner = easing instanceof SegmentedEasing ? easing.easing : easing;
        applyEasing(left === 0 && right === 1 ? inner : new SegmentedEasing(inner, left, right));
    }

    // ---- template suggestions ----
    async function getSuggestions(input: string): Promise<string[]> {
        return operationList.chart.templateEasingLib.easings.keys().toArray().filter(k => k.startsWith(input));
    }
</script>

<div class="radio-tabs-container">
<RadioTabs
    name="easing"
    options={[NORMAL, BEZIER, TEMPLATE]}
    displayTexts={[
        _('main.event.easings.normal'),
        _('main.event.easings.bezier'),
        _('main.event.easings.template'),
    ]}
    bind:currentOption={easingType}
></RadioTabs>
<div class="radio-tabs-page">
        {#if easingType === NORMAL}
            <EasingBox
                bind:value={ get: () => getEasingId(), set: (v) => setEasingId(v) }
            ></EasingBox>
        {:else if easingType === BEZIER}
            <input
                type="text"
                value={getBezierPoints().map((n) => n.toFixed(2)).join(" ")}
                onchange={(e) => {
                    const that = e.target as HTMLInputElement;
                    const arr = that.value.trim().split(/\s+/);
                    if (arr.length === 4) {
                        setBezierPoints(arr.map(parseFloat) as Points);
                    }
                }}
            />
            <BezierEditor
                bind:value={ get: () => getBezierPoints(), set: (v) => setBezierPoints(v) }
            ></BezierEditor>
        {:else if easingType === TEMPLATE}
            <SuggestionInput
                bind:value={ get: () => templateName, set: (v) => setTemplateName(v) }
                getSuggestions={getSuggestions}
            ></SuggestionInput>
            <Button onclick={() => ongototemplate?.()}>
                {_('main.event.goto')}
            </Button>
        {/if}
        <input
            style="display: {easingType === BEZIER ? 'none' : ''}"
            type="text"
            value={[segmentLeft, segmentRight].map((n) => n.toFixed(6)).join(" ")}
            onchange={(e) => {
                const that = e.target as HTMLInputElement;
                const arr = that.value.trim().split(/\s+/);
                if (arr.length === 2) {
                    const left = parseFloat(arr[0]);
                    const right = parseFloat(arr[1]);
                    if (
                        left < 0 || left > 1 ||
                        right < 0 || right > 1 ||
                        isNaN(left) || isNaN(right) ||
                        right < left
                    ) {
                        return;
                    }
                    updateSegmentBounds(left, right);
                }
            }}
        />
        <canvas
            style="display: {easingType === BEZIER ? 'none' : ''}"
            bind:this={canvas}
            width="300"
            height="600"
        ></canvas>
</div>
</div>

<script onmount>
    if (canvas) {
        const ecvs = new EasingCanvas(canvas, [0, 0, 300, 600]);

        ecvs.addEventListener('change', (e) => applyEasing((e as CustomEvent).detail));
        easingCanvas = ecvs;
        ecvs.draw(easing as any);
    }
</script>
