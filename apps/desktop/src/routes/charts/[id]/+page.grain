<script>
import { Player, AudioProcessor, Images, VideoFrameSource, setWasmPath } from "kipphi-player";
import { EventSequenceEditors, NotesEditor, NotesEditorState } from "@kpa/canvas";
import { route } from "@graints/runtime";
import { getChartProject } from "#/background";
import { setID, setOperationList, registerPageCleanup } from "./store";
import { Chart, EventEndNode, EventStartNode, EventType, KPAError, Op as O, TC, type ExtendedEventTypeName } from "kipphi";

import { _i18n } from "#/i18n";

import AutoSaveRunner from "./autosaveRunner";

import PlayButton from "#/components/IconButtons/PlayButton.grain";
import GridSwitch from "#/components/IconButtons/GridSwitch.grain";
import PopupOption from "#/components/PopupOption/PopupOption.grain";
import TimeDivisorPicker from "#/components/IconButtons/TimeDivisorPicker.grain";
import SwitchButton from "#/components/IconButtons/SwitchButton.grain";
import TextSwitchButton from "#/components/IconButtons/TextSwitchButton.grain";

// 设置页用的基础组件
import NumField from "#/components/NumField.grain";
import Segmented from "#/components/Segmented.grain";
import Switch from "#/components/Switch.grain";

import { Sidebar, init as EditorGlobalInit, SecondarySidebar, restoreStates,
    eventsType, eventsLayer,
    playerShowsUI, playerShowsLineID, playerHitEffectNoFollows, playerShowsCurve, playerCameraZoom,
    selectedLineNumber, selectedLineId, activeSidebar, activeSecondarySidebar, previousActiveSecondarySidebar, selectedNote, selectedNotes, selectedNode, selectedNodes,
    timeDivisor, chartId, refreshAll, reflowAll } from "./store";

import Constants from "./constants";

// 侧栏面板：全部来自移动端
import JudgeLines from "./JudgeLineList.grain";
import JudgeLineSheet from "./JudgeLineSheet.grain";
import MacroSheet from "./MacroSheet.grain";
import NoteSheet from "./NoteSheet.grain";
import EventSheet from "./EventSheet.grain";
import MultiNoteSheet from "./MultiNoteSheet.grain";
import MultiNodeSheet from "./MultiNodeSheet.grain";

import { KPASettings } from "#/settings";
import { notify } from "#/notify";
import { respack, waitRespack } from "#/respack";
import { fetchShader, fetchTexture, fetchVideo } from "#/background";
import { _ReturnType } from "#/background-tauri";


/**
 * 谱面 ID 来自当前路由（原来是 SvelteKit 的 `+page.ts` 里读 `event.params.id`）。
 */
/*
 * 取词函数从 store 读 —— 换语言时 store 换新函数，模板里所有 `_("...")`
 * 跟着重算（和 svelte-i18n 的 `$_` 一个路子）。
 *
 * 必须手写 `get`：`$read` 只生成 `listen`，它的 `get` 读的是**最近一次推送**
 * 的值，而首次渲染前还没推送过 —— `let _` 会拿到 `undefined`，模板里
 * 调用就 `_ is not a function`。
 */
let _ = $node({
    get: () => _i18n.get(),
    listen: (update: (fn: unknown) => void) => _i18n.subscribe(update),
});

const chartIdParam = route.get().params.id;
setID(chartIdParam);

/** 编辑器内置音效 / 图片（原先由 `+page.ts` 的 load 一并返回） */
const ASSETS = {
    tap: '/Tap.wav',
    drag: '/Drag.wav',
    flick: '/Flick.wav',
    anchorImg: '/Anchor.png',
    belowImg: '/Below.png',
    selectNoteImg: '/selectNote.png',
    startNodeImg: '/South.png',
    endNodeImg: '/North.png'
};

let chart: Chart = null;
let illustration: ImageBitmap = null;
let audio: HTMLAudioElement;
let audioProcessor: AudioProcessor;

/**
 * 把原来 `+page.ts` 的 load 搬进来：grain 没有 load，页面自己取数。
 */
async function loadProject() {
    setWasmPath(new URL('/web-demuxer.wasm', window.location.origin).href);

    // 这里启用了实验性功能，随时都有可能出现破坏性更改，如果出现，需要修改此处
    await waitRespack();

    const project = await getChartProject(chartIdParam);

    chart = project.chart;
    illustration = await createImageBitmap(project.illustration);

    audio = new Audio(URL.createObjectURL(project.music));
    audio.addEventListener('timeupdate', () => {
        if (!player?.playing) return;

        pre0 = 0;
        progressBar.value = audio.currentTime + '';
    });
    audio.addEventListener('ended', () => {
        player.pause();
        isPlaying = false;
    });

    if (respack.TAP_SE && respack.DRAG_SE && respack.FLICK_SE) {
        audioProcessor = AudioProcessor.fromRespack(respack);
    } else {
        audioProcessor = new AudioProcessor();
        await audioProcessor.init({
            tap: ASSETS.tap,
            drag: ASSETS.drag,
            flick: ASSETS.flick
        });
    }

    await Images.loadAndOptimize({
        anchor: ASSETS.anchorImg,
        below: ASSETS.belowImg
    });
    await Images.initImagesForEditor({
        selectNote: ASSETS.selectNoteImg,
        startNode: ASSETS.startNodeImg,
        endNode: ASSETS.endNodeImg
    });
}

/**
 * 加载失败时在页面上盖一层。
 *
 * 桌面端不方便开控制台，而且这个页面的模板/侧栏全都依赖 `chart`，加载失败后
 * 根本没法正常建树 —— 与其白屏，不如把原因和"去历史里捞一个能打开的版本"
 * 直接摆出来。
 */
function showLoadFailure(error: unknown): void {
    const message = error instanceof Error ? error.message : String(error);

    console.error("[打开谱面失败]", error);

    const box = document.createElement("div");

    box.setAttribute(
        "style",
        "position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;"
            + "align-items:center;justify-content:center;gap:16px;padding:5vw;"
            + "background:rgba(0,0,0,.9);color:#ff8080;"
            + "font:14px/1.6 system-ui,sans-serif;text-align:center;word-break:break-word"
    );
    box.textContent = `${_("main.loadFailed")}${message}`;

    const link = document.createElement("a");

    link.href = `/charts/${encodeURIComponent(chartIdParam)}/history`;
    link.textContent = _("history.openFromError");
    link.setAttribute("style", "color:#8ab4ff;text-decoration:underline");
    box.appendChild(link);

    document.body.appendChild(box);
}

try {
    await loadProject();
} catch (error) {
    showLoadFailure(error);
    throw error;
}

/**
 * `operationList` 必须在模板建起来之前就有。
 *
 * grain 的 `{#if}` 只控制"插不插入 DOM"，分支里的内容照样在 create 时建好，
 * 而侧栏里的 `JudgeLineGroup` / `EventEditor` / `ChartInfoEditor` 建树时就会
 * `operationList.addEventListener(...)` / 读 `operationList.chart`。
 * 所以不能等 `boot()` 里再 new（原来 `+page.ts` 的 load 跑完才建组件，没这问题）。
 */
const operationList = new O.OperationList(chart);
setOperationList(operationList);

// @ts-expect-error 仅供调试
window.Images = Images;
// @ts-expect-error 仅供调试
window.audioProcessor = audioProcessor;

let playerCanvas: HTMLCanvasElement;
let notesEditorCanvas: HTMLCanvasElement;
let eventSequenceEditorCanvas: HTMLCanvasElement;
let player: Player = null;
let notesEditor: NotesEditor;
let eventSequenceEditors: EventSequenceEditors;

let aspect = $state(3 / 2);

const playerWidth = $node(aspect * KPASettings.playerHeight);
// svelte-ignore non_reactive_update

let progressBar: HTMLInputElement;
// let playButton: PlayButton;
let isPlaying = $state(false);
let showingGrid = $state(true);
let speed = $state("1.0x");
let preservesPitch = $state(true);

let undoAvailable = $state(false);
let redoAvailable = $state(false);

let volume = $state(3.5);

// let selectedLineNumber = $state(0);

/** 音量 / 倍速 / 保持音调的写入口：写完顺手推给音频（原来是三段 $effect） */
function applyVolume(next: number) {
    volume = next;
    if (audioProcessor) audioProcessor.volume = next;
}

function applySpeed(next: string) {
    speed = next;
    // 反正末尾有东西不影响解析
    if (audio) audio.playbackRate = parseFloat(next);
}

function applyPreservesPitch(next: boolean) {
    preservesPitch = next;
    if (audio) audio.preservesPitch = next;
}

const selectedLineName = $node({
    get: () => {
        const lineNumber = selectedLineNumber.get();
        const line = chart?.judgeLines[lineNumber];

        return line?.name ?? '?';
    },
    listen: (update) => selectedLineNumber.subscribe(update)
});

/** 当前选中的判定线对象 —— 移动端的 `JudgeLineSheet` 要的就是它 */
const selectedLineValue = $node({
    get: () => chart?.judgeLines[selectedLineNumber.get()] ?? null,
    listen: (update) => selectedLineNumber.subscribe(update),
});

/* 解析警告：`KPAError.buffer` 的快照，只读（照搬移动端） */
let chartErrors = $state<Array<{ message: string; fixed: boolean }>>([]);

function refreshChartErrors(): void {
    chartErrors = KPAError.buffer.map((error) => ({
        message: error.message,
        fixed: error.fixed,
    }));
}

/*
 * 画布参数（从移动端设置页搬过来的那几项）。
 *
 * 改的是**编辑器上的字段**，不是谱面数据 —— 不走 operationList，改完立刻重绘。
 * 这里用 `$state` 镜像一份，`NumField` 要字符串、`Switch` 要布尔，直接绑
 * 编辑器字段的话没有响应式来源。
 */
let timeSpanValue = $state(4);
let positionSpanValue = $state(1350);
let gridValue = $state(135);
let showsNNNValue = $state(true);
let edgeScrollValue = $state(true);

/*
 * 常用值（照搬移动端）：初始只有预设，用户在输入框提交新值就追加进来，
 * 最多 8 个、后来的顶替最早的。
 */
const PRESET_LIMIT = 8;

function remember(list: number[], value: number): number[] {
    if (!Number.isFinite(value) || value <= 0) return list;

    const next = [...list.filter((item) => item !== value), value];

    return next.length > PRESET_LIMIT
        ? next.slice(next.length - PRESET_LIMIT)
        : next;
}

const toOptions = (list: number[]): [number, string][] =>
    list.map((value) => [value, `${value}`]);

let divisorPresets = $state<number[]>([2, 3, 4, 6, 8, 12, 16]);
let timeSpanPresets = $state<number[]>([1, 2, 4, 8, 16]);
let positionSpanPresets = $state<number[]>([900, 1350, 1800]);
let gridPresets = $state<number[]>([45, 90, 135, 270]);

// 选项要**派生**：模板里直接 `toOptions(list)` 的话，参数进函数后依赖就丢了
const divisorOptions = $node({ get: () => toOptions(divisorPresets) });
const timeSpanOptions = $node({ get: () => toOptions(timeSpanPresets) });
const positionSpanOptions = $node({ get: () => toOptions(positionSpanPresets) });
const gridOptions = $node({ get: () => toOptions(gridPresets) });

function applyTimeDivisor(raw: string): void {
    const value = Number(raw);

    if (!Number.isFinite(value) || value <= 0) return;

    divisorPresets = remember(divisorPresets, value);

    if (notesEditor) {
        notesEditor.timeDivisor = value;
        notesEditor.draw();
    }
}

function applyTimeSpan(raw: string): void {
    const value = Number(raw);

    if (!Number.isFinite(value) || value <= 0) return;

    timeSpanValue = value;
    timeSpanPresets = remember(timeSpanPresets, value);

    if (notesEditor) {
        notesEditor.timeSpan = value;
        notesEditor.draw();
    }

    // 事件画布也跟着走，两边时间轴才对得上
    eventSequenceEditors?.setTimeSpan(value);
}

function applyPositionSpan(raw: string): void {
    const value = Number(raw);

    if (!Number.isFinite(value) || value <= 0) return;

    positionSpanValue = value;
    positionSpanPresets = remember(positionSpanPresets, value);

    if (notesEditor) {
        notesEditor.positionSpan = value;
        notesEditor.draw();
    }
}

function applyNoteGrid(raw: string): void {
    const value = Number(raw);

    if (!Number.isFinite(value) || value <= 0) return;

    gridValue = value;
    gridPresets = remember(gridPresets, value);

    if (notesEditor) {
        notesEditor.positionGridSpan = value;
        notesEditor.draw();
    }
}

function applyShowsNNN(value: boolean): void {
    showsNNNValue = value;

    if (!notesEditor) return;

    notesEditor.showsNNNListAttachable = value;
    notesEditor.draw();
}

function applyEdgeScroll(value: boolean): void {
    edgeScrollValue = value;

    if (notesEditor) notesEditor.edgeScrollEnabled = value;
    if (eventSequenceEditors) eventSequenceEditors.edgeScrollEnabled = value;
}

let pre0 = 0;

const renderingTimeCalculator = Object.getOwnPropertyDescriptor(Player.prototype, "renderingTime").get;

const computeTimeWithPre0 = () => {
    return renderingTimeCalculator.call({
        time: player.time - pre0,
        audio: audio,
        renderingOffset: player.renderingOffset
    })
}

const forward = (delta: number) => {
    const easingECE = eventSequenceEditors.easing;
    if (easingECE.active) {
        easingECE.draw((easingECE.lastBeats || 0) + delta)
        return;
    }
    const tc = operationList.chart.timeCalculator;
    if (pre0 > 0) {
        pre0 -= delta;
        if (pre0 <=0) {
            pre0 = 0;
        }
        // HACK: 使得能够显示0之前的部分。
        const renderingBeats = tc.secondsToBeats(computeTimeWithPre0());
        eventSequenceEditors.draw(renderingBeats);
        notesEditor.draw(renderingBeats)
        return;
    }
    audio.currentTime += delta;
    player.render();
}

const backward = (delta: number) => {
    const easingECE = eventSequenceEditors.easing;
    if (easingECE.active) {
        easingECE.draw((easingECE.lastBeats || 0) - delta)
        return;
    }
    const tc = operationList.chart.timeCalculator;
    const audioCurTime = audio.currentTime;
    if (audioCurTime <= 0) {
        pre0 += delta;
        const renderingBeats = tc.secondsToBeats(computeTimeWithPre0());
        eventSequenceEditors.draw(renderingBeats);
        notesEditor.draw(renderingBeats)
    } else {
        pre0 = 0;
        audio.currentTime = audioCurTime - delta;
        player.render();
    }
}



/**
 * 处理滚轮事件。
 * @param event
 */
function handleWheel(event: WheelEvent) {
    if (event.ctrlKey) { // 不处理Ctrl
        return;
    }
    if (audio) {
        const isForward = event.deltaY > 0 !== KPASettings.useRpeWheel;
        const absDelta = Math.abs(event.deltaY);
        if (isForward) {
            forward(absDelta / 1000);
        } else {
            backward(absDelta / 1000);
        }
        progressBar.value = audio.currentTime + '';
    }
}

function globalHandleWheel(event: WheelEvent) {
    if (event.ctrlKey) { // 按下CTRL则认为在切换判定线
        const total = chart.judgeLines.length;

        selectedLineNumber.set(
            (selectedLineNumber.get() + (event.deltaY > 0 !== KPASettings.useRpeWheel ? 1 : -1) + total) % total
        );
        return;
    }
}

const handleKeydown = (event: KeyboardEvent) => {
    switch (event.key) {
    case "Control":
        if (document.activeElement !== document.body) {
            return;
        }
        if (activeSecondarySidebar.get() === SecondarySidebar.LINES) {
            return;
        }
        previousActiveSecondarySidebar.set(activeSecondarySidebar.get());
        activeSecondarySidebar.set(SecondarySidebar.LINES);
        break;
    case " ":
        if (document.hasFocus() && document.activeElement !== document.body) {
            return;
        }
        if (isPlaying) {
            player.pause();
        } else {
            play();
        }
        event.preventDefault();
        break;
    case "Tab":
        if (activeSidebar.get() === Sidebar.EVENTS) {
            const offset = event.shiftKey ? -1 : 1;
            const currentType = eventsType.get();
            const currentLayer = eventsLayer.get();
            const NORMALS = ["moveX", "moveY", "rotate", "alpha", "speed", "easing"] as Exclude<keyof typeof EventType, ExtendedEventTypeName>[]
            const EXTENDED = ["scaleX", "scaleY", "text", "color", "bpm"] as ExtendedEventTypeName[]
            eventsType.set(
                currentLayer === "ex"
                    ? EXTENDED[(EXTENDED.indexOf(currentType as ExtendedEventTypeName) + offset + EXTENDED.length) % EXTENDED.length] ?? EXTENDED[0]
                    : NORMALS[(NORMALS.indexOf(currentType) + offset + NORMALS.length) % NORMALS.length] ?? NORMALS[0]
            );
        }
        break;
    case "Escape":
        activeSecondarySidebar.set(SecondarySidebar.CHART);
        break;
    case "z":
        operationList.undo();
        break;
    case "y":
        operationList.redo();
        break;
    case "Delete":
        handleDelete();
    }
}

const handleKeyup = (event: KeyboardEvent) => {
    if (document.activeElement !== document.body) {
        return;
    }
    switch (event.key) {
    case "Control":
        activeSecondarySidebar.set(previousActiveSecondarySidebar.get());
        break;
    }
}
const handleExit = (e: BeforeUnloadEvent) => {
    if (operationList.chart?.modified) {
        e.preventDefault();
        e.returnValue = '';
        return '';
    }
}
const handleDelete = () => {
    if (activeSecondarySidebar.get() === SecondarySidebar.NOTE) {
        const note = selectedNote.get();
        if (!note) { return }
        operationList.do(new O.NoteDeleteOperation(note));
    } else if (activeSecondarySidebar.get() === SecondarySidebar.EVENT) {
        const node = selectedNode.get();
        if (!node || (node instanceof EventStartNode && node.isFirstStart())) { return }
        operationList.do(new O.EventNodePairRemoveOperation(
            node instanceof EventEndNode ? node.previous : node,
            true
        ));
    } else if (activeSecondarySidebar.get() === SecondarySidebar.MULTI_NOTE) {
        const notes = selectedNotes.get();
        if (!notes || notes.size === 0) { return; }
        operationList.do(new O.MultiNoteDeleteOperation(
            notes
        ));
    } else if (activeSecondarySidebar.get() === SecondarySidebar.MULTI_NODE) {
        const nodes = selectedNodes.get();
        if (!nodes || nodes.size === 0) { return; }
        operationList.do(new O.MultiNodeDeleteOperation(
            [...nodes].sort((a, b) => TC.lt(a.time, b.time) ? -1 : 1)
        ));
    }

}

const play = async () => {
    audio.currentTime -= KPASettings.replayCompensation;
    player.play();
}

document.addEventListener("wheel", globalHandleWheel);
document.addEventListener("keydown", handleKeydown);
document.addEventListener("keyup", handleKeyup);

window.addEventListener("beforeunload", handleExit);

let initialized = $state(false);

async function boot() {

    player = await Player.create(
        playerCanvas,
        audioProcessor,
        audio,
        illustration,
        respack,
        {
            renderer: "webgl1",
            showStats: true
        }
    );
    player.hitEffectNoFollows = playerHitEffectNoFollows.get();
    player.baseOffset = KPASettings.baseOffset
    //player.cameraRatio = 0.8;
    player.addEventListener("play", () => {
        isPlaying = true;
    });
    player.addEventListener("pause", () => {
        isPlaying = false;
    });

    notesEditor = new NotesEditor(
        notesEditorCanvas,
        [0, 0, 600, 900],
        operationList,
        respack
    );
    notesEditor.target = chart.judgeLines[0];
    notesEditor.showsNNNListAttachable = false;
    // 滚轮方向跟着全局设置（编辑器自己不读设置，由这里透传）
    notesEditor.wheelReversed = KPASettings.useRpeWheel;
    notesEditorCanvas.addEventListener("click", () => {
        activeSidebar.set(Sidebar.NOTES);
    });
    eventSequenceEditorCanvas.addEventListener("click", () => {
        activeSidebar.set(Sidebar.EVENTS);
    })
    playerCanvas.addEventListener("click", () => {
        activeSidebar.set(Sidebar.DEFAULT);
    })
    eventSequenceEditors = new EventSequenceEditors(
        eventSequenceEditorCanvas,
        [0, 0, 600, 900],
        operationList,
        0.5
    );
    eventSequenceEditors.changeTarget({ judgeLine: chart.judgeLines[0] });
    eventSequenceEditors.wheelReversed = KPASettings.useRpeWheel;
    // 编辑器滑时间 → 播放器 seek（和移动端同一套）
    const onTimeScroll = (event: Event) => {
        const delta = (event as Event & { deltaBeats?: number }).deltaBeats ?? 0;

        if (!delta) return;

        // 播放器还没画出第一帧时 `renderingBeats` 可能是 NaN，
        // 拿它去加会把 audio.currentTime 设成 NaN，之后要等一次正常 render 才恢复 ——
        // 表现就是"刚开始滚不动，过一会儿突然能滚"
        const base = player.renderingBeats;

        if (!Number.isFinite(base)) return;

        // 不夹到 0：零前时间是合法的（音符画布就能滚到负数），事件画布同理
        player.renderingBeats = base + delta;

        // 暂停时没有播放循环 —— 只改 audio.currentTime 不会重绘，
        // 得手动 render 一次，`drawn` 才会把编辑器带到新位置
        void player.render();
    };

    notesEditor.addEventListener("timescroll", onTimeScroll);
    eventSequenceEditors.addEventListener("timescroll", onTimeScroll);

    // 画布里的判定线切换按钮 → 页面（`selectedLineNumber` 的单一数据源在这里）
    const onTargetChange = (event: Event) => {
        const line = (event as Event & { judgeLine?: { id: number } }).judgeLine;

        if (line) selectedLineNumber.set(line.id);
    };

    notesEditor.addEventListener("targetchange", onTargetChange);
    // 事件画布的换线按钮同样回灌到页面
    eventSequenceEditors.addEventListener("targetchange", onTargetChange);
    player.addEventListener("drawn", () => {
        if (showingGrid && pre0 === 0) {
            notesEditor.draw(player.renderingBeats);
            eventSequenceEditors.draw(player.renderingBeats);
        }
        // 每帧只**刷新数值**（Svelte 原版就是 `judgeLinesManager?.update()`）；
        // 结构重建走 `needsreflow` → `reflowAll()`
        refreshAll();
    });
    const updateUndoRedoAvailability = () => {
        undoAvailable = operationList.operations.length > 0;
        redoAvailable = operationList.undoneOperations.length > 0;
    }
    operationList.addEventListener("do", updateUndoRedoAvailability);
    operationList.addEventListener("undo", updateUndoRedoAvailability);
    operationList.addEventListener("redo", updateUndoRedoAvailability);

    operationList.addEventListener("needsupdate", () => {
        player.render();
    });
    // 增删判定线 / 改父子关系之后才需要重建列表结构
    operationList.addEventListener("needsreflow", () => {
        reflowAll();
    });
    // maxCombo 由 kipphi 的 OperationList 自己维护，这里不需要再算
    operationList.addEventListener("firstmodified", (ev) => {
        chart.modified = true;
    });
    operationList.addEventListener("undo", (e) => {
        notify("Undo: " + e.operation.constructor.name, "info");
    })
    operationList.addEventListener("redo", (e) => {
        notify("Redo: " + e.operation.constructor.name, "info");
    });
    operationList.addEventListener("error", (e) => {
        notify("Error: " + e.error.message, "error")
    })
    notesEditor.addEventListener("noteselected", (ev) => {
        selectedNote.set(ev.note);
        activeSecondarySidebar.set(SecondarySidebar.NOTE);
    });
    notesEditor.addEventListener("notescopeselected", (ev) => {
        selectedNotes.set(ev.notes);
        activeSecondarySidebar.set(SecondarySidebar.MULTI_NOTE);
    });
    eventSequenceEditors.addEventListenerForAll("nodeselected", (ev) => {
        // @ts-expect-error 仅供调试
        window.__lastNode = ev.node;
        // @ts-expect-error 仅供调试
        window.__nodeStore = selectedNode;

        selectedNode.set(ev.node);
        activeSecondarySidebar.set(SecondarySidebar.EVENT);
    });
    eventSequenceEditors.addEventListenerForAll("nodescopeselected", (ev) => {
        selectedNodes.set(ev.nodes);
        activeSecondarySidebar.set(SecondarySidebar.MULTI_NODE);
    });
    eventSequenceEditors.addEventListener("eventtypechange", (e) => {
        eventsType.set(e.eventType);
    });
    eventSequenceEditors.addEventListener("layerchange", (e) => {
        eventsLayer.set(e.layer);
    })
    player.renderingOffset = KPASettings.renderingOffset;
    // @ts-expect-error 仅供调试
    window.player = player;
    // @ts-expect-error 仅供调试
    window.operationList = operationList;
    // 贴图 / 视频 / 着色器都由适配器提供，播放器自己决定什么时候要
    player.use({
        texture: (name) => fetchTexture(chartId, name),
        video: (name) => fetchVideo(chartId, name),
        shader: (path) => fetchShader(chartId, path),
    });
    await player.receive(chart);
    // 编辑过程中新加的贴图 / 视频 / 着色器会自动补上，不用手动重扫
    player.watch(operationList);

    if (KPAError.buffer.length > 0) {
        setTimeout(() => {
            notify(_("main.errors.notify"), "error")
        }, 3000)
    }

    if (KPASettings.autosaveEnabled) {
        AutoSaveRunner.init(chart);
        AutoSaveRunner.run();
    }


    EditorGlobalInit(notesEditor, eventSequenceEditors, operationList, player);
    restoreStates();

    /*
     * 当前判定线：编辑器用 `selectedLineNumber`（数组下标），判定线列表用
     * `selectedLineId`（线自己的 id）。两边是独立信号，不接起来就会出现
     * 「在画布上切了线，列表还高亮着上一条」。
     *
     * 互相写之前都比一下当前值，避免 A→B→A 的来回推送。
     */
    selectedLineNumber.subscribe((index) => {
        const line = operationList?.chart.judgeLines[index];

        if (line && selectedLineId.get() !== line.id) selectedLineId.set(line.id);
    });

    selectedLineId.subscribe((id) => {
        if (id === null) return;

        const lines = operationList?.chart.judgeLines ?? [];
        const index = lines.findIndex((line) => line.id === id);

        if (index >= 0 && index !== selectedLineNumber.get()) {
            selectedLineNumber.set(index);
        }
    });

    initialized = true;
}

function teardown() {
    // 停止音频播放
    if (audio) {
        audio.pause();
        audio.src = "";
        audio.load();
    }
    // 停止播放器
    if (player) {
        player.pause();
        player.destroy();
    }

    
    document.removeEventListener("wheel", globalHandleWheel);
    document.removeEventListener("keydown", handleKeydown);
    document.removeEventListener("keyup", handleKeyup);

    window.removeEventListener("beforeunload", handleExit);

    if (KPASettings.autosaveEnabled) {
        AutoSaveRunner.stop();
    }
    // 清理编辑器
    if (notesEditor) {
        // 如果有清理方法，调用它
    }
    if (eventSequenceEditors) {
        // 如果有清理方法，调用它
    }
    // 移除全局引用
    // @ts-expect-error 仅供调试
    if (window.player === player) window.player = null;
    // @ts-expect-error 仅供调试
    if (window.Images === Images) delete window.Images;
    // @ts-expect-error 仅供调试
    if (window.audioProcessor === audioProcessor) delete window.audioProcessor;
}



let tipIndex: number = $state(0);
let timeout: number;
function updateTip() {
    tipIndex = Math.floor(Constants.tips.length * Math.random());
    timeout = window.setTimeout(() => {
        updateTip();
    }, Constants.TIP_INTERVAL);
}
updateTip();



    // 模板里用到的 store：各开一个本地别名
    const activeSecondarySidebarValue = $node({ get: () => activeSecondarySidebar.get(), listen: (update) => activeSecondarySidebar.subscribe(update) });
    const selectedNoteValue = $node({ get: () => selectedNote.get(), listen: (update) => selectedNote.subscribe(update) });
    const selectedNodeValue = $node({ get: () => selectedNode.get(), listen: (update) => selectedNode.subscribe(update) });
    const selectedNodesValue = $node({ get: () => selectedNodes.get(), listen: (update) => selectedNodes.subscribe(update) });
    const selectedNotesValue = $node({ get: () => selectedNotes.get(), listen: (update) => selectedNotes.subscribe(update) });
    const activeSidebarValue = $node({ get: () => activeSidebar.get(), listen: (update) => activeSidebar.subscribe(update) });

    /*
     * 右侧栏改成**标签页**（移动端那套），原来 11 个面板收进 5 页：
     *
     *   判定线 / 属性（折叠面板：音符 / 事件 / 多选）/ 错误 / 设置 / 脚本
     *
     * `activeSecondarySidebar` 仍然管「属性」页里具体显示哪一个 —— 选中音符
     * 自动跳到音符属性这类逻辑不用改。
     */
    const SIDEBAR_TABS = [
        { id: 0, label: "main.secondary.lines" },
        { id: 1, label: "main.secondary.objects" },
        { id: 2, label: "main.secondary.errors" },
        { id: 3, label: "main.secondary.general" },
        { id: 4, label: "main.secondary.script" },
    ];

    function tabOfPanel(panel: unknown): number {
        if (panel === SecondarySidebar.LINES) return 0;
        if (panel === SecondarySidebar.ERRORS) return 2;
        if (panel === SecondarySidebar.GENERAL) return 3;
        if (panel === SecondarySidebar.SCRIPT) return 4;

        // 音符 / 事件 / 多选 / 判定线属性 / 谱面 / 宏 都归到「属性」
        return 1;
    }

    const activeTabValue = $node({
        get: () => tabOfPanel(activeSecondarySidebar.get()),
        set: (id: number) => {
            selectTab(id);
        },
        listen: (update) => activeSecondarySidebar.subscribe(update),
        active: true,
    });

    function selectTab(id: number): void {
        // 切到错误页时同步一次 `KPAError.buffer`
        if (id === 2) refreshChartErrors();

        if (id === 0) activeSecondarySidebar.set(SecondarySidebar.LINES);
        else if (id === 2) activeSecondarySidebar.set(SecondarySidebar.ERRORS);
        else if (id === 3) activeSecondarySidebar.set(SecondarySidebar.GENERAL);
        else if (id === 4) activeSecondarySidebar.set(SecondarySidebar.SCRIPT);
        else activeSecondarySidebar.set(SecondarySidebar.NOTE);
    }
</script>

<script onmount>
    // grain 没有卸载钩子：下一个谱面页建起来时先把上一个收拾掉
    registerPageCleanup(teardown);
    boot();
</script>

<main class="container">
    <div id="inner" onwheel={handleWheel} style="--aspect-ratio: {aspect}">
        <canvas bind:this={playerCanvas} id="player" width={playerWidth} height={KPASettings.playerHeight}>Your device does not support the HTML5 canvas element.</canvas>
        <canvas bind:this={notesEditorCanvas} id="ne" width={600} height={900}>Your device does not support the HTML5 canvas element.</canvas>
        <canvas bind:this={eventSequenceEditorCanvas} id="ece" width={600} height={900}>Your device does not support the HTML5 canvas element.</canvas>
    </div>
    <!-- 画布必须一开始就存在（`Player.create` 拿的就是它们）；侧栏里的面板靠 `{#if}` 惰性建 -->
    <!--
        右侧栏：原来的主 / 次两个（20vh + 30vh）合并成这一块 50vh。
        判定线序号、播放器开关都并进各自的页签；`NotesSidebar` / `EventsSidebar`
        不要了 —— KPA 3 的画布自带那些按钮。
    -->
    <div id="sidebar">
        <div class="sidebar-shadow"></div>
        <div class="sidebar-content">
            <div class="tabs">
                {#for tab of SIDEBAR_TABS with key = tab.id}
                    <button
                        class="tab {activeTabValue === tab.id ? 'active' : ''}"
                        onclick={() => selectTab(tab.id)}
                    >{_(tab.label)}</button>
                {/for}
            </div>

            <!--
                页面体是**唯一**的滚动容器：tabs 固定在上面不跟着滚。
                （`.sidebar-content` 只负责纵向排布，overflow 交给这里。）
            -->
            <div class="sidebar-panel">
            {#if activeSecondarySidebarValue === SecondarySidebar.LINES}
                <JudgeLines></JudgeLines>
            {:else if activeSecondarySidebarValue === SecondarySidebar.NOTE}
                {#if selectedNoteValue && selectedNoteValue.parentNode}
                    <div class="padded">
                        <NoteSheet
                            note={selectedNoteValue}
                            editor={notesEditor}
                            onclose={() => {}}
                        ></NoteSheet>
                    </div>
                {:else}
                <div style="color: var(--color-foreground)">{_("main.note.noNote")}</div>
                {/if}
            {:else if activeSecondarySidebarValue === SecondarySidebar.EVENT}
                {#if selectedNodeValue && selectedNodeValue.parentSeq}
                    <div class="padded">
                        <EventSheet
                            node={selectedNodeValue}
                            editor={eventSequenceEditors}
                            onclose={() => {}}
                        ></EventSheet>
                    </div>
                {:else}
                <div style="color: var(--color-foreground)">{_("main.event.noEvent")}</div>
                {/if}
            {:else if activeSecondarySidebarValue === SecondarySidebar.LINE}
                {#if selectedLineValue}
                    <div class="padded">
                        <JudgeLineSheet
                            line={selectedLineValue}
                            onclose={() => {}}
                        ></JudgeLineSheet>
                    </div>
                {:else}
                    <div style="color: var(--color-foreground)">没有选中的判定线</div>
                {/if}
            {:else if activeSecondarySidebarValue === SecondarySidebar.MULTI_NODE}
                {#if selectedNodesValue && selectedNodesValue.size > 0}
                    <div class="padded">
                        <MultiNodeSheet
                            nodes={[...selectedNodesValue]}
                            onclose={() => {}}
                        ></MultiNodeSheet>
                    </div>
                {/if}
            {:else if activeSecondarySidebarValue === SecondarySidebar.MULTI_NOTE}
                {#if selectedNotesValue && selectedNotesValue.size > 0}
                    <div class="padded">
                        <MultiNoteSheet
                            notes={[...selectedNotesValue]}
                            onclose={() => {}}
                        ></MultiNoteSheet>
                    </div>
                {/if}
            {:else if activeSecondarySidebarValue === SecondarySidebar.ERRORS}
                <!-- 解析警告：照搬移动端那一段（只读列表） -->
                <div class="padded">
                {#if chartErrors.length === 0}
                    <p class="errors-empty">没有解析警告</p>
                {:else}
                    {#for error of chartErrors}
                        <div class="error-line">
                            <span class="error-tag {error.fixed ? 'fixed' : ''}">
                                {error.fixed ? "已修复" : "警告"}
                            </span>
                            <span class="error-text">{error.message}</span>
                        </div>
                    {/for}
                {/if}
                </div>
            {:else if activeSecondarySidebarValue === SecondarySidebar.MACRO}
                <div class="padded">
                    <MacroSheet macro={null} onclose={() => {}}></MacroSheet>
                </div>
            {:else if activeSecondarySidebarValue === SecondarySidebar.GENERAL}
                <!-- 播放器开关 / 时间参数：全部用移动端的 Switch + NumField -->
                <div class="padded">
                <div class="setting">
                    <span>{_("main.player.showsUI")}</span>
                    <Switch bind:checked={get: () => playerShowsUI.get(), set: (v: boolean) => playerShowsUI.set(v)} />
                </div>
                <div class="setting">
                    <span>{_("main.player.showsLineID")}</span>
                    <Switch bind:checked={get: () => playerShowsLineID.get(), set: (v: boolean) => playerShowsLineID.set(v)} />
                </div>
                <div class="setting">
                    <span>{_("main.player.hitEffectNoFollows")}</span>
                    <Switch bind:checked={get: () => playerHitEffectNoFollows.get(), set: (v: boolean) => playerHitEffectNoFollows.set(v)} />
                </div>
                <div class="setting">
                    <span>{_("main.player.showsCurve")}</span>
                    <Switch bind:checked={get: () => playerShowsCurve.get(), set: (v: boolean) => playerShowsCurve.set(v)} />
                </div>
                <div class="setting">
                    <span>{_("main.player.volume")}</span>
                    <NumField
                        bind:value={get: () => String(volume), set: (raw: string) => {
                            const next = Number(raw);
                            if (Number.isFinite(next)) volume = next;
                        }}
                    />
                </div>
                <div class="setting">
                    <span>{_("main.player.cameraZoom")}</span>
                    <NumField
                        bind:value={get: () => String(playerCameraZoom.get()), set: (raw: string) => {
                            const next = Number(raw);
                            if (Number.isFinite(next)) playerCameraZoom.set(next);
                        }}
                    />
                </div>
                <div class="setting">
                    <span>{_("main.sidebar.timeDivisor.term")}</span>
                    <NumField
                        bind:value={get: () => String(timeDivisor.get()), set: (raw: string) => {
                            applyTimeDivisor(raw);
                        }}
                    />
                <div class="presets">
                    <Segmented
                        variant="plain"
                        options={divisorOptions}
                        bind:value={get: () => timeDivisor.get(), set: (value: number) => {
                            applyTimeDivisor(String(value));
                        }}
                    />
                </div>
                </div>
                <div class="setting">
                    <span>{_("main.sidebar.renderingOffset.term")}</span>
                    <NumField
                        bind:value={get: () => String(KPASettings.renderingOffset), set: (raw: string) => {
                            const next = Number(raw);
                            if (!Number.isFinite(next)) return;
                            player.renderingOffset = next;
                            KPASettings.renderingOffset = next;
                        }}
                    />
                </div>
                <div class="setting">
                    <span>{_("main.general.baseOffset")}</span>
                    <NumField
                        bind:value={get: () => String(KPASettings.baseOffset), set: (raw: string) => {
                            const next = Number(raw);
                            if (!Number.isFinite(next)) return;
                            player.baseOffset = next;
                            KPASettings.baseOffset = next;
                        }}
                    />
                </div>
                <div class="setting">
                    <span>{_("main.general.replayCompensation")}</span>
                    <NumField
                        bind:value={get: () => String(KPASettings.replayCompensation), set: (raw: string) => {
                            const next = Number(raw);
                            if (Number.isFinite(next)) KPASettings.replayCompensation = next;
                        }}
                    />
                </div>

                <!-- 画布参数：照搬移动端设置页 -->
                <div class="setting">
                    <span>时间跨度（拍）</span>
                    <NumField
                        bind:value={get: () => String(timeSpanValue), set: (raw: string) => {
                            applyTimeSpan(raw);
                        }}
                    />
                <div class="presets">
                    <Segmented
                        variant="plain"
                        options={timeSpanOptions}
                        bind:value={get: () => timeSpanValue, set: (value: number) => {
                            applyTimeSpan(String(value));
                        }}
                    />
                </div>
                </div>
                <div class="setting">
                    <span>值跨度</span>
                    <NumField
                        bind:value={get: () => String(positionSpanValue), set: (raw: string) => {
                            applyPositionSpan(raw);
                        }}
                    />
                <div class="presets">
                    <Segmented
                        variant="plain"
                        options={positionSpanOptions}
                        bind:value={get: () => positionSpanValue, set: (value: number) => {
                            applyPositionSpan(String(value));
                        }}
                    />
                </div>
                </div>
                <div class="setting">
                    <span>音符网格间距</span>
                    <NumField
                        bind:value={get: () => String(gridValue), set: (raw: string) => {
                            applyNoteGrid(raw);
                        }}
                    />
                <div class="presets">
                    <Segmented
                        variant="plain"
                        options={gridOptions}
                        bind:value={get: () => gridValue, set: (value: number) => {
                            applyNoteGrid(String(value));
                        }}
                    />
                </div>
                </div>
                <div class="setting">
                    <span>显示 NNN 参考线</span>
                    <Switch
                        bind:checked={get: () => showsNNNValue, set: (v: boolean) => {
                            applyShowsNNN(v);
                        }}
                    />
                </div>
                <div class="setting">
                    <span>拖到边缘自动滚动</span>
                    <Switch
                        bind:checked={get: () => edgeScrollValue, set: (v: boolean) => {
                            applyEdgeScroll(v);
                        }}
                    />
                </div>
                </div>
            {:else if activeSecondarySidebarValue === SecondarySidebar.SCRIPT}
                <!-- 用户脚本：预留一页，后面接 -->
                <div class="padded" style="opacity: 0.6">
                    用户脚本（待实现）
                </div>
            {/if}
            </div>
        </div>
    </div>
    <div id="footer">
        <!-- `player` 是 onmount 里异步建的：建好之前点了先忽略，别让它冒泡成未捕获错误 -->
        <PlayButton checked={isPlaying} onchange={(playing) => playing ? play() : player?.pause()}/>
        <GridSwitch bind:checked={showingGrid} onchange={(checked) => {
            if (checked) {
                notesEditorCanvas.style.display = "";
                eventSequenceEditorCanvas.style.display = "";
                // 如果没有在播放，手动渲染一次
                if (!player.playing) {
                    notesEditor.draw(player.renderingBeats);
                    eventSequenceEditors.draw(player.renderingBeats);
                }
            } else {
                notesEditorCanvas.style.display = "none";
                eventSequenceEditorCanvas.style.display = "none";
            }
        }} />
            <input type="range" bind:this={progressBar} value={audio.currentTime} step="0.01" max={chart?.duration ?? 0}
                oninput={
                    (event) => {
                        audio.currentTime = progressBar.valueAsNumber;
                        player.pause();
                        requestAnimationFrame(() => player.render())
                    }
                }
                onmousedown={() => player.pause()}>
        <!-- !表示preservesPitch=false -->
        <PopupOption options={[
            "1.0x", "0.5x",  "0.25x",  "0.75x",  "1.5x",  "2.0x"
        ]} bind:currentOption={ get: () => speed, set: applySpeed } />
        <TextSwitchButton onText="Y" offText="N" bgText={_("general.preservesPitch")} bind:checked={ get: () => preservesPitch, set: applyPreservesPitch } />
    </div>
    <div id="secondary-footer">
        <span id="tips" onclick={() => {clearTimeout(timeout);updateTip()}}>Tips: {Constants.tips[tipIndex]}</span>
        <span class="history-button" style="opacity: {undoAvailable ? 1 : 0.2}" role="button" onclick={() => operationList.undo()}>↶</span>
        <span class="history-button" style="opacity: {redoAvailable ? 1 : 0.2}" role="button" onclick={() => operationList.redo()}>↷</span>
    </div>
</main>

<div id="cover" style="display: {initialized ? 'none' : ''}">LOADING</div>

<style>
:global(:root) {
  --player-height: 85vh;
  --bottom-bar-height: 11vh;
  --bottom-tips-height: 4vh;
  --player-width: calc(100vw - 50vh);
  --color-foreground: white;
}
.container {
  display: grid;
  grid-template-columns: auto 1fr 1fr;
  grid-template-rows: var(--player-height) var(--bottom-bar-height) var(--bottom-tips-height);
  width: 100%;
  background-color: #444;
}
#inner {
  --aspect-ratio: calc(3 / 2);
  --actual-player-height: min(var(--player-height), calc(var(--player-width) / var(--aspect-ratio)));
  height: var(--actual-player-height);
  grid-column: 1 / 2;
  position: relative;
}
#footer {
  grid-row: 2 / 3;
  grid-column: 1 / 4;
  display: flex;
  align-items: center;
  padding: 0 2vh;
  gap: 1vh;
  background-color: #333;
}
#secondary-footer {
  grid-row: 3 / 4;
  grid-column: 1 / 4;
  background-color: #333;
  color: white;
  display: flex;
}
#secondary-footer #tips {
  flex: 1;
}
input[type="range"] {
  flex: 1;
}
#player {
  height: var(--actual-player-height);
}
#ne {
  position: absolute;
  top: 0;
  height: var(--actual-player-height);
  left: 0;
  transition: 0.3s opacity ease;
}
#ece {
  position: absolute;
  top: 0;
  height: var(--actual-player-height);
  right: 0;
  transition: 0.3s opacity ease;
}
#ne:hover,
#ece:hover {
  opacity: 1;
}
#ne:active,
#ece:active {
  cursor: grabbing;
}
/* 原来两个侧栏合计 50vh，合并后仍然是 50vh（`--player-width` 不用改） */
#sidebar {
  position: fixed;
  height: var(--player-height);
  width: 50vh;
  right: 0;
  top: 0;
  background-color: #555;
  /* 搬过来的移动端组件按 `--text` 写字，不给就是浏览器默认的黑色 */
  color: var(--text);
  z-index: 1;
  /* 不再加内边距：移动端的行 / 工具栏自带 padding，叠加起来左右会挤一圈 */
  padding: 0;
  box-sizing: border-box;
  scrollbar-width: none;
  display: flex;
  flex-direction: column;
}
.sidebar-shadow {
  position: absolute;
  height: var(--player-height);
  width: 6px;
  left: -6px;
  top: 0;
  box-shadow: -6px 0 6px -6px #000 inset;
}
.sidebar-content {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  /* 自己不滚：滚动交给下面的 `.sidebar-panel`，tabs 才能固定住 */
  overflow: hidden;
  display: flex;
  /* `stretch`：搬来的列表 / Sheet 要铺满整宽（`center` 会让它们缩成一条） */
  align-items: stretch;
  flex-direction: column;
  gap: 3px;
  scrollbar-width: none;
}

/* 页面体：唯一可滚动的部分（tabs 在它上面，不跟着滚） */
.sidebar-panel {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 3px;
  scrollbar-width: none;
}
.sidebar-content:focus {
  scroll-behavior: auto;
}
/*
 * 右侧栏顶部的标签页 —— 样式照搬移动端的 `.tabs` / `.tab`：
 * 均分、无圆角、选中靠「变色 + 底部下划线」，不是高亮块。
 */
.tabs {
  display: flex;
  flex: none;
  width: 100%;
  padding: 0;
  margin: 0;
  background: #3c3c3c;
  border-bottom: 1px solid #555;
}
.tab {
  flex: 1;
  border: none;
  border-radius: 0;
  background: none;
  padding: 10px 4px;
  font: inherit;
  font-size: 13px;
  color: #999;
  white-space: nowrap;
  cursor: pointer;
}
.tab.active {
  color: #4c8dff;
  font-weight: 600;
  box-shadow: inset 0 -2px 0 #4c8dff;
}
/*
 * 设置页一行：左边标签、右边控件。
 *
 * 用 grid 而不是 flex —— 右侧固定一列宽度，所有输入框的左右边就对齐了
 *（flex 下每个输入框按内容撑开，长短不一）。左边 `minmax(0, 1fr)` 允许
 * 收缩，配 `nowrap` + 省略号，标签长了也不会把输入框挤歪。
 */
.setting {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 140px;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 10px 0 4px;
  font-size: 14px;
  color: #ddd;
  border-bottom: 1px solid #666;
}

.setting > :first-child {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 输入框铺满固定那一列；开关保持自己的尺寸、靠右站 */
/*
 * 子组件的根元素要用 `:global`：编译器给每个选择器加 scope 后缀，而
 * `NumField` 里的 `input`、`Switch` 里的 `button` 都不属于本文件，
 * 带上 scope 就永远匹配不到 —— 选择器等于被丢弃。
 */

/* 输入框（`NumField` 的根就是 `<input class="num">`）：铺满右列 */
.setting > :global(input) {
  grid-column: 2;
  width: 100%;
  min-width: 0;
}

/* 开关（`Switch` 的根是 `<button>`）：在右列内贴右 */
.setting > :global(button) {
  grid-column: 2;
  justify-self: end;
}

/*
 * 设置项下面那排常用值：贴右、和输入框同一条竖线。
 * 分隔横线在 `.setting` 上，所以这里不再画线，只收紧上下间距。
 */
/* 常用值：`.setting` 的第三个子元素，占满整行 → 换到输入框下面 */
.setting > .presets {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  padding: 2px 0 0;
  }
/*
 * 设置页 / 错误页的外层留白。
 *
 * 判定线列表和几个 Sheet 是移动端组件，自带 padding；这两页是页面手写的，
 * 侧栏又去掉了统一 padding（否则列表两侧会多一层），所以这里单独补。
 */
.padded {
  width: 100%;
  padding: 12px 16px;
  box-sizing: border-box;
}
/* 错误页（照搬移动端） */
.errors-empty {
  margin: 0;
  padding: 16px 0;
  font-size: 13px;
  color: #999;
}
.error-line {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  width: 100%;
  padding: 8px 0;
  border-bottom: 1px solid #5a5a5a;
  font-size: 13px;
  line-height: 1.5;
}
.error-tag {
  flex: none;
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 11px;
  background: #a33;
  color: #fff;
}
.error-tag.fixed {
  background: #3a7;
}
.error-text {
  color: #ddd;
  word-break: break-word;
}
.monaco-sidebar {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
#cover {
  position: fixed;
  background-color: #0007;
  width: 100vw;
  height: 100vh;
  z-index: 1145141919;
  top: 0;
  left: 0;
  font-size: large;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10vh;
}
</style>