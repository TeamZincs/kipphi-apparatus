<script>
    /*
     * 谱面信息面板（替代被废掉的 `ChartInfoEditor`）。
     *
     * 每个字段都走 `$node`：读的是 `operationList.chart` 的**当前值**。
     *
     * 不能写成 `const chart = operationList?.chart` —— 那是组件创建时求值
     * 一次，而 `operationList` 是页面在 `init` 里才赋值的；面板先建、列表后设
     * 的话这里就一直是 `undefined`，输入框全空。`$node` 的 getter 每次都重读。
     *
     * 改完走 `operationList`，所以能撤销。
     */
    import { Op } from "kipphi";

    import NumField from "#/components/NumField.grain";
    import TextField from "#/components/TextField.grain";
    import { operationList } from "./store";

    let { onclose } = $props<{ onclose: () => void }>();

    type TextProp = "name" | "level" | "composer" | "charter" | "illustrator";

    type ChartShape = Record<TextProp, string> & { offset: number };

    /** 当前谱面（每次读都是最新的） */
    const current = (): ChartShape | undefined =>
        operationList?.chart as unknown as ChartShape | undefined;

    function commit(prop: TextProp, raw: string): void {
        const value = raw.trim();
        const chart = operationList?.chart;

        if (!chart || value.length === 0) return;
        if ((chart as unknown as Record<string, unknown>)[prop] === value) return;

        operationList!.do(
            new Op.ChartPropChangeOperation(chart, prop, value),
        );
    }

    function commitOffset(raw: string): void {
        const value = Number(raw);
        const chart = operationList?.chart;

        if (!chart || !Number.isFinite(value)) return;
        if (chart.offset === value) return;

        operationList!.do(
            new Op.ChartPropChangeOperation(chart, "offset", value),
        );
    }

    /*
     * 每个字段一个 `$node`：getter 现读，setter 提交操作。
     * `TextField` / `NumField` 的 `bind:value` 接的就是它。
     */
    const nameNode = $node({
        get: () => current()?.name ?? "",
        set: (value: string) => commit("name", value),
    });

    const levelNode = $node({
        get: () => current()?.level ?? "",
        set: (value: string) => commit("level", value),
    });

    const composerNode = $node({
        get: () => current()?.composer ?? "",
        set: (value: string) => commit("composer", value),
    });

    const charterNode = $node({
        get: () => current()?.charter ?? "",
        set: (value: string) => commit("charter", value),
    });

    const illustratorNode = $node({
        get: () => current()?.illustrator ?? "",
        set: (value: string) => commit("illustrator", value),
    });

    const offsetNode = $node({
        get: () => String(current()?.offset ?? 0),
        set: (value: string) => commitOffset(value),
    });
</script>

<div class="chart-info">
    <div class="field">
        <span>曲名</span>
        <TextField bind:value={nameNode}></TextField>
    </div>

    <div class="field">
        <span>难度</span>
        <TextField bind:value={levelNode}></TextField>
    </div>

    <div class="field">
        <span>作曲</span>
        <TextField bind:value={composerNode}></TextField>
    </div>

    <div class="field">
        <span>谱师</span>
        <TextField bind:value={charterNode}></TextField>
    </div>

    <div class="field">
        <span>曲绘</span>
        <TextField bind:value={illustratorNode}></TextField>
    </div>

    <div class="field">
        <span>偏移</span>
        <NumField bind:value={offsetNode}></NumField>
    </div>
</div>

<style>
.chart-info {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    align-items: center;
    column-gap: 12px;
    padding: 10px 0 6px;
    border-bottom: 1px solid var(--border, #666);
    font-size: 14px;
    color: var(--text, #eee);
}

.field > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 输入框只管宽度，配色 / 内边距交给 TextField / NumField 自己 */
.field >:global(input) {
    width: 100%;
    min-width: 0;
}
</style>
