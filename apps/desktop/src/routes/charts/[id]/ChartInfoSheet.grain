<script>
    /*
     * 谱面信息面板（替代被废掉的 `ChartInfoEditor`）。
     *
     * 绑定写成 `bind:value={get, set}` 字面量，**不套 `$node`**。
     *
     * `$node` 会把 `get` 的结果缓存进一个变量（`let nameNode = node.get()`），
     * 只在 `listen` 触发时重算。而 `operationList.chart` 不是 store，没东西可
     * 监听 —— 结果是组件创建那一刻求一次值，那时谱面可能还没加载，输入框全空，
     * 点一下（触发 setter）才会有内容。
     *
     * 直接给 `get` 函数：`TextField` / `NumField` 每次读都现调，永远是最新的。
     *
     * 改完走 `operationList`，所以能撤销。
     */
    import { Op } from "kipphi";

    import NumField from "#/components/NumField.grain";
    import TextField from "#/components/TextField.grain";
    import { operationList } from "./store";

    let { onclose } = $props<{ onclose: () => void }>();

    type TextProp = "name" | "level" | "composer" | "charter" | "illustrator";

    type ChartShape = Record<TextProp, string> & { offset: number };

    /** 当前谱面（每次读都是最新的） */
    const current = (): ChartShape | undefined =>
        operationList?.chart as unknown as ChartShape | undefined;

    function commit(prop: TextProp, raw: string): void {
        const value = raw.trim();
        const chart = operationList?.chart;

        if (!chart || value.length === 0) return;
        if ((chart as unknown as Record<string, unknown>)[prop] === value) return;

        operationList!.do(
            new Op.ChartPropChangeOperation(chart, prop, value),
        );
    }

    function commitOffset(raw: string): void {
        const value = Number(raw);
        const chart = operationList?.chart;

        if (!chart || !Number.isFinite(value)) return;
        if (chart.offset === value) return;

        operationList!.do(
            new Op.ChartPropChangeOperation(chart, "offset", value),
        );
    }
</script>

<div class="chart-info">
    <div class="field">
        <span>曲名</span>
        <TextField
            bind:value={get: () => current()?.name ?? "", set: (value: string) => {
                commit("name", value);
            }}
        ></TextField>
    </div>

    <div class="field">
        <span>难度</span>
        <TextField
            bind:value={get: () => current()?.level ?? "", set: (value: string) => {
                commit("level", value);
            }}
        ></TextField>
    </div>

    <div class="field">
        <span>作曲</span>
        <TextField
            bind:value={get: () => current()?.composer ?? "", set: (value: string) => {
                commit("composer", value);
            }}
        ></TextField>
    </div>

    <div class="field">
        <span>谱师</span>
        <TextField
            bind:value={get: () => current()?.charter ?? "", set: (value: string) => {
                commit("charter", value);
            }}
        ></TextField>
    </div>

    <div class="field">
        <span>曲绘</span>
        <TextField
            bind:value={get: () => current()?.illustrator ?? "", set: (value: string) => {
                commit("illustrator", value);
            }}
        ></TextField>
    </div>

    <div class="field">
        <span>偏移</span>
        <NumField
            bind:value={get: () => String(current()?.offset ?? 0), set: (raw: string) => {
                commitOffset(raw);
            }}
        ></NumField>
    </div>
</div>

<style>
.chart-info {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    align-items: center;
    column-gap: 12px;
    padding: 10px 0 6px;
    border-bottom: 1px solid var(--border, #666);
    font-size: 14px;
    color: var(--text, #eee);
}

.field > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 输入框只管宽度，配色 / 内边距交给 TextField / NumField 自己 */
.field >:global(input) {
    width: 100%;
    min-width: 0;
}
</style>
