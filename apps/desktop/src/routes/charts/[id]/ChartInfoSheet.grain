<script macro>
    /*
     * `$chartBinding(prop)`：把一个谱面字段展开成完整的绑定字面量。
     *
     * `$node` 是 rune —— 只吃**字面量**的 `get` / `set` / `listen` / `unlisten`，
     * 传一个 `{ listen, unlisten }` 对象是不行的（编译期没有展开的余地）。
     * 宏返回代码片段，正好拼进 `$node(...)` 的参数位置。
     *
     * `listen` / `unlisten` 的配对靠模块级的 `chartEventHandlers` 记 ——
     * `unlisten` 是无参的，拿不到当次的 `update`。
     */
    function $chartBinding(prop: string) {
        return [
            "get", ":", `() => currentChart()?.${prop} ?? ""`, ",",
            "set", ":", `(value: string) => commitChartField("${prop}", value)`, ",",
            "listen", ":", `(update: () => void) => listenChartOps("${prop}", update)`, ",",
            "unlisten", ":", `() => unlistenChartOps("${prop}")`,
        ];
    }
</script>

<script>
    /*
     * 谱面信息面板（替代被废掉的 `ChartInfoEditor`）。
     *
     * 监听器注册在 `operationList` 上（它是 `EventTarget`，`do` / `undo` / `redo`
     * 都发事件）—— **不是**这个组件的元素上，所以组件销毁时没东西会自动摘掉，
     * 必须给出配对的 `unlisten`。
     */
    import { Op } from "kipphi";

    import NumField from "#/components/NumField.grain";
    import TextField from "#/components/TextField.grain";
    import { operationList } from "./store";

    let { onclose } = $props<{ onclose: () => void }>();

    type TextProp = "name" | "level" | "composer" | "charter" | "illustrator";

    type ChartShape = Record<TextProp, string> & { offset: number };

    /** 当前谱面（每次读都是最新的） */
    const currentChart = (): ChartShape | undefined =>
        operationList?.chart as unknown as ChartShape | undefined;

    const OPERATION_EVENTS = ["do", "undo", "redo"] as const;

    /** 字段名 -> 这一路的事件回调（`unlisten` 靠它找回 `update`） */
    const chartEventHandlers = new Map<string, () => void>();

    function listenChartOps(prop: string, update: () => void): void {
        if (!operationList) return;

        chartEventHandlers.set(prop, update);

        for (const type of OPERATION_EVENTS) {
            operationList.addEventListener(type, update);
        }
    }

    function unlistenChartOps(prop: string): void {
        const update = chartEventHandlers.get(prop);

        if (!operationList || !update) return;

        for (const type of OPERATION_EVENTS) {
            operationList.removeEventListener(type, update);
        }

        chartEventHandlers.delete(prop);
    }

    function commitChartField(prop: TextProp, raw: string): void {
        const value = raw.trim();
        const chart = currentChart();

        if (!chart || !operationList || value.length === 0) return;
        if ((chart as unknown as Record<string, unknown>)[prop] === value) return;

        operationList.do(new Op.ChartPropChangeOperation(chart, prop, value));
    }

    function commitChartOffset(raw: string): void {
        const value = Number(raw);
        const chart = currentChart();

        if (!chart || !operationList || !Number.isFinite(value)) return;
        if (chart.offset === value) return;

        operationList.do(new Op.ChartPropChangeOperation(chart, "offset", value));
    }

    const nameNode = $node($chartBinding("name"));
    const levelNode = $node($chartBinding("level"));
    const composerNode = $node($chartBinding("composer"));
    const charterNode = $node($chartBinding("charter"));
    const illustratorNode = $node($chartBinding("illustrator"));

    const offsetNode = $node({
        get: () => String(currentChart()?.offset ?? 0),
        set: (raw: string) => commitChartOffset(raw),
        listen: (update: () => void) => listenChartOps("offset", update),
        unlisten: () => unlistenChartOps("offset"),
    });
</script>

<div class="chart-info">
    <div class="field">
        <span>曲名</span>
        <TextField bind:value={nameNode}></TextField>
    </div>

    <div class="field">
        <span>难度</span>
        <TextField bind:value={levelNode}></TextField>
    </div>

    <div class="field">
        <span>作曲</span>
        <TextField bind:value={composerNode}></TextField>
    </div>

    <div class="field">
        <span>谱师</span>
        <TextField bind:value={charterNode}></TextField>
    </div>

    <div class="field">
        <span>曲绘</span>
        <TextField bind:value={illustratorNode}></TextField>
    </div>

    <div class="field">
        <span>偏移</span>
        <NumField bind:value={offsetNode}></NumField>
    </div>
</div>

<style>
.chart-info {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    align-items: center;
    column-gap: 12px;
    padding: 10px 0 6px;
    border-bottom: 1px solid var(--border, #666);
    font-size: 14px;
    color: var(--text, #eee);
}

.field > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 输入框只管宽度，配色 / 内边距交给 TextField / NumField 自己 */
.field >:global(input) {
    width: 100%;
    min-width: 0;
}
</style>
