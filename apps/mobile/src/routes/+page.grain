<script>
    import { navigate } from "@graints/runtime";

    import { queryCharts } from "#/background";
    import { createEmptyChart, importChartFile } from "#/chart-ops";
    import { isTauri } from "#/tauri";

    interface Item {
        identifier: string;
        title: string;
        type: string;
        cover: string | null;
        lastModified: number;
    }

    let charts = $state<Item[]>([]);
    let loading = $state(true);
    let error = $state<string | null>(null);
    let busy = $state<string | null>(null);

    let askingTitle = $state(false);
    let draftTitle = $state("");

    let fileInput: HTMLInputElement;

    /** 浏览器预览用：没有谱面目录，给一条示例 */
    const demoItem = (): Item => ({
        identifier: "__demo__",
        title: "示例谱面（浏览器预览）",
        type: "KPA1",
        cover: null,
        lastModified: 0
    });

    function open(item: Item) {
        navigate(`/charts/${encodeURIComponent(item.identifier)}`);
    }

    function fail(e: unknown) {
        error = e instanceof Error ? e.message : String(e);
    }

    async function refresh() {
        try {
            const list = await queryCharts();

            charts = list.map((info) => ({
                identifier: info.identifier,
                title: info.title || info.identifier,
                type: info.type,
                cover: info.image ? URL.createObjectURL(info.image) : null,
                lastModified: info.lastModified
            }));

            if (!isTauri()) charts = [demoItem()];
        } catch (e) {
            fail(e);
        } finally {
            loading = false;
        }
    }

    function startCreate() {
        if (!isTauri()) {
            error = "浏览器预览模式不能创建谱面，请用 `bun run dev:mobile` 起竖屏窗口";

            return;
        }

        draftTitle = "";
        askingTitle = true;
    }

    async function confirmCreate() {
        askingTitle = false;
        busy = "正在创建…";

        try {
            const id = await createEmptyChart(draftTitle);

            navigate(`/charts/${encodeURIComponent(id)}`);
        } catch (e) {
            fail(e);
        } finally {
            busy = null;
        }
    }

    function startImport() {
        if (!isTauri()) {
            error = "浏览器预览模式不能导入谱面，请用 `bun run dev:mobile` 起竖屏窗口";

            return;
        }

        fileInput?.click();
    }

    async function onFiles(event: Event) {
        const input = event.target as HTMLInputElement;
        const files = [...(input.files ?? [])];

        if (files.length === 0) return;

        busy = files.length > 1 ? `正在导入 ${files.length} 个文件…` : "正在导入…";

        try {
            let last: string | null = null;

            for (const file of files) last = await importChartFile(file);

            if (files.length === 1 && last) {
                navigate(`/charts/${encodeURIComponent(last)}`);

                return;
            }

            await refresh();
        } catch (e) {
            fail(e);
        } finally {
            busy = null;
            input.value = "";
        }
    }
</script>

<script onmount>
    void refresh();
</script>

<main class="home">
    <div class="scroll">
        {#if loading}
            <p class="hint">正在读取谱面…</p>
        {:else if charts.length === 0}
            <p class="hint">{error ?? "还没有谱面。点下面的「新建」或「导入」。"}</p>
        {:else}
            {#if error}
                <p class="hint err">{error}</p>
            {/if}

            <div class="list">
                {#for item of charts with key = item}
                    <button class="card" onclick={() => open(item)}>
                        {#if item.cover}
                            <img class="cover" src={item.cover} alt="" />
                        {:else}
                            <div class="cover placeholder">♪</div>
                        {/if}

                        <div class="meta">
                            <span class="title">{item.title}</span>
                            <span class="sub">{item.type} · {item.identifier}</span>
                        </div>
                    </button>
                {/for}
            </div>
        {/if}
    </div>

    <div class="actions">
        <button class="action" onclick={startCreate} disabled={busy !== null}>新建</button>
        <button class="action primary" onclick={startImport} disabled={busy !== null}>导入</button>
    </div>

    {#if busy}
        <div class="busy">{busy}</div>
    {/if}

    {#if askingTitle}
        <div class="dialog-mask" onclick={() => (askingTitle = false)}>
            <div class="dialog" onclick={(event) => event.stopPropagation()}>
                <p class="dialog-title">新建谱面</p>
                <input
                    class="dialog-input"
                    placeholder="谱面标题"
                    bind:value={draftTitle}
                    onkeydown={(event) => {
                        if (event.key === "Enter") confirmCreate();
                    }}
                />
                <div class="dialog-actions">
                    <button class="action" onclick={() => (askingTitle = false)}>取消</button>
                    <button class="action primary" onclick={confirmCreate}>创建</button>
                </div>
            </div>
        </div>
    {/if}

    <input
        class="file-input"
        type="file"
        multiple
        accept=".pez,.zip,.json"
        bind:this={fileInput}
        onchange={onFiles}
    />
</main>

<style>
.home {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
    position: relative;
}

.scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 12px;
    -webkit-overflow-scrolling: touch;
}

.list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.card {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow);
    text-align: left;
}

.cover {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    object-fit: cover;
    flex: none;
    background: var(--surface-2);
}

.cover.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    font-size: 22px;
}

.meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
}

.title {
    font-size: 15px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sub {
    font-size: 12px;
    color: var(--text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hint {
    text-align: center;
    color: var(--text-dim);
    font-size: 14px;
    padding: 32px 12px;
    line-height: 1.6;
}

.hint.err {
    color: #d9534f;
}

.actions {
    display: flex;
    gap: 10px;
    flex: none;
    padding: 10px 12px;
    border-top: 1px solid var(--border);
    background: var(--surface);
}

.action {
    flex: 1;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
}

.action.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
}

.action:disabled {
    opacity: 0.55;
}

.busy {
    position: absolute;
    left: 50%;
    bottom: 78px;
    transform: translateX(-50%);
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--overlay);
    color: var(--text);
    font-size: 13px;
    box-shadow: var(--shadow);
}

.dialog-mask {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.dialog {
    width: 100%;
    max-width: 320px;
    background: var(--surface);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--shadow);
}

.dialog-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
}

.dialog-input {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    outline: none;
}

.dialog-actions {
    display: flex;
    gap: 10px;
}

.file-input {
    display: none;
}
</style>
