<script>
    import { navigate, route } from "@graints/runtime";

    // 这几个都只在这个页面用一次，所以放在同目录，不占 components/
    import PlayerBox from "./PlayerBox.grain";
    import JudgeLineList from "./JudgeLineList.grain";
    import NotesPane from "./NotesPane.grain";
    import EventsPane from "./EventsPane.grain";

    import { activeTab, chart, loadChart, loadError, ready, type MobileTab } from "#/store";

    const tab = $node({ get: () => activeTab.get(), listen: (update) => activeTab.subscribe(update) });
    const isReady = $node({ get: () => ready.get(), listen: (update) => ready.subscribe(update) });
    const failed = $node({ get: () => loadError.get(), listen: (update) => loadError.subscribe(update) });

    const tabs: Array<{ id: MobileTab; label: string }> = [
        { id: "lines", label: "判定线" },
        { id: "notes", label: "音符" },
        { id: "events", label: "事件" }
    ];

    /** 三个页面共用一个横向轨道：切换时整条轨道平移（要 listen，否则 store 变了不重算） */
    const pageIndex = $node({
        get: () => Math.max(0, tabs.findIndex((item) => item.id === activeTab.get())),
        listen: (update) => activeTab.subscribe(update)
    });

    function pick(id: MobileTab) {
        activeTab.set(id);
    }

    function back() {
        if (chart?.modified && !confirm("当前谱面有未保存的更改，确定返回吗？")) return;

        navigate("/");
    }
</script>

<script onmount>
    // 路由参数在这一刻已经由 router 写好了
    void loadChart(route.get().params.id ?? null);

    // 有未保存改动时，关窗口 / 刷新让浏览器弹它自己的确认框。
    // 注意别把回调命名成 `guard`：编译器在 dev 下会给每个刷新函数插一句
    // `guard(...)`（循环检测），同名局部变量会把那个 import 遮住 → TDZ 报错。
    const warnBeforeUnload = (event: BeforeUnloadEvent) => {
        if (!chart?.modified) return;

        event.preventDefault();
        event.returnValue = "";
    };

    window.addEventListener("beforeunload", warnBeforeUnload);
</script>

<main class="app">
    {#if isReady}
        <section class="player">
            <PlayerBox></PlayerBox>
        </section>

        <nav class="tabs">
            {#for item of tabs with key = item}
                <button class="tab {item.id === tab ? 'active' : ''}" onclick={() => pick(item.id)}>
                    {item.label}
                </button>
            {/for}
        </nav>

        <!-- 三块内容始终存活：切页只平移轨道 + 切 visibility，不销毁 DOM -->
        <section class="content">
            <div class="track" style="transform: translateX({-pageIndex * 100}%)">
                <div class="slide {pageIndex === 0 ? 'active' : ''}"><JudgeLineList></JudgeLineList></div>
                <div class="slide {pageIndex === 1 ? 'active' : ''}"><NotesPane></NotesPane></div>
                <div class="slide {pageIndex === 2 ? 'active' : ''}"><EventsPane></EventsPane></div>
            </div>
        </section>
    {:else}
        <div class="center">
            {#if failed}
                <p class="err">打开谱面失败：{failed}</p>
                <button class="back-inline" onclick={back}>返回</button>
            {:else}
                <p>正在打开谱面…</p>
            {/if}
        </div>
    {/if}

    <button class="back" onclick={back} aria-label="返回">‹</button>
</main>

<style>
.app {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* 不留任何内边距：整屏就是三大块 */
    padding: 0;
    margin: 0;
    overflow: hidden;
}

.player {
    flex: none;
    padding: 0;
    margin: 0;
    /* 播放器贴边，不要圆角 */
    --player-radius: 0;
}

.tabs {
    display: flex;
    flex: none;
    padding: 0;
    margin: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
}

.tab {
    flex: 1;
    border: none;
    border-radius: 0;
    background: none;
    padding: 10px 4px;
    font-size: 13px;
    color: var(--text-dim);
}

.tab.active {
    color: var(--accent);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
}

.content {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

.track {
    display: flex;
    height: 100%;
    width: 100%;
    transition: transform 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
}

.slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    /* 非当前页 visibility: hidden（不是移除 DOM）；延迟到滑动结束再隐藏，
       免得切走的那一页在半路上消失 */
    visibility: hidden;
    transition: visibility 0s linear 0.24s;
}

.slide.active {
    visibility: visible;
    transition-delay: 0s;
}

.center {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-dim);
    font-size: 14px;
}

.err {
    color: #d9534f;
    padding: 0 16px;
    text-align: center;
}

.back-inline {
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    padding: 8px 16px;
}

.back {
    position: fixed;
    left: 8px;
    top: calc(8px + env(safe-area-inset-top));
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.42);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
}
</style>
