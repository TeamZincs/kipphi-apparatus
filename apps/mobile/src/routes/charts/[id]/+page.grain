<script>
    /*
     * 移动端编辑器页：播放器 + 标签栏 + 两块画布，全部内联。
     *
     * 跟桌面端 `routes/charts/[id]/+page.grain` 的组织方式一致 —— 只有真正
     * 会被别处复用的 `JudgeLineList` 拆成组件，其余不留组件边界：
     * 这些 DOM / 状态 / 生命周期只服务这一个页面。
     */
    import { navigate, route } from "@graints/runtime";

    import { EventSequenceEditors, NotesEditor } from "@kpa/canvas";
    import {
        AudioProcessor,
        Images,
        Player,
        Respack,
        setWasmPath,
        VideoFrameSource,
        type EffectShader
    } from "kipphi-player";
    import { fetchTexture, _ReturnType } from "@kpa/shared/background/tauri";

    import JudgeLineList from "./JudgeLineList.grain";

    import { scheduleSave } from "#/save";
    import {
        chart,
        chartId,
        illustration,
        lineOf,
        loadChart,
        musicUrl,
        operationList,
        refreshAll,
        selectedLineId
    } from "#/store";
    import { readDefaultRespackFile } from "#/tauri";

    //#region 页面状态
    type MobileTab = "lines" | "notes" | "events" | "ops";

    const tabs: Array<{ id: MobileTab; label: string }> = [
        { id: "lines", label: "判定线" },
        { id: "notes", label: "音符" },
        { id: "events", label: "事件" },
    // 只读的操作栈：已撤销的在上面，用虚线跟已做的分开
    { id: "ops", label: "操作栈" }
    ];

    let activeTab = $state<MobileTab>("lines");
    let tabIndex = $state(0);

    let ready = $state(false);
    let loadError = $state<string | null>(null);

    let playerReady = $state(false);
    let playerError = $state<string | null>(null);
    let playing = $state(false);

    let currentTime = $state(0);
    let total = $state(0);

    let controlsVisible = $state(false);
    let dragging = $state(false);
    let seekHint = $state("");

    /** 判定线列表状态刷新的节流时刻 */
    let lastTickAt = 0;

    /** 竖屏 3:2；全屏时强制 16:9（并尝试锁横屏） */
    let aspect = $state(3 / 2);
    //#endregion

    //#region 引用与实例
    let playerCanvas: HTMLCanvasElement;
    let notesCanvas: HTMLCanvasElement;
    let eventsCanvas: HTMLCanvasElement;
    let playerBox: HTMLElement;
    let pageTrack: HTMLDivElement;
    let progressEl: HTMLInputElement;

    let player: Player | null = null;
    let notesEditor: NotesEditor | null = null;
    let eventEditors: EventSequenceEditors | null = null;
    //#endregion

    /**
     * 播放器画布用固定逻辑分辨率（高 900，宽 = 高 × 宽高比），CSS 只负责缩放。
     * 画布编辑器则是桌面端那套写死的 600×900。
     */
    const BASE_HEIGHT = 900;

    const playerWidth = $node({ get: () => Math.round(aspect * BASE_HEIGHT) });

    /** 静态资源（跟桌面端同一批，在仓库根的 static/ 里） */
    const ASSETS = {
        tap: "/Tap.wav",
        drag: "/Drag.wav",
        flick: "/Flick.wav",
        anchorImg: "/Anchor.png",
        belowImg: "/Below.png",
        selectNoteImg: "/selectNote.png",
        startNodeImg: "/South.png",
        endNodeImg: "/North.png"
    } as const;

    //#region 资源初始化
    /** 默认 respack：Tauri 读 resource，浏览器退回 fetch */
    const respackPromise: Promise<Respack | null> = (async () => {
        try {
            return await Respack.loadFromPhira(async (filename) => {
                if (filename.endsWith(".ogg")) return null;

                return await readDefaultRespackFile(filename);
            });
        } catch (error) {
            return null;
        }
    })();

    /**
     * 锚点 / 多押 / 编辑器用的那些小图。
     * `Player.renderLine` 会 `drawImage(Images.ANCHOR)`，两个画布编辑器也要这些图。
     */
    const imagesPromise: Promise<void> = (async () => {
        await Images.loadAndOptimize({ anchor: ASSETS.anchorImg, below: ASSETS.belowImg });
        await Images.initImagesForEditor({
            selectNote: ASSETS.selectNoteImg,
            startNode: ASSETS.startNodeImg,
            endNode: ASSETS.endNodeImg
        });
    })();

    /** respack 里没有打击音效时退回静态资源里的 wav */
    async function audioProcessorOf(respack: Respack): Promise<AudioProcessor> {
        if (respack.TAP_SE && respack.DRAG_SE && respack.FLICK_SE) {
            return AudioProcessor.fromRespack(respack);
        }

        const processor = new AudioProcessor();

        await processor.init({ tap: ASSETS.tap, drag: ASSETS.drag, flick: ASSETS.flick });

        return processor;
    }

    /** 视频：贴图接口拿 blob，再包成 `VideoFrameSource` */
    async function fetchVideo(id: string, name: string) {
        const blob = await fetchTexture(id, name, _ReturnType.blob);

        const file = new File([blob], "file.mp4", { type: blob.type, lastModified: Date.now() });

        return await VideoFrameSource.from(file, { bufferSize: 6 });
    }

    /** 着色器：读出源码，包成 `EffectShader` */
    async function fetchShader(id: string, name: string): Promise<EffectShader> {
        const bytes = await fetchTexture(id, name, _ReturnType.u8);

        return { glsl: new TextDecoder().decode(bytes), name };
    }

    /**
     * 播放器背景。没有曲绘就用一张深灰画布顶上。
     *
     * 兜底不能走 `createImageBitmap(canvas)` —— 这个 WebView 里拿到的不是合法
     * ImageBitmap，`Player` 构造时 `drawImage` 会抛类型错误，连 Canvas 2D 回退都建不起来。
     */
    function backgroundOf(): ImageBitmap {
        if (illustration && illustration instanceof ImageBitmap) return illustration;

        const canvas = document.createElement("canvas");

        canvas.width = 16;
        canvas.height = 16;

        const context = canvas.getContext("2d");

        if (context) {
            context.fillStyle = "#101318";
            context.fillRect(0, 0, 16, 16);
        }

        return canvas as unknown as ImageBitmap;
    }
    //#endregion

    //#region 播放器
    async function bootPlayer(): Promise<void> {
        try {
            // 抓成局部：`chart` 是 live binding，await 之后不再收窄
            const target = chart;

            if (!target) throw new Error("谱面还没加载");

            setWasmPath(new URL("/web-demuxer.wasm", window.location.origin).href);

            const respack = await respackPromise;

            if (!respack) throw new Error("respack 没有加载成功");

            const audio = musicUrl ? new Audio(musicUrl) : new Audio();

            await imagesPromise;

            player = await Player.create(
                playerCanvas,
                await audioProcessorOf(respack),
                audio,
                backgroundOf(),
                respack,
                { renderer: "webgl1" }
            );
            player.hitEffectNoFollows = true;

            // 贴图 / 视频 / 着色器都从谱面目录读
            if (chartId) {
                const id = chartId;

                player.use({
                    texture: (name) => fetchTexture(id, name),
                    video: (name) => fetchVideo(id, name),
                    shader: (name) => fetchShader(id, name.startsWith("/") ? name.slice(1) : name)
                });
            }

            // 必须走 `receive`：设 chart + 初始化 lastUnplayedNNNode + 同步资源 + warmup
            await player.receive(target);

            // 桌面端同一个钩子：播放器每画完一帧，编辑器跟着画、UI 直接写 DOM
            player.addEventListener("drawn", () => {
                if (!player) return;
                

                drawEditors(player.renderingBeats);
                syncProgress();

                // 判定线列表的状态（x/y/θ/α/速度）也要跟着动。
                // 这里只**刷新数值**（桌面端 `drawn` 里调的也是 refresh）；
                // 结构重建走 `needsreflow` → `reflowAll()`。移动端再节流到 ~10Hz。
                const now = performance.now();

                // 只在**判定线列表可见**时才刷新它 —— 不可见时刷新等于白算。
                if (activeTab === "lines" && now - lastTickAt > 100) {
                    lastTickAt = now;

                    // 进度文字是模板里的 `{format(currentTime)}`，得喂响应式；
                    // 每帧写会把整页重算，所以跟着这个 10Hz 的节流一起更新
                    currentTime = player.time;
                    refreshAll();
                }
            });

            const ops = operationList;

            if (ops) {
                player.watch(ops);

                for (const type of ["do", "undo", "redo"] as const) {
                    ops.addEventListener(type, () => scheduleSave());
                }
            }

            if (!musicUrl) player.offlineTime = 0;

            // 倍速：有音源改 playbackRate；无音源时 ticker 里按倍速推进 offlineTime
            player.audio.playbackRate = playbackRate;

            total = target.duration ?? 0;
            playerReady = true;
            ready = true;

            startClock();
            syncProgress();
            drawEditors(player.renderingBeats);
        } catch (error) {
            playerError = `${error instanceof Error ? error.message : String(error)}（曲绘：${
                illustration === null ? "null" : (illustration as unknown as object)?.constructor?.name ?? "?"
            }）`;
            ready = true;
        }
    }

    /**
     * 只有**没有音源**（示例谱面）时才需要自己推进时间；
     * 有音源时播放器自己有渲染循环。
     */
    function startClock(): void {
        if (musicUrl) return;

        let last = 0;

        const step = (now: number) => {
            if (player && playing) {
                const delta = last ? (now - last) / 1000 : 0;

                player.offlineTime = (player.offlineTime ?? 0) + delta * playbackRate;
                player.render();
            }

            last = now;
            requestAnimationFrame(step);
        };

        requestAnimationFrame(step);
    }

    function pause(): void {
        if (!player) return;

        player.pause();
        playing = false;
    }

    function togglePlay(): void {
        if (!player) return;

        if (playing) {
            pause();

            return;
        }

        player.play();
        playing = true;
    }

    function seek(time: number): void {
        if (!player) return;

        const next = Math.max(0, total > 0 ? Math.min(time, total) : time);

        // `player.time` 只有 getter，跳转要写底层并做同样的偏移换算
        const offset = (player.chart?.offset ?? 0) / 1000 - (player.baseOffset ?? 0);
        const raw = next + offset;

        if (musicUrl) player.audio.currentTime = raw;
        else player.offlineTime = raw;

        currentTime = next;

        requestAnimationFrame(() => {
            player?.render();

            if (player) drawEditors(player.renderingBeats);
        });
    }
    //#endregion

    //#region 画布编辑器
    /**
     * 画布的**逻辑尺寸按面板实际大小来**（位图 = 显示尺寸，1:1）。
     *
     * 桌面端能用死 600×900，因为它的画布就是按 600×900 显示的；
     * 手机上如果还按 600×900 建位图再缩小显示，线条和文字会被重采样得发虚。
     * 编辑器内部只按 `clippingRect` 排版，给多少就按多少算，所以直接给实际尺寸。
     */
    function fitEditorCanvas(canvas: HTMLCanvasElement): [number, number, number, number] {
        const pane = canvas.parentElement;

        const width = Math.max(200, Math.floor(pane?.clientWidth || canvas.clientWidth || 360));
        const height = Math.max(240, Math.floor(pane?.clientHeight || canvas.clientHeight || 540));

        canvas.width = width;
        canvas.height = height;
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        return [0, 0, width, height];
    }

    /**
     * 把拍数喂给**当前可见**的那个画布编辑器。
     *
     * 桌面端在 `drawn` 里两个都画，因为它的两块画布都小；移动端一块画布就占满
     * 整页，另一块在 `visibility: hidden` 后面，画了也看不见 —— 那是最纯粹的浪费。
     * 切页时会 `drawActiveEditor()` 补一次，所以不会被落下。
     */
    function drawEditors(beats: number): void {
        if (!player || !Number.isFinite(beats)) return;
        if (!lineOf(selectedLineId.get())) return;

        if (activeTab === "notes") notesEditor?.draw(beats);
        else if (activeTab === "events") eventEditors?.draw(beats);
    }

    /**
     * 编辑器里滚轮/拖动滑时间 → 播放器跟着 seek。
     *
     * 编辑器只负责算出"要跳多少拍"，真正的跳转在这里做：
     * `player.renderingBeats` 的 setter 会把拍数换算成秒并写 `audio.currentTime`。
     */
    function onTimeScroll(event: Event): void {
        if (!player) return;

        const delta = (event as Event & { deltaBeats?: number }).deltaBeats ?? 0;

        if (!delta) return;

        // 播放器还没画出第一帧时 `renderingBeats` 可能是 NaN，
        // 拿它去加会把 audio.currentTime 设成 NaN，之后要等一次正常 render 才恢复
        const base = player.renderingBeats;

        if (!Number.isFinite(base)) return;

        // 不夹到 0：零前时间是合法的（音符画布就能滚到负数），事件画布同理
        player.renderingBeats = base + delta;

        // 暂停时没有播放循环 —— 只改 audio.currentTime 不会重绘，
        // 得手动 render 一次，`drawn` 才会把编辑器带到新位置
        void player.render();
    }

    /** 切页之后补一次（那一页在后台期间不跟着重绘） */
    function drawActiveEditor(): void {
        if (!player) return;

        drawEditors(player.renderingBeats);
    }

    async function bootEditors(): Promise<void> {
        // 先抓成局部变量：`operationList` 是 import 进来的 live binding，
        // `await` 之后 TS 就不再认为它非空了
        const ops = operationList;

        if (!ops) return;

        const respack = await respackPromise;

        await imagesPromise;

        // 编辑器构造时就用 `canvas.clientWidth / clientHeight` 算输入映射的缩放比，
        // 面板还没布局出来（尺寸为 0）的话这个比值会是 0 —— 等一帧再建。
        await new Promise((resolve) => requestAnimationFrame(resolve));

        notesEditor = new NotesEditor(notesCanvas, fitEditorCanvas(notesCanvas), ops, respack as never);
        eventEditors = new EventSequenceEditors(eventsCanvas, fitEditorCanvas(eventsCanvas), ops, 0.5);

        // 编辑器滚轮滑时间 → 播放器 seek
        notesEditor.addEventListener("timescroll", onTimeScroll);
        eventEditors.addEventListener("timescroll", onTimeScroll);

        // 画布里的判定线切换按钮 → 页面（`selectedLineId` 的单一数据源在这里）
        const onTargetChange = (event: Event): void => {
            const line = (event as Event & { judgeLine?: { id: number } }).judgeLine;

            if (line) selectedLineId.set(line.id);
        };

        notesEditor.addEventListener("targetchange", onTargetChange);
        // 事件画布的换线按钮同样要回灌到页面
        eventEditors.addEventListener("targetchange", onTargetChange);

        syncEditorTargets();
    }

    /** 判定线切换时把两个编辑器指过去 */
    function syncEditorTargets(): void {
        const line = lineOf(selectedLineId.get());

        if (!line) return;

        if (notesEditor) notesEditor.target = line;
        if (eventEditors) eventEditors.changeTarget({ judgeLine: line });

        drawActiveEditor();
    }
// #endregion

// #region 播放器交互
    const HIDE_DELAY = 5000;
    const DOUBLE_TAP_MS = 300;

    let hideTimer: ReturnType<typeof setTimeout> | null = null;
    let lastX = 0;
    let startTime = 0;
    let movedBy = 0;
    let timeDelta = 0;
    let pausedByDrag = false;
    let lastTapAt = 0;

    function scheduleHide(): void {
        if (hideTimer) clearTimeout(hideTimer);

        hideTimer = setTimeout(() => {
            controlsVisible = false;
        }, HIDE_DELAY);
    }

    function showControls(): void {
        controlsVisible = true;
        scheduleHide();
    }

    function onPointerDown(event: PointerEvent): void {
        // 全屏锁定（类 B 站）期间禁用左右拖动 seek，避免跟打时误触
        if (locked) return;

        lastX = event.clientX;
        startTime = currentTime;
        movedBy = 0;
        pausedByDrag = false;
        dragging = true;

        // 只按下不暂停：暂停留给"真的开始左右拖"和双击
        showControls();
    }

    const clamp = (x: number, l: number, r: number) => Math.min(r, Math.max(l, x))

    function onPointerMove(event: PointerEvent): void {
        if (!dragging || !playerBox) return;

        const dx = event.clientX - lastX;
        lastX = event.clientX;

        // 真的开始拖了才暂停
        if (!pausedByDrag) {
            pause();
            pausedByDrag = true;
        }

        movedBy = dx;

        const relY = event.offsetY / playerBox.clientHeight;
        const rate = relY > 0.33 ? 1 : 0.25;

        // 整宽 = 整首时长（B 站那种手感）
        const span = total || 30;
        const scale = span / Math.max(playerBox.clientWidth, 1);
        timeDelta += dx * scale * rate;
        const next = clamp(startTime + timeDelta, 0, (chart?.duration ?? 30));

        seek(next);
        showControls();


        seekHint = `${timeDelta >= 0 ? "+" : ""}${timeDelta.toFixed(1)}s (x${rate}) ${format(next)}`;
    }

    function onPointerUp(): void {
        if (!dragging) return;

        dragging = false;
        seekHint = "";
        timeDelta = 0;

        if (Math.abs(movedBy) < 4) {
            const now = Date.now();

            if (now - lastTapAt < DOUBLE_TAP_MS) {
                togglePlay();
                showControls();
            } else if (controlsVisible) {
                scheduleHide();
            } else {
                showControls();
            }

            lastTapAt = now;

            return;
        }

        showControls();
    }

    function onProgressInput(event: Event): void {
        event.stopPropagation();
        seek(Number((event.target as HTMLInputElement).value));
        showControls();
    }

    function onTogglePlay(event: MouseEvent): void {
        event.stopPropagation();
        togglePlay();
        showControls();
    }

    function onToggleFullscreen(event: MouseEvent): void {
        event.stopPropagation();
        showControls();

        if (document.fullscreenElement) void document.exitFullscreen();
        else void playerBox?.requestFullscreen?.();
    }

    function onFullscreenChange(): void {
        const isFullscreen = !!document.fullscreenElement;

        fullscreen = isFullscreen;
        aspect = isFullscreen ? 16 / 9 : 3 / 2;

        // 退出全屏时解除锁定，免得回来还是"什么都没了"
        if (!isFullscreen) locked = false;

        requestAnimationFrame(() => player?.useNewAspect());

        try {
            if (isFullscreen) void screen.orientation?.lock?.("landscape");
            else screen.orientation?.unlock?.();
        } catch {
            // 桌面浏览器 / 部分 WebView 不支持锁方向
        }
    }

    /**
     * 把播放器时间直接写到 DOM 上（**不走响应式**）。
     * 桌面端也是 `progressBar.value = audio.currentTime` 这么写的。
     */
    function syncProgress(): void {
        if (!player) return;

        const now = player.time;

        currentTime = now;

        // 用户正在拖进度条时**不要**回写 value：每帧覆盖会让滑块被拽回原处，
        // 表现为"拖不动、要等它一下"。松手（pointerup/change）之后自然恢复跟随。
        if (progressEl && !progressDragging) progressEl.value = String(now);
    }

    /** 正在拖进度条（普通变量即可：只在 syncProgress 里读，不需要触发渲染） */
    let progressDragging = false;

    function beginProgressDrag(): void {
        progressDragging = true;
    }

    function endProgressDrag(): void {
        progressDragging = false;
    }

    //#region 操作栈（只读）
    /** 切到操作栈 tab 时 +1，让下面的 `$node` 重算 */
    let opsTick = $state(0);

    interface OpsRow {
        key: string;
        kind: "op" | "sep";
        text: string;
        undone: boolean;
    }

    const opsRows = $node({
        get: () => {
            // 读一下，建立依赖
            opsTick;

            const rows: OpsRow[] = [];
            const list = operationList;

            if (!list) return rows;

            const undone = [...list.undoneOperations].reverse();
            const done = [...list.operations];

            undone.forEach((operation, index) => {
                rows.push({
                    key: `u${index}`,
                    kind: "op",
                    text: `${operation.constructor.name} · 已撤销`,
                    undone: true
                });
            });

            if (undone.length > 0 && done.length > 0) {
                rows.push({ key: "sep", kind: "sep", text: "", undone: false });
            }

            done.forEach((operation, index) => {
                rows.push({ key: `d${index}`, kind: "op", text: operation.constructor.name, undone: false });
            });

            return rows;
        }
    });
    //#endregion

    //#region 播放速率 / 撤销重做 / 全屏锁定
    /** 固定档位，不做连续可调（连续微调在手机上很难点准） */
    const PLAYBACK_RATES = [0.5, 0.75, 1, 1.25, 1.5];
    let playbackRate = $state(1);

    /** 全屏锁定（类 B 站）：点一下锁定，长按解锁 */
    let locked = $state(false);
    let fullscreen = $state(false);
    let unlockTimer: ReturnType<typeof setTimeout> | null = null;
    /** 正在按住解锁（用来跑进度环） */
    let unlocking = $state(false);


    function cycleRate(): void {
        const index = PLAYBACK_RATES.indexOf(playbackRate);
        const next = PLAYBACK_RATES[(index + 1) % PLAYBACK_RATES.length];

        playbackRate = next;

        if (player) player.audio.playbackRate = next;
    }

    function undo(): void {
        operationList?.undo();
    }

    function redo(): void {
        operationList?.redo();
    }

    /** 点一下锁定；长按（600ms）解锁 —— 避免跟打时误触解锁 */
    function onLockDown(): void {
        if (unlockTimer) clearTimeout(unlockTimer);

        if (!locked) {
            locked = true;

            return;
        }

        // 已锁定：按住开始走"解锁进度环"，600ms 走满才解开
        unlocking = true;

        unlockTimer = setTimeout(() => {
            locked = false;
            unlocking = false;
            unlockTimer = null;
        }, 600);
    }

    function onLockUp(): void {
        // 中途松手：进度环收回，保持锁定
        unlocking = false;

        if (unlockTimer) {
            clearTimeout(unlockTimer);
            unlockTimer = null;
        }
    }
    //#endregion

    function format(seconds: number): string {
        const value = Math.max(0, seconds || 0);
        const minutes = Math.floor(value / 60);
        const rest = Math.floor(value % 60);
        const millis = Math.floor((value - Math.floor(value)) * 1000);

        return `${minutes}:${rest.toString().padStart(2, "0")}.${millis.toString().padStart(3, "0")}`;
    }
// #endregion

// #region 页面导航
    function pick(id: MobileTab): void {
        // 操作栈是只读快照：切过去时重新算一次
        opsTick += 1;

        const next = Math.max(0, tabs.findIndex((item) => item.id === id));

        if (next === tabIndex) return;

        const from = tabIndex;

        tabIndex = next;
        activeTab = id;

        requestAnimationFrame(() => {
            const element = pageTrack;

            if (element) {
                element.style.transform = `translateX(${-next * 100}%)`;
                // 用 WAAPI 而不是 CSS transition：不依赖元素是否被重建
                element.animate(
                    [
                        { transform: `translateX(${-from * 100}%)` },
                        { transform: `translateX(${-next * 100}%)` }
                    ],
                    { duration: 240, easing: "cubic-bezier(0.22, 0.61, 0.36, 1)" }
                );
            }

            drawActiveEditor();
        });
    }

    function back(): void {
        if (chart?.modified && !confirm("当前谱面有未保存的更改，确定返回吗？")) return;

        navigate("/");
    }

    /**
     * 左上角那个 ‹ 的语义随状态变：
     *   · 全屏时 = **退出全屏**（不是退出谱面）；
     *   · 非全屏时 = 退出谱面。
     */
    function onBack(): void {
        if (document.fullscreenElement) {
            void document.exitFullscreen?.();

            return;
        }

        back();
    }
    //#endregion
</script>

<script onmount>
    document.addEventListener("fullscreenchange", onFullscreenChange);

    // 有未保存改动时，关窗口 / 刷新让浏览器弹它自己的确认框。
    // 别把回调命名成 `guard`：编译器 dev 下会插 `guard(...)`，同名局部变量会遮住它。
    const warnBeforeUnload = (event: BeforeUnloadEvent) => {
        if (!chart?.modified) return;

        event.preventDefault();
        event.returnValue = "";
    };

    window.addEventListener("beforeunload", warnBeforeUnload);

    (async () => {
        try {
            await loadChart(route.get().params.id ?? null);

            total = chart?.duration ?? 0;

            // 先渲染出画布，量到尺寸之后再建编辑器和播放器
            ready = true;
            await new Promise((resolve) => requestAnimationFrame(resolve));

            await bootEditors();

            selectedLineId.subscribe(() => syncEditorTargets());

            await bootPlayer();
        } catch (error) {
            loadError = error instanceof Error ? error.message : String(error);
            ready = true;
        }
    })();
</script>

<main class="app">
    <!--
        页面主体**不**用 `{#if ready}` 挡：播放器和两块画布必须在挂载时就存在，
        `onmount` 里才有 `bind:this` 的引用去建实例。列表的数据靠
        `chartLoaded` 这个信号刷新（见 JudgeLineList）。
    -->
    <!-- 播放器：和桌面端一样，逻辑分辨率按 900 高算，CSS 只负责缩放 -->
    <section
        class="player"
        bind:this={playerBox}
        style="aspect-ratio: {aspect}"
        onpointerdown={onPointerDown}
        onpointermove={onPointerMove}
        onpointerup={onPointerUp}
        onpointercancel={onPointerUp}
        onpointerleave={onPointerUp}
    >
        <canvas class="player-canvas" bind:this={playerCanvas} width={playerWidth} height={BASE_HEIGHT}></canvas>

        {#if dragging && seekHint !== ""}
            <div class="seek-hint">{seekHint}</div>
        {/if}

        <!-- 速率 / 撤销重做：右上角，和控制条同一显现周期（不常驻，防误触）；全屏时隐藏 -->
        {#if !fullscreen}
            <div class="top-controls {controlsVisible && !locked ? "visible" : ""}">
                <button class="ctrl small" onclick={cycleRate}>{playbackRate}x</button>
                <button class="ctrl small" onclick={undo} aria-label="撤销">↶</button>
                <button class="ctrl small" onclick={redo} aria-label="重做">↷</button>
            </div>
        {/if}

        <!-- 全屏锁定：锁定时除了它自己什么都不显示，长按解锁 -->
        {#if fullscreen}
            <button
                class="lock {locked ? "locked" : ""} {unlocking ? "holding" : ""}"
                onpointerdown={onLockDown}
                onpointerup={onLockUp}
                onpointercancel={onLockUp}
                onpointerleave={onLockUp}
                aria-label={locked ? "解锁" : "锁定"}
            >
                <!--
                    两个图标都常驻，靠按钮的 `.locked` 类切换显隐。

                    （历史坑：早先这里写过 `{#if locked}` 两个分支、也写过 `d={…}`，
                    都"点了没反应"。真正的原因是**事件处理器里有 early return**，
                    编译器把刷新语句拼在函数末尾，落在 `return` 后面成了死代码
                    —— 已在 grain 编译器中修复，跟 SVG / 分支 无关。）
                -->
                <svg
                    class="lock-icon lock-open"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                </svg>
                <svg
                    class="lock-icon lock-closed"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>

                <!-- 按住解锁时绕一圈的进度环（`.holding` 只在按住时加，锁定时才可能按住） -->
                <svg class="lock-ring" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="16"></circle>
                </svg>
            </button>
        {/if}

        <div class="controls {controlsVisible && !locked ? "visible" : ""}">
            <button class="ctrl" onclick={onTogglePlay}>{playing ? "❚❚" : "▶"}</button>

            <!-- 进度与时间由 `drawn` 回调直接写 DOM -->
            <input
                class="progress"
                bind:this={progressEl}
                type="range"
                min="0"
                max={total || 30}
                step="0.01"
                oninput={onProgressInput}
                onpointerdown={beginProgressDrag}
                onpointerup={endProgressDrag}
                onpointercancel={endProgressDrag}
                onclick={(event) => event.stopPropagation()}
            />

            <span class="time">{format(currentTime)}</span>

            <button class="ctrl" onclick={onToggleFullscreen}>⛶</button>
        </div>

        <!-- 返回按钮和控制条同一个显现周期 -->
        <button
            class="back {controlsVisible ? "visible" : ""}"
            onclick={onBack}
            aria-label={fullscreen ? "退出全屏" : "返回"}
        >‹</button>

        {#if !ready}
            <div class="placeholder">{#if loadError}打开谱面失败：{loadError}{:else}正在打开谱面…{/if}</div>
        {:else if playerError}
            <div class="placeholder err">播放器初始化失败：{playerError}</div>
        {/if}
    </section>

    <nav class="tabs">
        {#for item of tabs with key = item}
            <button class="tab {item.id === activeTab ? "active" : ""}" onclick={() => pick(item.id)}>
                {item.label}
            </button>
        {/for}
    </nav>

    <!-- 三块内容始终存活：切页只平移轨道 + 切 visibility，不销毁 DOM -->
    <section class="content">
        <div class="track" bind:this={pageTrack} style="transform: translateX({-tabIndex * 100}%)">
            <!-- 列表页**不加** flex 居中：那会把 .list 挤成内容宽度 -->
            <div class="slide {tabIndex === 0 ? "active" : ""}">
                <JudgeLineList></JudgeLineList>
            </div>

            <div class="slide center {tabIndex === 1 ? "active" : ""}">
                <canvas class="editor-canvas" bind:this={notesCanvas}></canvas>
            </div>

            <div class="slide center {tabIndex === 2 ? "active" : ""}">
                <canvas class="editor-canvas" bind:this={eventsCanvas}></canvas>
            </div>

            <div class="slide {tabIndex === 3 ? "active" : ""}">
                <div class="ops">
                    {#for row of opsRows with key = row.key}
                        {#if row.kind === "sep"}
                            <div class="op-sep"></div>
                        {:else}
                            <div class="op {row.undone ? "undone" : ""}">{row.text}</div>
                        {/if}
                    {/for}
                </div>
            </div>
        </div>
    </section>
</main>

<style>
.app {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    margin: 0;
    overflow: hidden;
}

/* ---------- 播放器 ---------- */
.player {
    position: relative;
    flex: none;
    width: 100%;
    aspect-ratio: 3 / 2;
    padding: 0;
    margin: 0;
    background: #000;
    overflow: hidden;
    touch-action: none;
    border-radius: 0;
}

/* 全屏时铺满整块屏幕（此时宽高比已被切成 16:9） */
.player:fullscreen {
    width: 100vw;
    height: 100vh;
}

.player-canvas {
    width: 100%;
    height: 100%;
    display: block;
}

.placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    text-align: center;
    color: #bbb;
    font-size: 13px;
    background: #000;
}

.placeholder.err {
    color: #ff8080;
}

.center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    text-align: center;
    color: var(--text-dim);
    font-size: 14px;
}

.seek-hint {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 6px 12px;
    border-radius: 6px;
    background: var(--overlay);
    color: var(--text);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
}

.controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    pointer-events: none;
}

.controls.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

.ctrl {
    border: none;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    font-size: 14px;
}

.progress {
    flex: 1;
    height: 4px;
    accent-color: var(--accent);
    min-width: 0;
}

.ops {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 10px 14px;
}

.op {
    padding: 6px 0;
    font-size: 13px;
    color: var(--text);
}

.op.undone {
    color: var(--text-dim);
    text-decoration: line-through;
}

/* 已撤销 / 已做 之间的分界 */
.op-sep {
    margin: 8px 0;
    border-top: 1px dashed var(--border);
}

.top-controls {
    position: absolute;
    right: 8px;
    top: calc(8px + env(safe-area-inset-top));
    display: flex;
    gap: 6px;
    z-index: 11;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
}

.top-controls.visible {
    opacity: 1;
    pointer-events: auto;
}

.ctrl.small {
    width: 34px;
    height: 34px;
    font-size: 12px;
}

/* 全屏锁定：锁上之后只剩它自己 */
.lock {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.42);
    color: #fff;
    font-size: 18px;
    z-index: 12;
    opacity: 0.45;
    transition: opacity 0.18s ease;
}

.lock.locked {
    opacity: 0.28;
}

/* 图标本体：锁 / 开锁 */
.lock {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.lock-icon {
    width: 20px;
    height: 20px;
}

/* 两个图标叠在同一格，按 `.locked` 切换显隐（只依赖 class，不依赖属性刷新） */
.lock-closed {
    display: none;
}

.lock.locked .lock-open {
    display: none;
}

.lock.locked .lock-closed {
    display: block;
}

/*
 * 解锁进度环：按住 600ms 走满一圈（时钟感），边框本身是圆的，
 * 环从 12 点方向顺时针推进。
 */
.lock-ring {
    position: absolute;
    inset: 3px;
    width: calc(100% - 6px);
    height: calc(100% - 6px);
    transform: rotate(-90deg);
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    pointer-events: none;
}

.lock.holding .lock-ring {
    opacity: 1;
    animation: lock-ring 600ms linear forwards;
}

.lock.holding {
    opacity: 0.85;
}

@keyframes lock-ring {
    to {
        stroke-dashoffset: 0;
    }
}

.time {
    color: #fff;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    width: 5em;
    flex: none;
}

/* 返回按钮：跟控制条同显现周期 */
.back {
    position: absolute;
    left: 8px;
    top: calc(8px + env(safe-area-inset-top));
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.42);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
}

.back.visible {
    opacity: 1;
    pointer-events: auto;
}

/* ---------- 标签栏 ---------- */
.tabs {
    display: flex;
    flex: none;
    padding: 0;
    margin: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
}

.tab {
    flex: 1;
    border: none;
    border-radius: 0;
    background: none;
    padding: 10px 4px;
    font-size: 13px;
    color: var(--text-dim);
}

.tab.active {
    color: var(--accent);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
}

/* ---------- 内容区 ---------- */
.content {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

.track {
    display: flex;
    height: 100%;
    width: 100%;
    transition: transform 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
}

.slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    /* 非当前页 visibility: hidden（不是移除 DOM），滑完再隐藏 */
    visibility: hidden;
    transition: visibility 0s linear 0.24s;
}

/* 只有画布页需要居中；列表页要铺满，不能改成 flex */
.slide.center {
    display: flex;
    align-items: center;
    justify-content: center;
}

.slide.active {
    visibility: visible;
    transition-delay: 0s;
}

.editor-canvas {
    display: block;
    border: none;
    border-radius: 0;
    background: var(--surface);
    touch-action: none;
}
</style>
