<script>
    /*
     * 移动端编辑器页：播放器 + 标签栏 + 两块画布，全部内联。
     *
     * 跟桌面端 `routes/charts/[id]/+page.grain` 的组织方式一致 —— 只有真正
     * 会被别处复用的 `JudgeLineList` 拆成组件，其余不留组件边界：
     * 这些 DOM / 状态 / 生命周期只服务这一个页面。
     */
    import { navigate, route } from "@graints/runtime";

    import { EventSequenceEditors, NotesEditor } from "@kpa/canvas";
    // 面板拆出去之后，页面只剩"打开哪个对象"，用不到操作类
    import { KPAError, type Note } from "kipphi";
    import {
        AudioProcessor,
        Images,
        Player,
        Respack,
        setWasmPath,
        VideoFrameSource,
        type EffectShader
    } from "kipphi-player";
    import { fetchTexture, _ReturnType } from "@kpa/shared/background/tauri";

    import NumField from "#/components/NumField.grain";
    import Segmented from "#/components/Segmented.grain";
    import TextField from "#/components/TextField.grain";
    import Switch from "#/components/Switch.grain";

    import JudgeLineList from "./JudgeLineList.grain";
    import EventSheet from "./EventSheet.grain";
    import JudgeLineSheet from "./JudgeLineSheet.grain";
    import MacroSheet from "./MacroSheet.grain";
    import MultiNodeSheet from "./MultiNodeSheet.grain";
    import MultiNoteSheet from "./MultiNoteSheet.grain";
    import NoteSheet from "./NoteSheet.grain";
    import SheetShell from "./SheetShell.grain";

    import { resolveSeekTarget } from "#/playback";
    import { theme } from "#/theme";
    import { startAutoSave, stopAutoSave } from "#/save";
    import {
        chart,
        chartId,
        editingLineId,
        illustration,
        lineOf,
        loadChart,
        musicUrl,
        operationList,
        refreshAll,
        selectedLineId,
        setPlayer
    } from "#/store";
    import { readDefaultRespackFile } from "#/tauri";
import { _i18n } from "#/i18n";

    //#region 页面状态
    type MobileTab =
        | "lines"
        | "notes"
        | "events"
        | "ops"
        | "errors"
        | "settings"
        | "chart";

    /*
     * 取词函数从 store 读：换语言时 store 换新函数，模板里所有 `_("...")`
     * 跟着重算（和 svelte-i18n 的 `$_` 一个路子）。
     *
     * 必须手写 `get`：`$read` 只生成 `listen`，它的 `get` 读的是**最近一次
     * 推送**的值，首次渲染前还没推送过 —— `let _` 会是 `undefined`。
     */
    let _ = $node({
        get: () => _i18n.get(),
        listen: (update: (fn: unknown) => void) => _i18n.subscribe(update),
    });

    /*
     * 标签只存**键名**，文案在模板里用 `_(item.label)` 取 —— 那样换语言时
     * 会跟着重算。
     */
    const tabs: Array<{ id: MobileTab; label: string }> = [
        { id: "lines", label: "mobile.tabs.lines" },
        { id: "notes", label: "mobile.tabs.notes" },
        { id: "events", label: "mobile.tabs.events" },
        // 只读的操作栈：已撤销的在上面，用虚线跟已做的分开
        { id: "ops", label: "mobile.tabs.ops" },
        // 解析时收集到的警告（`KPAError.buffer`）
        { id: "errors", label: "mobile.tabs.errors" },
        // 画布设置：拍数分母 / 视野跨度 / 网格密度 / NNN 参考线
        { id: "settings", label: "mobile.tabs.settings" },
        // 谱面信息：曲名 / 难度 / 作曲 / 谱师 / 曲绘 / 偏移
        { id: "chart", label: "mobile.tabs.chart" }
    ];

    let activeTab = $state<MobileTab>("lines");
    let tabIndex = $state(0);

    /** 解析 / 自愈过程中收集到的警告（`KPAError.buffer` 的快照） */
    let chartErrors = $state<Array<{ message: string; fixed: boolean }>>([]);
    /** 底部提示条：解析出错时提示"去看错误页" */
    let notices = $state<Array<{ id: number; message: string; type: "info" | "error" }>>([]);
    let noticeSeq = 0;

    /**
     * 弹一条提示，几秒后自己消失。
     *
     * 移动端不方便开控制台，这是唯一的反馈渠道 —— 和桌面端的 `notify()`
     * 是同一套语义（只是没有那边的通知中心）。
     */
    function notify(message: string, type: "info" | "error" = "info"): void {
        noticeSeq += 1;

        const id = noticeSeq;

        notices = [...notices, { id, message, type }];

        // 几秒后自己消失
        setTimeout(() => {
            notices = notices.filter((item) => item.id !== id);
        }, 5000);
    }

    /** 把 `KPAError.buffer` 里的东西同步到错误页 */
    function refreshChartErrors(): void {
        chartErrors = KPAError.buffer.map((error) => ({
            message: error.message,
            fixed: error.fixed
        }));
    }

    let ready = $state(false);
    /** 未捕获异常（显示在屏幕底部，见 `<script onmount>` 里的监听） */
    let runtimeError = $state<string | null>(null);
    let loadError = $state<string | null>(null);

    let playerReady = $state(false);
    let playerError = $state<string | null>(null);
    let playing = $state(false);

    let currentTime = $state(0);
    let total = $state(0);

    let controlsVisible = $state(false);
    let dragging = $state(false);
    let seekHint = $state("");

    /** 判定线列表状态刷新的节流时刻 */
    let lastTickAt = 0;

    /** 竖屏 3:2；全屏时强制 16:9（并尝试锁横屏） */
    let aspect = $state(3 / 2);
    //#endregion

    //#region 引用与实例
    let playerCanvas: HTMLCanvasElement;
    let notesCanvas: HTMLCanvasElement;
    let eventsCanvas: HTMLCanvasElement;
    let playerBox: HTMLElement;
    let pageTrack: HTMLDivElement;
    let progressEl: HTMLInputElement;

    let player: Player | null = null;
    let notesEditor: NotesEditor | null = null;
    let eventEditors: EventSequenceEditors | null = null;
    //#endregion

    /**
     * 播放器画布用固定逻辑分辨率（高 900，宽 = 高 × 宽高比），CSS 只负责缩放。
     * 画布编辑器则是桌面端那套写死的 600×900。
     */
    const BASE_HEIGHT = 900;

    const playerWidth = $node({ get: () => Math.round(aspect * BASE_HEIGHT) });

    /** 静态资源（跟桌面端同一批，在仓库根的 static/ 里） */
    const ASSETS = {
        tap: "/Tap.wav",
        drag: "/Drag.wav",
        flick: "/Flick.wav",
        anchorImg: "/Anchor.png",
        belowImg: "/Below.png",
        selectNoteImg: "/selectNote.png",
        startNodeImg: "/South.png",
        endNodeImg: "/North.png"
    } as const;

    //#region 资源初始化
    /** 默认 respack：Tauri 读 resource，浏览器退回 fetch */
    const respackPromise: Promise<Respack | null> = (async () => {
        try {
            return await Respack.loadFromPhira(async (filename) => {
                if (filename.endsWith(".ogg")) return null;

                return await readDefaultRespackFile(filename);
            });
        } catch (error) {
            return null;
        }
    })();

    /**
     * 锚点 / 多押 / 编辑器用的那些小图。
     * `Player.renderLine` 会 `drawImage(Images.ANCHOR)`，两个画布编辑器也要这些图。
     */
    const imagesPromise: Promise<void> = (async () => {
        await Images.loadAndOptimize({ anchor: ASSETS.anchorImg, below: ASSETS.belowImg });
        await Images.initImagesForEditor({
            selectNote: ASSETS.selectNoteImg,
            startNode: ASSETS.startNodeImg,
            endNode: ASSETS.endNodeImg
        });
    })();

    /** respack 里没有打击音效时退回静态资源里的 wav */
    async function audioProcessorOf(respack: Respack): Promise<AudioProcessor> {
        if (respack.TAP_SE && respack.DRAG_SE && respack.FLICK_SE) {
            return AudioProcessor.fromRespack(respack);
        }

        const processor = new AudioProcessor();

        await processor.init({ tap: ASSETS.tap, drag: ASSETS.drag, flick: ASSETS.flick });

        return processor;
    }

    /** 视频：贴图接口拿 blob，再包成 `VideoFrameSource` */
    async function fetchVideo(id: string, name: string) {
        const blob = await fetchTexture(id, name, _ReturnType.blob);

        const file = new File([blob], "file.mp4", { type: blob.type, lastModified: Date.now() });

        return await VideoFrameSource.from(file, { bufferSize: 6 });
    }

    /** 着色器：读出源码，包成 `EffectShader` */
    async function fetchShader(id: string, name: string): Promise<EffectShader> {
        const bytes = await fetchTexture(id, name, _ReturnType.u8);

        return { glsl: new TextDecoder().decode(bytes), name };
    }

    /**
     * 播放器背景。没有曲绘就用一张深灰画布顶上。
     *
     * 兜底不能走 `createImageBitmap(canvas)` —— 这个 WebView 里拿到的不是合法
     * ImageBitmap，`Player` 构造时 `drawImage` 会抛类型错误，连 Canvas 2D 回退都建不起来。
     */
    function backgroundOf(): ImageBitmap {
        if (illustration && illustration instanceof ImageBitmap) return illustration;

        const canvas = document.createElement("canvas");

        canvas.width = 16;
        canvas.height = 16;

        const context = canvas.getContext("2d");

        if (context) {
            context.fillStyle = "#101318";
            context.fillRect(0, 0, 16, 16);
        }

        return canvas as unknown as ImageBitmap;
    }
    //#endregion

    //#region 播放器
    async function bootPlayer(): Promise<void> {
        try {
            // 抓成局部：`chart` 是 live binding，await 之后不再收窄
            const target = chart;

            if (!target) throw new Error("谱面还没加载");

            setWasmPath(new URL("/web-demuxer.wasm", window.location.origin).href);

            const respack = await respackPromise;

            if (!respack) throw new Error("respack 没有加载成功");

            const audio = musicUrl ? new Audio(musicUrl) : new Audio();

            await imagesPromise;

            player = await Player.create(
                playerCanvas,
                await audioProcessorOf(respack),
                audio,
                backgroundOf(),
                respack,
                { renderer: "webgl1" }
            );
            player.hitEffectNoFollows = true;
            // 面板要直接改 player.textureMapping（换贴图立刻生效）
            setPlayer(player);

            // 贴图 / 视频 / 着色器都从谱面目录读
            if (chartId) {
                const id = chartId;

                player.use({
                    texture: (name) => fetchTexture(id, name),
                    video: (name) => fetchVideo(id, name),
                    shader: (name) => fetchShader(id, name.startsWith("/") ? name.slice(1) : name)
                });
            }

            // 必须走 `receive`：设 chart + 初始化 lastUnplayedNNNode + 同步资源 + warmup
            await player.receive(target);

            // 桌面端同一个钩子：播放器每画完一帧，编辑器跟着画、UI 直接写 DOM
            player.addEventListener("drawn", () => {
                if (!player) return;
                

                drawEditors(player.renderingBeats);
                syncProgress();

                // 判定线列表的状态（x/y/θ/α/速度）也要跟着动。
                // 这里只**刷新数值**（桌面端 `drawn` 里调的也是 refresh）；
                // 结构重建走 `needsreflow` → `reflowAll()`。移动端再节流到 ~10Hz。
                const now = performance.now();

                // 只在**判定线列表可见**时才刷新它 —— 不可见时刷新等于白算。
                if (activeTab === "lines" && now - lastTickAt > 100) {
                    lastTickAt = now;

                    // 进度文字是模板里的 `{format(currentTime)}`，得喂响应式；
                    // 每帧写会把整页重算，所以跟着这个 10Hz 的节流一起更新
                    currentTime = player.time;
                    refreshAll();
                }
            });

            const ops = operationList;

            if (ops) {
                player.watch(ops);
            }

            /*
             * 自动保存走固定间隔（和桌面端一样），**不要**挂在每个操作上：
             * 那样操作间隔超过去抖时间时，每个操作都会生成一个历史版本，
             * 磁盘很快撑满。
             */
            startAutoSave();

            if (!musicUrl) player.offlineTime = 0;

            // 倍速：有音源改 playbackRate；无音源时 ticker 里按倍速推进 offlineTime
            player.audio.playbackRate = playbackRate;

            total = target.duration ?? 0;
            playerReady = true;
            ready = true;

            startClock();
            syncProgress();
            drawEditors(player.renderingBeats);
        } catch (error) {
            playerError = `${error instanceof Error ? error.message : String(error)}（曲绘：${
                illustration === null ? "null" : (illustration as unknown as object)?.constructor?.name ?? "?"
            }）`;
            ready = true;
        }
    }

    /**
     * 只有**没有音源**（示例谱面）时才需要自己推进时间；
     * 有音源时播放器自己有渲染循环。
     */
    function startClock(): void {
        if (musicUrl) return;

        let last = 0;

        const step = (now: number) => {
            if (player && playing) {
                const delta = last ? (now - last) / 1000 : 0;

                player.offlineTime = (player.offlineTime ?? 0) + delta * playbackRate;
                player.render();
            }

            last = now;
            requestAnimationFrame(step);
        };

        requestAnimationFrame(step);
    }

    function pause(): void {
        if (!player) return;

        player.pause();
        playing = false;
    }

    function togglePlay(): void {
        if (!player) return;

        if (playing) {
            pause();

            return;
        }

        player.play();
        playing = true;
    }

    /** 待应用的 seek 目标（拖动进度条时会有很多次 input，只保留最后一次） */
    let pendingSeek: number | null = null;
    /** 已经排队的那一帧（0 = 没排） */
    let seekFrame = 0;

    /**
     * 跳转（会**合并**同一帧内的多次请求）。
     *
     * 之前每个 `input` 事件都直接改 `audio.currentTime` 并排一个 rAF 去 `render()`：
     * 快速拖动时几十个 rAF 排在一起，每个都整张画布重画 + 派发 `drawn`
     * （`drawn` 里还有 drawEditors / syncProgress / refreshAll），
     * 主线程被塞满 —— 表现就是"卡一下才跟得上手指"。
     *
     * 现在只记下最后的目标，一帧只应用一次、只 render 一次。
     */
    function seek(time: number): void {
        pendingSeek = time;

        if (seekFrame) return;

        seekFrame = requestAnimationFrame(() => {
            seekFrame = 0;

            const target = pendingSeek;

            pendingSeek = null;

            if (target !== null) applySeek(target);
        });
    }

    function applySeek(time: number): void {
        if (!player) return;

        const next = Math.max(0, total > 0 ? Math.min(time, total) : time);

        // `player.time` 只有 getter，跳转要写底层并做同样的偏移换算
        const offset = (player.chart?.offset ?? 0) / 1000 - (player.baseOffset ?? 0);
        const raw = next + offset;

        if (musicUrl) player.audio.currentTime = raw;
        else player.offlineTime = raw;

        currentTime = next;

        // 已经在 rAF 里了，直接渲染：`render()` 自己会派发 `drawn`，
        // 那边的回调会负责画编辑器和同步进度
        void player.render();
    }
    //#endregion

    //#region 画布编辑器
    /**
     * 画布的**逻辑尺寸按面板实际大小来**（位图 = 显示尺寸，1:1）。
     *
     * 桌面端能用死 600×900，因为它的画布就是按 600×900 显示的；
     * 手机上如果还按 600×900 建位图再缩小显示，线条和文字会被重采样得发虚。
     * 编辑器内部只按 `clippingRect` 排版，给多少就按多少算，所以直接给实际尺寸。
     */
    function fitEditorCanvas(canvas: HTMLCanvasElement): [number, number, number, number] {
        const pane = canvas.parentElement;

        const width = Math.max(200, Math.floor(pane?.clientWidth || canvas.clientWidth || 360));
        const height = Math.max(240, Math.floor(pane?.clientHeight || canvas.clientHeight || 540));

        canvas.width = width;
        canvas.height = height;
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        return [0, 0, width, height];
    }

    /**
     * 把拍数喂给**当前可见**的那个画布编辑器。
     *
     * 桌面端在 `drawn` 里两个都画，因为它的两块画布都小；移动端一块画布就占满
     * 整页，另一块在 `visibility: hidden` 后面，画了也看不见 —— 那是最纯粹的浪费。
     * 切页时会 `drawActiveEditor()` 补一次，所以不会被落下。
     */
    function drawEditors(beats: number): void {
        if (!player || !Number.isFinite(beats)) return;
        if (!lineOf(selectedLineId.get())) return;

        if (activeTab === "notes") notesEditor?.draw(beats);
        else if (activeTab === "events") eventEditors?.draw(beats);
    }

    /**
     * 编辑器里滚轮/拖动滑时间 → 播放器跟着 seek。
     *
     * 编辑器只负责算出"要跳多少拍"，真正的跳转在这里做：
     * `player.renderingBeats` 的 setter 会把拍数换算成秒并写 `audio.currentTime`。
     */
    function onTimeScroll(event: Event): void {
        if (!player) return;

        const delta = (event as Event & { deltaBeats?: number }).deltaBeats ?? 0;
        /*
         * 目标拍数由 `resolveSeekTarget` 算（`NaN` 基准、零位移都返回 null）。
         *
         * 这条以前是内联的，踩过"进度条第二次才跟随拖动"：播放器还没画出第一帧
         * 时 `renderingBeats` 是 NaN，直接相加会把 `audio.currentTime` 写成 NaN。
         * 抽成纯函数之后有单测兜着。
         */
        const target = resolveSeekTarget(player.renderingBeats, delta);

        if (target === null) return;

        player.renderingBeats = target;

        // 暂停时没有播放循环 —— 只改 audio.currentTime 不会重绘，
        // 得手动 render 一次，`drawn` 才会把编辑器带到新位置
        void player.render();
    }

    /** 切页之后补一次（那一页在后台期间不跟着重绘） */
    function drawActiveEditor(): void {
        if (!player) return;

        drawEditors(player.renderingBeats);
    }

    /**
     * 谱面变动 → 重画播放器 + 当前画布。
     *
     * 播放器渲染会派发 `drawn`（那里也会画编辑器），但那是"播放链路"的副作用；
     * 暂停时也可能不触发，所以这里显式补一次，保证改完立刻能看到。
     */
    function onOperationsChanged(): void {
        if (!player) return;

        void player.render();
        drawActiveEditor();
    }

    async function bootEditors(): Promise<void> {
        // 先抓成局部变量：`operationList` 是 import 进来的 live binding，
        // `await` 之后 TS 就不再认为它非空了
        const ops = operationList;

        if (!ops) return;

        const respack = await respackPromise;

        await imagesPromise;

        // 编辑器构造时就用 `canvas.clientWidth / clientHeight` 算输入映射的缩放比，
        // 面板还没布局出来（尺寸为 0）的话这个比值会是 0 —— 等一帧再建。
        await new Promise((resolve) => requestAnimationFrame(resolve));

        notesEditor = new NotesEditor(notesCanvas, fitEditorCanvas(notesCanvas), ops, respack as never);
        eventEditors = new EventSequenceEditors(eventsCanvas, fitEditorCanvas(eventsCanvas), ops, 0.5);

        // 编辑器滚轮滑时间 → 播放器 seek
        notesEditor.addEventListener("timescroll", onTimeScroll);
        eventEditors.addEventListener("timescroll", onTimeScroll);

        // 画布上的「详细信息」→ 弹底部面板
        notesEditor.addEventListener("inspect", openNoteSheet);
        eventEditors.addEventListener("inspect", openNodeSheet);

        // 画布里的判定线切换按钮 → 页面（`selectedLineId` 的单一数据源在这里）
        const onTargetChange = (event: Event): void => {
            const line = (event as Event & { judgeLine?: { id: number } }).judgeLine;

            if (line) selectedLineId.set(line.id);
        };

        notesEditor.addEventListener("targetchange", onTargetChange);
        // 事件画布的换线按钮同样要回灌到页面
        eventEditors.addEventListener("targetchange", onTargetChange);

        /*
         * 框选结果：只有"批量编辑"入口关心它。
         *
         * 事件画布是多个子编辑器共用一个 canvas，所以要 `addEventListenerForAll`
         * （和桌面端 `+page.grain` 一样）。
         */
        notesEditor.addEventListener("notescopeselected", (event) => {
            multiNotes = [...((event as Event & { notes?: Set<Note> }).notes ?? [])];
        });
        eventEditors.addEventListenerForAll("nodescopeselected", (event) => {
            multiNodes = [...((event as Event & { nodes?: Set<any> }).nodes ?? [])];
        });

        // 画布上那个「批量编辑」按钮（框选组右边、两格宽）→ 开面板
        notesEditor.addEventListener("multiedit", openMultiNote);
        eventEditors.addEventListenerForAll("multiedit", openMultiNode);

        syncEditorTargets();

        // 编辑器刚建好：按当前主题上色（订阅还没触发过）
        applyCanvasTheme(theme.get());

        /*
         * 设置页那几项按当前编辑器同步一次。
         *
         * `divisorValue` 那几个 `$state` 的初值是硬编码默认值，编辑器可能
         * 带着谱面自己的配置（拍数分母等），不同步的话打开设置页显示的是错的。
         */
        divisorValue = notesEditor?.timeDivisor ?? 4;
        timeSpanValue = notesEditor?.timeSpan ?? 4;
        positionSpanValue = notesEditor?.positionSpan ?? 1350;
        gridValue = notesEditor?.positionGridSpan ?? 135;
    }

    /**
     * 按主题给两个画布上底色。
     *
     * 暗色用**中性灰**（`rgb(40,40,40)`），不是原来那个偏蓝的 `#333d`；
     * 亮色跟 `--bg` 保持一致。
     */
    function applyCanvasTheme(name: string): void {
        /*
         * 画布**不做**完整的亮色主题：音符贴图本来就是给深色背景设计的
         * （叠在暗底上才好看），网格和按钮配色也按深色调的。
         *
         * 亮色模式只把底色提亮一点点，其余完全一样。
         */
        const background = name === "dark" ? "#333d" : "#3f4754";

        if (notesEditor) {
            notesEditor.backgroundColor = background;
            notesEditor.draw();
        }

        eventEditors?.setBackgroundColor(background);
    }

    theme.subscribe(applyCanvasTheme);

    //#region 画布设置
    /*
     * 每个设置项下面那排「常用值」。
     *
     * 初始只有预设；用户在上面输入框提交新值就追加进来，最多 8 个，
     * 后来的顶替最早的。值是**数字本身**（`Segmented` 的 `option[0]`），
     * 不是下标 —— 输入框里是自定义值时一个都不高亮。
     */
    const PRESET_LIMIT = 8;

    function remember(list: number[], value: number): number[] {
        if (!Number.isFinite(value) || value <= 0) return list;

        const next = [...list.filter((item) => item !== value), value];

        return next.length > PRESET_LIMIT
            ? next.slice(next.length - PRESET_LIMIT)
            : next;
    }

    const toOptions = (list: number[]): [number, string][] =>
        list.map((value) => [value, `${value}`]);

    let divisorPresets = $state<number[]>([2, 3, 4, 6, 8, 12, 16]);
    let timeSpanPresets = $state<number[]>([1, 2, 4, 8, 16]);
    let positionSpanPresets = $state<number[]>([900, 1350, 1800]);
    let gridPresets = $state<number[]>([45, 90, 135, 270]);

    /*
     * 选项要**派生**，不能在模板里直接 `toOptions(divisorPresets)`。
     *
     * 传进普通函数后编译期追踪不到依赖（`divisorPresets` 只是个参数），
     * 列表变了界面不重建 —— 表现就是"新提交的值没进 Segmented"。
     *
     * 必须写成 `{ get }`，不能写 `$node(() => ...)` —— 简写会把箭头函数
     * 当**表达式**再包一层，`get()` 返回的是函数而不是数组（按钮全没了）。
     */
    const divisorOptions = $node({ get: () => toOptions(divisorPresets) });
    const timeSpanOptions = $node({ get: () => toOptions(timeSpanPresets) });
    const positionSpanOptions = $node({
        get: () => toOptions(positionSpanPresets),
    });
    const gridOptions = $node({ get: () => toOptions(gridPresets) });

    /*
     * 四组「输入框 + 预设」共用的值。
     *
     * 用 `$state` 而不是 `$node`：`$node` 的 setter 在 `bind:` 的 set 表达式
     * 里**不会被改写**（产物只剩 `divisorNode = Number(raw)` 这种普通赋值），
     * `applyXxx` 永远不执行，常用值也就收集不到。`$state` 的赋值会被编译器
     * 正常改写。
     *
     * 初值在 `bootEditors` 末尾按当前编辑器同步。
     */
    let divisorValue = $state(4);
    let timeSpanValue = $state(4);
    let positionSpanValue = $state(1350);
    let gridValue = $state(135);

    /*
     * 这里改的是**编辑器上的字段**，不是谱面数据 —— 不需要走 operationList。
     * 每次改完立刻 `draw()`，`updateMatrix` 会跟着重算。
     */
    function applyTimeDivisor(raw: string): void {
        const value = Number(raw);

        if (!Number.isFinite(value) || value <= 0) return;

        divisorValue = value;
        divisorPresets = remember(divisorPresets, value);

        if (notesEditor) notesEditor.timeDivisor = value;
        if (eventEditors) eventEditors.timeDivisor = value;

        notesEditor?.draw();
        eventEditors?.draw();
    }

    function applyTimeSpan(raw: string): void {
        const value = Number(raw);

        if (!Number.isFinite(value) || value <= 0) return;

        timeSpanValue = value;
        timeSpanPresets = remember(timeSpanPresets, value);

        // 两侧都改：事件画布原来一直是默认跨度，和音符对不上
        if (notesEditor) {
            notesEditor.timeSpan = value;
            notesEditor.draw();
        }

        eventEditors?.setTimeSpan(value);
    }

    function applyPositionSpan(raw: string): void {
        const value = Number(raw);

        if (!Number.isFinite(value) || value <= 0) return;

        positionSpanValue = value;
        positionSpanPresets = remember(positionSpanPresets, value);

        if (!notesEditor) return;

        notesEditor.positionSpan = value;
        notesEditor.draw();
    }

    function applyNoteGrid(raw: string): void {
        const value = Number(raw);

        if (!Number.isFinite(value) || value <= 0) return;

        gridValue = value;
        gridPresets = remember(gridPresets, value);

        if (!notesEditor) return;

        notesEditor.positionGridSpan = value;
        notesEditor.draw();
    }

    function applyEventGrid(raw: string): void {
        const trimmed = raw.trim();

        // 空串 = 回到各事件类型的默认步长
        eventEditors?.setValueGridInterval(
            trimmed === "" ? undefined : Number(trimmed)
        );
    }

    function applyShowsNNN(value: boolean): void {
        if (!notesEditor) return;

        notesEditor.showsNNNListAttachable = value;
        notesEditor.draw();
    }

    /*
 * 谱面信息：改动走 operationList，所以能撤销。
 * 文本字段没变 / 为空就跳过，避免往撤销栈里塞空操作。
 */
function commitChartField(
    prop: "name" | "level" | "composer" | "charter" | "illustrator",
    raw: string,
): void {
    const value = raw.trim();

    if (!chart || !operationList || value.length === 0) return;

    const current = (chart as unknown as Record<string, unknown>)[prop];

    if (current === value) return;

    operationList.do(new Op.ChartPropChangeOperation(chart, prop, value));
}

function commitChartOffset(raw: string): void {
    const value = Number(raw);

    if (!chart || !operationList || !Number.isFinite(value)) return;
    if (chart.offset === value) return;

    operationList.do(new Op.ChartPropChangeOperation(chart, "offset", value));
}

/*
 * 谱面信息的绑定直接写在模板里（`bind:value={get, set}` 字面量）。
 *
 * 不要套 `$node`：它会把 `get` 的结果缓存进变量、只在 `listen` 触发时重算，
 * 而 `chart` 不是 store，没东西可监听 —— 组件创建那一刻求一次值（那时谱面
 * 可能还没加载）就再也不更新，表现是首次打开输入框全空、点一下才有内容。
 */
/*
 * 谱面信息六个字段的节点。
 *
 * \`listen\` 挂在 \`operationList\` 上：它是 EventTarget，do / undo / redo 都发
 * 事件，任何改动都会让 getter 重算。没有 listen 的话 \`$node\` 只在组件创建
 * 时求一次值，那时谱面可能还没加载 —— 输入框全空、点一下才有内容。
 */
function listenChartOps(update: () => void): void {
    if (!operationList) return;

    for (const type of ["do", "undo", "redo"] as const) {
        operationList.addEventListener(type, update);
    }
}

const chartNameNode = $node({
    get: () => chart?.name ?? "",
    set: (value: string) => commitChartField("name", value),
    listen: listenChartOps,
});

const chartLevelNode = $node({
    get: () => chart?.level ?? "",
    set: (value: string) => commitChartField("level", value),
    listen: listenChartOps,
});

const chartComposerNode = $node({
    get: () => chart?.composer ?? "",
    set: (value: string) => commitChartField("composer", value),
    listen: listenChartOps,
});

const chartCharterNode = $node({
    get: () => chart?.charter ?? "",
    set: (value: string) => commitChartField("charter", value),
    listen: listenChartOps,
});

const chartIllustratorNode = $node({
    get: () => chart?.illustrator ?? "",
    set: (value: string) => commitChartField("illustrator", value),
    listen: listenChartOps,
});

const chartOffsetNode = $node({
    get: () => String(chart?.offset ?? 0),
    set: (value: string) => commitChartOffset(value),
    listen: listenChartOps,
});

function applyEdgeScroll(value: boolean): void {
        if (notesEditor) notesEditor.edgeScrollEnabled = value;
        if (eventEditors) eventEditors.edgeScrollEnabled = value;
    }
    //#endregion

    /** 判定线切换时把两个编辑器指过去 */
    function syncEditorTargets(): void {
        const line = lineOf(selectedLineId.get());

        if (!line) return;

        if (notesEditor) notesEditor.target = line;
        if (eventEditors) eventEditors.changeTarget({ judgeLine: line });

        drawActiveEditor();
    }
// #endregion

// #region 播放器交互
    const HIDE_DELAY = 5000;
    const DOUBLE_TAP_MS = 300;

    let hideTimer: ReturnType<typeof setTimeout> | null = null;
    let lastX = 0;
    let startTime = 0;
    let movedBy = 0;
    let timeDelta = 0;
    let pausedByDrag = false;
    let lastTapAt = 0;

    function scheduleHide(): void {
        if (hideTimer) clearTimeout(hideTimer);

        hideTimer = setTimeout(() => {
            controlsVisible = false;
        }, HIDE_DELAY);
    }

    function showControls(): void {
        controlsVisible = true;
        scheduleHide();
    }

    function onPointerDown(event: PointerEvent): void {
        // 全屏锁定（类 B 站）期间禁用左右拖动 seek，避免跟打时误触
        if (locked) return;

        lastX = event.clientX;
        startTime = currentTime;
        movedBy = 0;
        pausedByDrag = false;
        dragging = true;

        // 只按下不暂停：暂停留给"真的开始左右拖"和双击
        showControls();
    }

    const clamp = (x: number, l: number, r: number) => Math.min(r, Math.max(l, x))

    function onPointerMove(event: PointerEvent): void {
        if (!dragging || !playerBox) return;

        const dx = event.clientX - lastX;
        lastX = event.clientX;

        // 真的开始拖了才暂停
        if (!pausedByDrag) {
            pause();
            pausedByDrag = true;
        }

        movedBy = dx;

        /*
         * 纵向位置要按**整块播放器**算，不能用 `event.offsetY`。
         *
         * `offsetY` 是相对**事件 target** 的 —— 按在画布上、按在提示文字上、
         * 按在控制条上，target 各不相同，同一个手指位置算出来的 `relY` 会跳。
         * 用容器自己的 `rect`，`clientY - top` 和 `height` 就是同一参照系。
         */
        const rect = playerBox.getBoundingClientRect();
        const relY = (event.clientY - rect.top) / Math.max(rect.height, 1);
        const rate = relY > 0.33 ? 1 : 0.25;

        // 整宽 = 整首时长（B 站那种手感）。宽度也取同一个 `rect`，
        // 免得和上面的高度一个含缩放、一个不含
        const span = total || 30;
        const scale = span / Math.max(rect.width, 1);
        timeDelta += dx * scale * rate;
        const next = clamp(startTime + timeDelta, 0, (chart?.duration ?? 30));

        seek(next);
        showControls();


        seekHint = `${timeDelta >= 0 ? "+" : ""}${timeDelta.toFixed(1)}s (x${rate}) ${format(next)}`;
    }

    function onPointerUp(): void {
        if (!dragging) return;

        dragging = false;
        seekHint = "";
        timeDelta = 0;

        if (Math.abs(movedBy) < 4) {
            const now = Date.now();

            if (now - lastTapAt < DOUBLE_TAP_MS) {
                togglePlay();
                showControls();
            } else if (controlsVisible) {
                scheduleHide();
            } else {
                showControls();
            }

            lastTapAt = now;

            return;
        }

        showControls();
    }

    function onProgressInput(event: Event): void {
        event.stopPropagation();

        // 拖动中：只把滑块位置留在手指处（`syncProgress` 已被 `progressDragging` 挡住），
        // 真正的跳转走合并后的 `seek()`
        const value = Number((event.target as HTMLInputElement).value);

        currentTime = value;
        seek(value);
        showControls();
    }

    function onTogglePlay(event: MouseEvent): void {
        event.stopPropagation();
        togglePlay();
        showControls();
    }

    function onToggleFullscreen(event: MouseEvent): void {
        event.stopPropagation();
        showControls();

        if (document.fullscreenElement) void document.exitFullscreen();
        else void playerBox?.requestFullscreen?.();
    }

    function onFullscreenChange(): void {
        const isFullscreen = !!document.fullscreenElement;

        fullscreen = isFullscreen;
        aspect = isFullscreen ? 16 / 9 : 3 / 2;

        // 退出全屏时解除锁定，免得回来还是"什么都没了"
        if (!isFullscreen) locked = false;

        requestAnimationFrame(() => player?.useNewAspect());

        try {
            if (isFullscreen) void screen.orientation?.lock?.("landscape");
            else screen.orientation?.unlock?.();
        } catch {
            // 桌面浏览器 / 部分 WebView 不支持锁方向
        }
    }

    /**
     * 把播放器时间直接写到 DOM 上（**不走响应式**）。
     * 桌面端也是 `progressBar.value = audio.currentTime` 这么写的。
     */
    function syncProgress(): void {
        if (!player) return;

        const now = player.time;

        currentTime = now;

        // 用户正在拖进度条时**不要**回写 value：每帧覆盖会让滑块被拽回原处，
        // 表现为"拖不动、要等它一下"。松手（pointerup/change）之后自然恢复跟随。
        if (progressEl && !progressDragging) progressEl.value = String(now);
    }

    /** 正在拖进度条（普通变量即可：只在 syncProgress 里读，不需要触发渲染） */
    let progressDragging = false;

    function beginProgressDrag(): void {
        progressDragging = true;
    }

    function endProgressDrag(): void {
        progressDragging = false;
    }

    //#region 操作栈（只读）
    /** 切到操作栈 tab 时 +1，让下面的 `$node` 重算 */
    let opsTick = $state(0);

    interface OpsRow {
        key: string;
        kind: "op" | "sep";
        text: string;
        undone: boolean;
    }

    const opsRows = $node({
        get: () => {
            // 读一下，建立依赖
            opsTick;

            const rows: OpsRow[] = [];
            const list = operationList;

            if (!list) return rows;

            const undone = [...list.undoneOperations].reverse();
            const done = [...list.operations];

            undone.forEach((operation, index) => {
                rows.push({
                    key: `u${index}`,
                    kind: "op",
                    text: `${operation.constructor.name} · 已撤销`,
                    undone: true
                });
            });

            if (undone.length > 0 && done.length > 0) {
                rows.push({ key: "sep", kind: "sep", text: "", undone: false });
            }

            done.forEach((operation, index) => {
                rows.push({ key: `d${index}`, kind: "op", text: operation.constructor.name, undone: false });
            });

            return rows;
        }
    });
    //#endregion

    //#region 播放速率 / 撤销重做 / 全屏锁定
    /** 固定档位，不做连续可调（连续微调在手机上很难点准） */
    const PLAYBACK_RATES = [0.5, 0.75, 1, 1.25, 1.5];
    let playbackRate = $state(1);

    /** 全屏锁定（类 B 站）：点一下锁定，长按解锁 */
    let locked = $state(false);
    let fullscreen = $state(false);
    let unlockTimer: ReturnType<typeof setTimeout> | null = null;
    /** 正在按住解锁（用来跑进度环） */
    let unlocking = $state(false);


    function cycleRate(): void {
        const index = PLAYBACK_RATES.indexOf(playbackRate);
        const next = PLAYBACK_RATES[(index + 1) % PLAYBACK_RATES.length];

        playbackRate = next;

        if (player) player.audio.playbackRate = next;
    }

    function undo(): void {
        operationList?.undo();
    }

    function redo(): void {
        operationList?.redo();
    }

    /** 点一下锁定；长按（600ms）解锁 —— 避免跟打时误触解锁 */
    function onLockDown(): void {
        if (unlockTimer) clearTimeout(unlockTimer);

        if (!locked) {
            locked = true;

            return;
        }

        // 已锁定：按住开始走"解锁进度环"，600ms 走满才解开
        unlocking = true;

        unlockTimer = setTimeout(() => {
            locked = false;
            unlocking = false;
            unlockTimer = null;
        }, 600);
    }

    function onLockUp(): void {
        // 中途松手：进度环收回，保持锁定
        unlocking = false;

        if (unlockTimer) {
            clearTimeout(unlockTimer);
            unlockTimer = null;
        }
    }
    //#endregion

    function format(seconds: number): string {
        const value = Math.max(0, seconds || 0);
        const minutes = Math.floor(value / 60);
        const rest = Math.floor(value % 60);
        const millis = Math.floor((value - Math.floor(value)) * 1000);

        return `${minutes}:${rest.toString().padStart(2, "0")}.${millis.toString().padStart(3, "0")}`;
    }
// #endregion

// #region 页面导航
    function pick(id: MobileTab): void {
        // 操作栈是只读快照：切过去时重新算一次
        opsTick += 1;

        // 错误页同理：解析 / 自愈可能在别处又记了新的
        if (id === "errors") refreshChartErrors();

        const next = Math.max(0, tabs.findIndex((item) => item.id === id));

        if (next === tabIndex) return;

        const from = tabIndex;

        tabIndex = next;
        activeTab = id;

        requestAnimationFrame(() => {
            const element = pageTrack;

            if (element) {
                element.style.transform = `translateX(${-next * 100}%)`;
                // 用 WAAPI 而不是 CSS transition：不依赖元素是否被重建
                element.animate(
                    [
                        { transform: `translateX(${-from * 100}%)` },
                        { transform: `translateX(${-next * 100}%)` }
                    ],
                    { duration: 240, easing: "cubic-bezier(0.22, 0.61, 0.36, 1)" }
                );
            }

            drawActiveEditor();
        });
    }

    //#region 底部面板（挂载点）
    /*
     * 页面只保留"面板开着没有、编的是哪一个"这几个状态。
     *
     * 草稿、提交、删除 / 设为默认、订阅操作列表、拖拽与开合动画，全都在
     * `SheetShell.grain` / `NoteSheet.grain` / `EventSheet.grain` 里 ——
     * 它们各自持有自己需要的状态，页面不再掺和。
     */
    let sheetOpen = $state(false);
    let sheetKind = $state<"note" | "node" | "macro" | "line" | "multiNote" | "multiNode">("note");
    /** 框选出来的音符 / 节点（批量编辑入口与面板共用） */
    let multiNotes = $state<Note[]>([]);
    let multiNodes = $state<any[]>([]);
    /** 判定线属性面板要看的那一条（`editingLineId` 消费后落到这里） */
    let editingLine = $state<any>(null);
    /*
     * 这两个必须是 `$state`：`SheetShell` 的 children 闭包会捕获它们，
     * 普通变量在闭包里就是一份快照 —— 第二次打开面板时传进去的是 `null`，
     * `NoteSheet` 读 `note.type` 直接抛，渲染中断，于是只剩凸起、还挡着模态。
     */
    let editingNote = $state<Note | null>(null);
    let editingNode = $state<any>(null);
    /** 宏面板要看的那一个；`null` 就是列表页 */
    let editingMacro = $state<any>(null);

    /**
     * 真正卸载面板。
     *
     * 收起动画由 `SheetShell` 负责（它播完再回调），这里只把状态清掉 ——
     * 所以不需要 `sheetClosing` 之类的中间态。
     */
    function closeSheetNow(): void {
        sheetOpen = false;
        editingNote = null;
        editingNode = null;
        editingMacro = null;
        editingLine = null;
        notesCanvas?.focus?.();
    }

    /**
     * 判定线左滑的「设定」：行组件写 `editingLineId`，这里消费并开面板。
     *
     * 递归的 `JudgeLineRow` 拿不到页面函数，只能走 store 中转；消费完立刻
     * 置回 `null`，免得下次渲染又触发一遍。
     */
    editingLineId.subscribe((id) => {
        if (id === null) return;

        const line = lineOf(id);

        editingLineId.set(null);

        if (!line) return;

        sheetKind = "line";
        editingNote = null;
        editingNode = null;
        editingMacro = null;
        editingLine = line;
        sheetOpen = true;
    });

    function openNoteSheet(): void {
        const note = notesEditor?.selectedNote;

        if (!note) return;

        sheetKind = "note";
        editingNode = null;
        editingMacro = null;
        editingNote = note;
        sheetOpen = true;
    }

    /** 打开宏面板；传 `null` 就是列表面 */
    function openMacroSheet(macro: any = null): void {
        sheetKind = "macro";
        editingNote = null;
        editingNode = null;
        editingMacro = macro;
        sheetOpen = true;
    }

    function openNodeSheet(): void {
        const node = (eventEditors as any)?.activatedEditor?.selectedNode;

        if (!node) return;

        sheetKind = "node";
        editingNote = null;
        editingMacro = null;
        editingNode = node;
        sheetOpen = true;
    }

    /** 框选出来的音符 → 批量编辑面板 */
    function openMultiNote(): void {
        if (!multiNotes.length) return;

        sheetKind = "multiNote";
        editingNote = null;
        editingNode = null;
        editingMacro = null;
        editingLine = null;
        sheetOpen = true;
    }

    /** 框选出来的事件节点 → 批量编辑面板 */
    function openMultiNode(): void {
        if (!multiNodes.length) return;

        sheetKind = "multiNode";
        editingNote = null;
        editingNode = null;
        editingMacro = null;
        editingLine = null;
        sheetOpen = true;
    }

    //#endregion

    function back(): void {
        if (chart?.modified && !confirm("当前谱面有未保存的更改，确定返回吗？")) return;

        navigate("/");
    }

    /**
     * 左上角那个 ‹ 的语义随状态变：
     *   · 全屏时 = **退出全屏**（不是退出谱面）；
     *   · 非全屏时 = 退出谱面。
     */
    function onBack(): void {
        if (document.fullscreenElement) {
            void document.exitFullscreen?.();

            return;
        }

        // 离开谱面就把定时器停掉，别让它在下个页面继续往磁盘里写
        stopAutoSave();
        back();
    }

    /** 跳到历史版本页（数据层和桌面端同一份，见 `#/background`） */
    function goHistory(): void {
        const id = route.get().params.id;

        if (id) navigate(`/charts/${id}/history`);
    }
    //#endregion
</script>

<script onmount>
    document.addEventListener("fullscreenchange", onFullscreenChange);

    /*
     * 应用内错误条：移动端不方便开 DevTools，把未捕获异常直接显示在屏幕底部。
     * 只在开发时有用，但也没必要按环境关掉 —— 真出错了，用户能看到比看不到强。
     */
    const showError = (message: string): void => {
        runtimeError = message;

        // 屏幕上只有一行，完整信息（含栈）走控制台
        console.error("[运行时错误]", message);
    };

    const onWindowError = (event: ErrorEvent): void => {
        showError(event.message || String(event.error));
    };

    const onRejection = (event: PromiseRejectionEvent): void => {
        showError(String((event.reason as Error)?.message ?? event.reason));
    };

    window.addEventListener("error", onWindowError);
    window.addEventListener("unhandledrejection", onRejection);

    // 有未保存改动时，关窗口 / 刷新让浏览器弹它自己的确认框。
    // 别把回调命名成 `guard`：编译器 dev 下会插 `guard(...)`，同名局部变量会遮住它。
    const warnBeforeUnload = (event: BeforeUnloadEvent) => {
        if (!chart?.modified) return;

        event.preventDefault();
        event.returnValue = "";
    };

    window.addEventListener("beforeunload", warnBeforeUnload);

    (async () => {
        try {
            await loadChart(route.get().params.id ?? null);

            total = chart?.duration ?? 0;

            // 先渲染出画布，量到尺寸之后再建编辑器和播放器
            ready = true;
            await new Promise((resolve) => requestAnimationFrame(resolve));

            await bootEditors();

            selectedLineId.subscribe(() => syncEditorTargets());

            /*
             * 谱面被改动（本页面板、撤销 / 重做、别处改了对象）→ 播放器和当前画布
             * 都要重画一次。`operationList` 是唯一真相，它发 `needsupdate` 就说明
             * 数据变了，画面不能再停在旧状态。
             */
            operationList?.addEventListener("needsupdate", onOperationsChanged);

            await bootPlayer();

            /*
             * 解析阶段收集到的警告（形状不对、自动修复过的东西）。
             * 和桌面端一致：加载完看一眼 `KPAError.buffer`，有东西就提示
             * 用户去「错误」页看 —— 不打断，也不自动弹面板。
             */
            refreshChartErrors();

            if (chartErrors.length > 0) {
                notify(
                    `谱面解析有 ${chartErrors.length} 条警告，详见「错误」页`,
                    "error"
                );
            }
        } catch (error) {
            /*
             * 别在这里设 `ready = true`：错误只渲染在 `{#if !ready}` 的占位符里，
             * 一设 ready 消息就被藏起来了，页面上只剩"空 UI"，看不出为什么空。
             *
             * `message` 也兜一下底：有些解析错误是 `throw "字符串"` 或者
             * 只有 `name`，直接取 `.message` 会得到空串。
             */
            const message =
                error instanceof Error
                    ? error.message || error.stack || error.name
                    : String(error);

            loadError = message || "未知错误";

            // 屏幕上只放一行摘要，原始对象（带栈）交给控制台
            console.error("[打开谱面失败]", error);

            // `ready` 在 try 里可能已经置 true 了（`bootEditors` 那一步失败），
            // 退回占位符态，否则错误照样被主 UI 盖住
            ready = false;
        }
    })();
</script>

<main class="app">
    <!--
        页面主体**不**用 `{#if ready}` 挡：播放器和两块画布必须在挂载时就存在，
        `onmount` 里才有 `bind:this` 的引用去建实例。列表的数据靠
        `chartLoaded` 这个信号刷新（见 JudgeLineList）。
    -->
    <!-- 播放器：和桌面端一样，逻辑分辨率按 900 高算，CSS 只负责缩放 -->
    <section
        class="player"
        bind:this={playerBox}
        style="aspect-ratio: {aspect}"
        onpointerdown={onPointerDown}
        onpointermove={onPointerMove}
        onpointerup={onPointerUp}
        onpointercancel={onPointerUp}
        onpointerleave={onPointerUp}
    >
        <canvas class="player-canvas" bind:this={playerCanvas} width={playerWidth} height={BASE_HEIGHT}></canvas>

        {#if dragging && seekHint !== ""}
            <div class="seek-hint">{seekHint}</div>
        {/if}

        <!-- 速率 / 撤销重做：右上角，和控制条同一显现周期（不常驻，防误触）；全屏时隐藏 -->
        {#if !fullscreen}
            <div class="top-controls {controlsVisible && !locked ? "visible" : ""}">
                <button class="ctrl small" onclick={cycleRate}>{playbackRate}x</button>
                <button class="ctrl small" onclick={undo} aria-label="撤销">↶</button>
                <button class="ctrl small" onclick={redo} aria-label="重做">↷</button>
            </div>
        {/if}

        <!-- 全屏锁定：锁定时除了它自己什么都不显示，长按解锁 -->
        {#if fullscreen}
            <button
                class="lock {locked ? "locked" : ""} {unlocking ? "holding" : ""}"
                onpointerdown={onLockDown}
                onpointerup={onLockUp}
                onpointercancel={onLockUp}
                onpointerleave={onLockUp}
                aria-label={locked ? "解锁" : "锁定"}
            >
                <!--
                    两个图标都常驻，靠按钮的 `.locked` 类切换显隐。

                    （历史坑：早先这里写过 `{#if locked}` 两个分支、也写过 `d={…}`，
                    都"点了没反应"。真正的原因是**事件处理器里有 early return**，
                    编译器把刷新语句拼在函数末尾，落在 `return` 后面成了死代码
                    —— 已在 grain 编译器中修复，跟 SVG / 分支 无关。）
                -->
                <svg
                    class="lock-icon lock-open"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                </svg>
                <svg
                    class="lock-icon lock-closed"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>

                <!-- 按住解锁时绕一圈的进度环（`.holding` 只在按住时加，锁定时才可能按住） -->
                <svg class="lock-ring" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="16"></circle>
                </svg>
            </button>
        {/if}

        <div class="controls {controlsVisible && !locked ? "visible" : ""}">
            <button class="ctrl" onclick={onTogglePlay}>{playing ? "❚❚" : "▶"}</button>

            <!-- 进度与时间由 `drawn` 回调直接写 DOM -->
            <input
                class="progress"
                bind:this={progressEl}
                type="range"
                min="0"
                max={total || 30}
                step="0.01"
                value="0"
                oninput={onProgressInput}
                onpointerdown={beginProgressDrag}
                onpointerup={endProgressDrag}
                onpointercancel={endProgressDrag}
                onclick={(event) => event.stopPropagation()}
            />

            <span class="time">{format(currentTime)}</span>

            <button class="ctrl" onclick={onToggleFullscreen}>⛶</button>
        </div>

        <!-- 返回按钮和控制条同一个显现周期 -->
        <button
            class="back {controlsVisible ? "visible" : ""}"
            onclick={onBack}
            aria-label={fullscreen ? "退出全屏" : "返回"}
        >‹</button>

        {#if !ready}
            <div class="placeholder {loadError ? "err" : ""}">
                {#if loadError}
                    打开谱面失败：{loadError}

                    <!-- 加载失败时唯一能做的事：去历史里挑一个能打开的版本 -->
                    <button class="recover" onclick={goHistory}>
                        前往该谱面的历史版本
                    </button>
                {:else}
                    正在打开谱面…
                {/if}
            </div>
        {:else if playerError}
            <div class="placeholder err">播放器初始化失败：{playerError}</div>
        {/if}
    </section>

    <nav class="tabs">
        {#for item of tabs with key = item}
            <button class="tab {item.id === activeTab ? "active" : ""}" onclick={() => pick(item.id)}>
                {_(item.label)}
            </button>
        {/for}

    </nav>

    <!-- 三块内容始终存活：切页只平移轨道 + 切 visibility，不销毁 DOM -->
    <section class="content">
        <div class="track" bind:this={pageTrack} style="transform: translateX({-tabIndex * 100}%)">
            <!-- 列表页**不加** flex 居中：那会把 .list 挤成内容宽度 -->
            <div class="slide {tabIndex === 0 ? "active" : ""}">
                <JudgeLineList></JudgeLineList>
            </div>

            <div class="slide center {tabIndex === 1 ? "active" : ""}">
                <canvas class="editor-canvas" bind:this={notesCanvas}></canvas>

                </div>

            <div class="slide center {tabIndex === 2 ? "active" : ""}">
                <canvas class="editor-canvas" bind:this={eventsCanvas}></canvas>

                </div>

            <div class="slide {tabIndex === 3 ? "active" : ""}">
                <div class="ops">
                    {#for row of opsRows with key = row.key}
                        {#if row.kind === "sep"}
                            <div class="op-sep"></div>
                        {:else}
                            <div class="op {row.undone ? "undone" : ""}">{row.text}</div>
                        {/if}
                    {/for}
                </div>
            </div>

            <!-- 解析警告：`KPAError.buffer` 的快照，只读 -->
            <div class="slide {tabIndex === 4 ? "active" : ""}">
                <div class="ops">
                    {#if chartErrors.length === 0}
                        <p class="errors-empty">没有解析警告</p>
                    {:else}
                        {#for error of chartErrors}
                            <div class="error-line">
                                <span class="error-tag {error.fixed ? "fixed" : ""}">
                                    {error.fixed ? "已修复" : "警告"}
                                </span>
                                <span class="error-text">{error.message}</span>
                            </div>
                        {/for}
                    {/if}
                </div>
            </div>

            <!-- 画布设置：改编辑器字段，改完立刻重绘 -->
            <div class="slide {tabIndex === 5 ? "active" : ""}">
                <div class="settings">
                    <div class="setting">
                        <span>亮色主题</span>
                        <Switch
                            bind:checked={get: () => theme.get() === "light", set: (value: boolean) => {
                                theme.set(value ? "light" : "dark");
                            }}
                        />
                    </div>

                    <div class="setting">
                        <span>拍数分母</span>
                        <NumField
                            inputmode="numeric"
                            bind:value={get: () => String(divisorValue), set: (raw: string) => {
                                applyTimeDivisor(raw);
                            }}
                        />
                    <div class="presets">
                        <Segmented
                            variant="plain"
                            options={divisorOptions}
                            bind:value={get: () => divisorValue, set: (value: number) => {
                                applyTimeDivisor(String(value));
                            }}
                        />
                    </div>
                    </div>

                    <div class="setting">
                        <span>时间跨度（拍）</span>
                        <NumField
                            bind:value={get: () => String(timeSpanValue), set: (raw: string) => {
                                applyTimeSpan(raw);
                            }}
                        />
                    <div class="presets">
                        <Segmented
                            variant="plain"
                            options={timeSpanOptions}
                            bind:value={get: () => timeSpanValue, set: (value: number) => {
                                applyTimeSpan(String(value));
                            }}
                        />
                    </div>
                    </div>

                    <div class="setting">
                        <span>值跨度</span>
                        <NumField
                            bind:value={get: () => String(positionSpanValue), set: (raw: string) => {
                                applyPositionSpan(raw);
                            }}
                        />
                    <div class="presets">
                        <Segmented
                            variant="plain"
                            options={positionSpanOptions}
                            bind:value={get: () => positionSpanValue, set: (value: number) => {
                                applyPositionSpan(String(value));
                            }}
                        />
                    </div>
                    </div>

                    <div class="setting">
                        <span>音符网格间距</span>
                        <NumField
                            bind:value={get: () => String(gridValue), set: (raw: string) => {
                                applyNoteGrid(raw);
                            }}
                        />
                    <div class="presets">
                        <Segmented
                            variant="plain"
                            options={gridOptions}
                            bind:value={get: () => gridValue, set: (value: number) => {
                                applyNoteGrid(String(value));
                            }}
                        />
                    </div>
                    </div>

                    <div class="setting">
                        <span>事件网格间距</span>
                        <NumField
                            placeholder="默认"
                            bind:value={get: () => "", set: (raw: string) => {
                                applyEventGrid(raw);
                            }}
                        />
                    </div>

                    <div class="setting">
                        <span>显示 NNN 参考线</span>
                        <Switch
                            bind:checked={get: () => notesEditor?.showsNNNListAttachable ?? true, set: (value: boolean) => {
                                applyShowsNNN(value);
                            }, active: true}
                        />
                    </div>

                    <div class="setting">
                        <span>拖到边缘自动滚动</span>
                        <Switch
                            bind:checked={get: () => notesEditor?.edgeScrollEnabled ?? true, set: (value: boolean) => {
                                applyEdgeScroll(value);
                            }, active: true}
                        />
                    </div>

                    <p class="settings-hint">
                        时间跨度同时作用于两个画布；事件网格留空表示各类型默认值。
                    </p>
                </div>
            </div>

            <!-- 谱面信息：曲名 / 难度 / 作曲 / 谱师 / 曲绘 / 偏移 -->
            <div class="slide {tabIndex === 6 ? "active" : ""}">
                <div class="settings">
                    <div class="setting">
                        <span>曲名</span>
                        <TextField bind:value={chartNameNode} />
                    </div>
                    <div class="setting">
                        <span>难度</span>
                        <TextField bind:value={chartLevelNode} />
                    </div>
                    <div class="setting">
                        <span>作曲</span>
                        <TextField bind:value={chartComposerNode} />
                    </div>
                    <div class="setting">
                        <span>谱师</span>
                        <TextField bind:value={chartCharterNode} />
                    </div>
                    <div class="setting">
                        <span>曲绘</span>
                        <TextField bind:value={chartIllustratorNode} />
                    </div>
                    <div class="setting">
                        <span>偏移</span>
                        <NumField bind:value={chartOffsetNode} />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 底部提示条：解析警告 / 自愈提示（几秒后自己消失） -->
    {#if notices.length > 0}
        <div class="notices">
            {#for notice of notices with key = notice.id}
                <div class="notice {notice.type}">{notice.message}</div>
            {/for}
        </div>
    {/if}

    <!--
        底部面板：骨架（遮罩 / 凸起 / 开合动画 / 下滑收起）在 `SheetShell.grain`，
        内容按"音符 / 事件节点"拆成两个组件 —— 各自持有草稿、自己订阅操作列表，
        父级只传稳定的对象引用和关闭回调。
    -->
    <!--
        条件里带目标存在性：目标为空时宁可不挂载，也不能把 `null` 传给表单
        （表单在初始化时就读 `note.type`，一抛错整棵子树渲染中断，
        只剩下遮罩 + 凸起，还把页面挡住 —— 就是"点哪儿都没反应"）。
    -->
    {#if sheetOpen && (editingNote || editingNode || editingLine || multiNotes.length || multiNodes.length || sheetKind === "macro")}
        <SheetShell onclose={closeSheetNow}>
            {#if sheetKind === "line" && editingLine}
                <JudgeLineSheet line={editingLine} onclose={closeSheetNow} />
            {:else if sheetKind === "multiNote" && multiNotes.length}
                <MultiNoteSheet notes={multiNotes} onclose={closeSheetNow} />
            {:else if sheetKind === "multiNode" && multiNodes.length}
                <MultiNodeSheet nodes={multiNodes} onclose={closeSheetNow} />
            {:else if sheetKind === "note" && editingNote}
                <NoteSheet
                    note={editingNote}
                    editor={notesEditor}
                    onclose={closeSheetNow}
                    onmacro={openMacroSheet}
                />
            {:else if sheetKind === "node" && editingNode}
                <EventSheet
                    node={editingNode}
                    editor={eventEditors}
                    onclose={closeSheetNow}
                    onmacro={openMacroSheet}
                />
            {:else if sheetKind === "macro"}
                <MacroSheet macro={editingMacro} onclose={closeSheetNow} />
            {/if}
        </SheetShell>
    {/if}

    <!-- 应用内错误条：移动端不方便开 DevTools，异常直接显示出来 -->
    {#if runtimeError}
        <div class="runtime-error" onclick={() => (runtimeError = null)}>
            {runtimeError}
        </div>
    {/if}
</main>

<style>
.app {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    margin: 0;
    overflow: hidden;
}

/* ---------- 播放器 ---------- */
.player {
    position: relative;
    flex: none;
    width: 100%;
    aspect-ratio: 3 / 2;
    padding: 0;
    margin: 0;
    background: #000;
    overflow: hidden;
    touch-action: none;
    border-radius: 0;
}

/* 全屏时铺满整块屏幕（此时宽高比已被切成 16:9） */
.player:fullscreen {
    width: 100vw;
    height: 100vh;
}

.player-canvas {
    width: 100%;
    height: 100%;
    display: block;
}

.placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    text-align: center;
    color: #bbb;
    font-size: 13px;
    background: #000;
}

.placeholder.err {
    color: #ff8080;
    /*
     * 解析错误常常是"字段路径 + 期望类型"那种长串，允许换行和滚动，
     * 不然会被 flex 居中截在中间，两边都看不见。
     */
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 12px;
    padding: 12px;
    white-space: pre-wrap;
    word-break: break-word;
    overflow: auto;
    text-align: left;
}

/* 加载失败时通往历史版本的按钮 */
.recover {
    padding: 8px 14px;
    border: 1px solid rgba(242, 84, 91, 0.5);
    border-radius: 8px;
    background: rgba(242, 84, 91, 0.12);
    color: #ff8080;
    font: inherit;
    font-size: 13px;
}

.center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    text-align: center;
    color: var(--text-dim);
    font-size: 14px;
}

.seek-hint {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 6px 12px;
    border-radius: 6px;
    background: var(--overlay);
    color: var(--text);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
}

.controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    pointer-events: none;
}

.controls.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}

.ctrl {
    border: none;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    font-size: 14px;
}

.progress {
    flex: 1;
    height: 4px;
    accent-color: var(--accent);
    min-width: 0;
}

.ops {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 10px 14px;
}

.op {
    padding: 6px 0;
    font-size: 13px;
    color: var(--text);
}

.op.undone {
    color: var(--text-dim);
    text-decoration: line-through;
}

/* 已撤销 / 已做 之间的分界 */
.op-sep {
    margin: 8px 0;
    border-top: 1px dashed var(--border);
}

.errors-empty {
    margin: 0;
    padding: 6px 0;
    font-size: 13px;
    color: var(--text-dim);
}

/* 一条解析警告：左边标签 + 右边原文（原文允许换行，路径很长） */
.error-line {
    display: flex;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
}

.error-tag {
    flex: 0 0 auto;
    align-self: flex-start;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(242, 84, 91, 0.18);
    color: #ff8080;
    font-size: 11px;
}

.error-tag.fixed {
    background: rgba(76, 141, 255, 0.18);
    color: #8ab4ff;
}

.error-text {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text);
    word-break: break-word;
}

/* 底部提示条：和运行时错误条同一个位置，但可以叠多条 */
.notices {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 60;
    pointer-events: none;
}

.notice {
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(28, 32, 40, 0.95);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 13px;
}

.notice.error {
    border-color: rgba(242, 84, 91, 0.5);
    color: #ff8080;
}

.top-controls {
    position: absolute;
    right: 8px;
    top: calc(8px + env(safe-area-inset-top));
    display: flex;
    gap: 6px;
    z-index: 11;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
}

.top-controls.visible {
    opacity: 1;
    pointer-events: auto;
}

.ctrl.small {
    width: 34px;
    height: 34px;
    font-size: 12px;
}

/* 全屏锁定：锁上之后只剩它自己 */
.lock {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.42);
    color: #fff;
    font-size: 18px;
    z-index: 12;
    opacity: 0.45;
    transition: opacity 0.18s ease;
}

.lock.locked {
    opacity: 0.28;
}

/* 图标本体：锁 / 开锁 */
.lock {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.lock-icon {
    width: 20px;
    height: 20px;
}

/* 两个图标叠在同一格，按 `.locked` 切换显隐（只依赖 class，不依赖属性刷新） */
.lock-closed {
    display: none;
}

.lock.locked .lock-open {
    display: none;
}

.lock.locked .lock-closed {
    display: block;
}

/*
 * 解锁进度环：按住 600ms 走满一圈（时钟感），边框本身是圆的，
 * 环从 12 点方向顺时针推进。
 */
.lock-ring {
    position: absolute;
    inset: 3px;
    width: calc(100% - 6px);
    height: calc(100% - 6px);
    transform: rotate(-90deg);
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    pointer-events: none;
}

.lock.holding .lock-ring {
    opacity: 1;
    animation: lock-ring 600ms linear forwards;
}

.lock.holding {
    opacity: 0.85;
}

@keyframes lock-ring {
    to {
        stroke-dashoffset: 0;
    }
}

.time {
    color: #fff;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    width: 5em;
    flex: none;
}

/* 返回按钮：跟控制条同显现周期 */
.back {
    position: absolute;
    left: 8px;
    top: calc(8px + env(safe-area-inset-top));
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.42);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
}

.back.visible {
    opacity: 1;
    pointer-events: auto;
}

/* ---------- 标签栏 ---------- */
/* 标签多了允许横向溢出（滚动条隐藏），每个标签内部不换行 */
.tabs {
    display: flex;
    flex: none;
    padding: 0;
    margin: 0;
    /* 比底色亮一档：暗色下是 rgb(60,60,60)，和内容区分层 */
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
}

.tabs::-webkit-scrollbar {
    display: none;
}

.tab {
    /* 不收缩：均分会把长名字压扁，宁可溢出 */
    flex: 0 0 auto;
    border: none;
    border-radius: 0;
    background: none;
    padding: 10px 10px;
    font-size: 13px;
    color: var(--text-dim);
    white-space: nowrap;
}

.tab.active {
    color: var(--accent);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
}



/* ---------- 内容区 ---------- */
.content {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

.track {
    display: flex;
    height: 100%;
    width: 100%;
    transition: transform 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
}

/* 画布设置面板：一行一个字段，和最右的输入框对齐；一屏装不下就滚 */
.settings {
    padding: 16px;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
}

/*
 * 一行一个字段：右侧固定一列，输入框左右边才对得齐（flex 下各按内容撑开）。
 * 左边 `minmax(0, 1fr)` + `nowrap`：标签长了省略，不把输入框挤歪。
 * 常用值那排是它的子元素，`grid-column: 1 / -1` 换到第二行。
 */
.setting {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    align-items: center;
    column-gap: 12px;
    row-gap: 2px;
    padding: 10px 0 6px;
    font-size: 14px;
    color: var(--text);
    border-bottom: 1px solid var(--border);
}

.setting > span:first-child {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 子组件的根元素要用 :global（scope 后缀匹配不到） */
.setting > :global(input) {
    grid-column: 2;
    width: 100%;
    min-width: 0;
}

.setting > :global(button) {
    grid-column: 2;
    justify-self: end;
}

.setting > .presets {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    padding-top: 2px;
}

/* 谱面信息里的文本输入框由 `TextField` 自己管样式，这里只管列位置 */
.setting > :global(input) {
    grid-column: 2;
    width: 100%;
    min-width: 0;
}

/*
 * 设置项下面那排常用值：贴右对齐，和输入框同一条竖线。
 *
 * 分隔横线放在**这里**（不在 `.setting` 上）—— 一排预设属于上一个字段，
 * 线画在它下面才对。
 */
/* 常用值那排现在在 `.setting` 内部（见上），这里不再单独画分隔线 */

.settings-hint {
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-dim);
}

.slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    /* 批量编辑入口要绝对定位在画布上 */
    position: relative;
    /* 非当前页 visibility: hidden（不是移除 DOM），滑完再隐藏 */
    visibility: hidden;
    transition: visibility 0s linear 0.24s;
}

/* 只有画布页需要居中；列表页要铺满，不能改成 flex */
.slide.center {
    display: flex;
    align-items: center;
    justify-content: center;
}

.slide.active {
    visibility: visible;
    transition-delay: 0s;
}

.editor-canvas {
    display: block;
    border: none;
    border-radius: 0;
    background: var(--surface);
    touch-action: none;
}

/* ===== 应用内错误条 ===== */
.runtime-error {
    position: fixed;
    left: 8px;
    right: 8px;
    bottom: calc(8px + env(safe-area-inset-bottom));
    z-index: 2000;
    padding: 10px 12px;
    border-radius: 8px;
    background: #7f1d1d;
    color: #fff;
    font: 12px/1.4 monospace;
    white-space: pre-wrap;
    cursor: pointer;
}

/* ===== 底部面板 ===== */
.sheet-mask {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: flex-end;
    background: rgba(0, 0, 0, 0.45);
    animation: sheet-mask-in 0.18s ease-out;
}

.sheet-mask.closing {
    animation: sheet-mask-out 0.22s ease-in forwards;
}

.sheet {
    /* 凸起要"长"到面板外面，所以这里不能裁 */
    position: relative;
    width: 100%;
    max-height: 60vh;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 14px calc(14px + env(safe-area-inset-bottom));
    background: var(--surface);
    border-radius: 16px 16px 0 0;
    overflow: visible;
    will-change: transform;
    /* 松手回弹的过渡（拖动中要关掉，否则跟手会滞一下） */
    transition: transform 0.18s ease;
}

/*
 * 入场动画只在 `.opening` 期间挂。
 *
 * 之前它挂在 `.sheet` 基础规则上 —— 松手时去掉 `.dragging` 会让这条动画
 * **重新开始**，表现就是"先闪到屏幕下方，再弹上来一遍"。
 */
.sheet.opening {
    animation: sheet-in 0.24s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.sheet.dragging {
    animation: none;
    transition: none;
}

.sheet.closing {
    animation: sheet-out 0.22s ease-in forwards;
}

/* 上沿的凸起：50vw 的圆角梯形，**超出面板上沿**、和面板同色，整块可拖 */
.sheet-handle {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    width: 50vw;
    height: 16px;
    touch-action: none;
    cursor: grab;
}

.sheet-handle svg {
    display: block;
    width: 100%;
    height: 100%;
}

/* 和面板同色：看起来像面板顶上长出来的一块 */
.handle-body {
    fill: var(--surface);
}

.handle-arrow {
    fill: none;
    stroke: var(--text-dim);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.sheet-title {
    margin: 0;
    font-size: 14px;
    opacity: 0.8;
}

.sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.sheet-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

/* 两列：左边主要属性、右边尺寸/偏移那些；列内自上而下排 */
.sheet-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

/* 时间：拍 / 分子 / 分母 */
.triple {
    display: flex;
    gap: 6px;
    min-width: 0;
}

.triple .num {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
}

/* 时间分隔符：`[拍:子/母]` */
.triple .sep {
    align-self: center;
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1;
}

/* 类型：排形按钮（组内密接、无圆角，只有整组圆角） */
.segmented {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
}

.seg {
    flex: 1 1 0;
    min-width: 0;
    padding: 8px 0;
    border: none;
    border-right: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-dim);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
}

.seg:last-child {
    border-right: none;
}

.seg.on {
    background: var(--accent, #4c8dff);
    color: #fff;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    font-size: 12px;
    color: var(--text-dim);
}

.field input,
.field select {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    /* 自实现的数字框：不要浏览器那对上下箭头 */
    appearance: none;
    -webkit-appearance: none;
}

/* select 要保留系统箭头（上面那条 appearance:none 是给自实现数字框的） */
.field select {
    appearance: auto;
    -webkit-appearance: auto;
}

/* 布尔值：圆角矩形开关（半径和输入框一致） */
.switch {
    width: 46px;
    height: 26px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    display: flex;
    align-items: center;
    cursor: pointer;
    transition: background 0.16s ease, border-color 0.16s ease;
}

.switch .knob {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: var(--text-dim);
    transition: transform 0.16s ease, background 0.16s ease;
}

.switch.on {
    background: var(--accent, #4c8dff);
    border-color: transparent;
}

.switch.on .knob {
    transform: translateX(20px);
    background: #fff;
}

.sheet-error {
    margin: 0;
    color: #ff7b72;
    font-size: 12px;
}

.sheet-actions {
    display: flex;
    gap: 10px;
}

.sheet-btn {
    flex: 1;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    cursor: pointer;
}

.sheet-btn.primary {
    background: var(--accent, #4c8dff);
    border-color: transparent;
    color: #fff;
}

/* 删除：危险动作，红色描边（和桌面端 DestructiveButton 同语义） */
.sheet-btn.danger {
    color: #ff7b72;
    border-color: rgba(255, 123, 114, 0.45);
}

@keyframes sheet-in {
    from {
        transform: translateY(100%);
    }
    to {
        transform: translateY(0);
    }
}

/* 从松手时的位置继续往下收（`--sheet-from` 由内联样式给） */
@keyframes sheet-out {
    from {
        transform: translateY(var(--sheet-from, 0px));
    }
    to {
        transform: translateY(100%);
    }
}

@keyframes sheet-mask-in {
    from {
        background: rgba(0, 0, 0, 0);
    }
    to {
        background: rgba(0, 0, 0, 0.45);
    }
}

@keyframes sheet-mask-out {
    from {
        background: rgba(0, 0, 0, 0.45);
    }
    to {
        background: rgba(0, 0, 0, 0);
    }
}
</style>
