<script>
    import { bootEventEditors } from "#/boot";

    let canvas: HTMLCanvasElement;
</script>

<script onmount>
    requestAnimationFrame(() => void bootEventEditors(canvas));
</script>

<div class="pane">
    <!-- 逻辑分辨率固定 600×900（跟桌面端一致），显示尺寸交给 CSS -->
    <canvas class="editor-canvas" bind:this={canvas} width={600} height={900}></canvas>
</div>

<style>
.pane {
    height: 100%;
    padding: 8px;
}

.editor-canvas {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    touch-action: none;
}
</style>
