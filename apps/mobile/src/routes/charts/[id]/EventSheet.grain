<script>
    /*
     * 事件节点面板（底部面板的内容部分）。
     *
     * 只给最常用的两项：时间、值。缓动 / 求值器 / 宏那一套桌面端才有完整 UI，
     * 手机上塞不下，先不做。
     */
    import {
        EasedEvaluator,
        ExpressionEvaluator,
        NormalEasing,
        NumericEasedEvaluator,
        Op,
        TC
    } from "kipphi";

    import Segmented from "#/components/Segmented.grain";
    import Switch from "#/components/Switch.grain";

    import { operationList } from "#/store";
    import {
        beatsOf,
        formatTime,
        num,
        parseTime,
        splitBeats,
        toTime
    } from "#/time";

    let { node, editor, onclose } = $props<{
        node: any;
        editor: any;
        onclose: () => void;
    }>();

    let timeSingle = $state(false);
    let error = $state<string | null>(null);

    let beat = $state("0");
    let numerator = $state("0");
    let denominator = $state("1");
    let timeText = $state("");
    let value = $state("");

    /** 求值器只有两种：缓动 / 表达式（宏求值器留给桌面端） */
    const EVAL_OPTIONS: [number, string][] = [
        [0, "缓动"],
        [1, "表达式"]
    ];

    /**
     * 当前节点的求值器种类。
     *
     * `evaluator` 是普通对象字段，读它不产生编译期依赖 —— 靠 `operationList`
     * 的通知驱动重算（和 `$lsprop` 同一套）。
     */
    const evalKind = $node({
        get: () =>
            node.evaluator instanceof EasedEvaluator ? "eased" : "expression",
        listen: (update: () => void) => {
            operationList?.addEventListener("needsupdate", update);

            return () => operationList?.removeEventListener("needsupdate", update);
        }
    });

    /** 表达式求值器的源码草稿（只在表达式模式下可编辑） */
    let exprText = $state("");

    /** 从缓动切走时把 easing 记住 —— 切回来还是原来那条曲线 */
    let savedEasing: any = null;

    function pull(): void {
        beat = String(node.time[0]);
        numerator = String(node.time[1]);
        denominator = String(node.time[2]);
        timeText = formatTime(node.time);
        value = String(node.value);
        exprText =
            node.evaluator instanceof ExpressionEvaluator
                ? node.evaluator.jsExpr
                : "";
    }

    pull();

    // 撤销 / 重做 / 别处改了同一个节点 → 回灌
    const onOperation = (): void => pull();

    operationList?.addEventListener("needsupdate", onOperation);

    function toggleTimeMode(): void {
        timeSingle = !timeSingle;

        if (timeSingle) {
            const beats = beatsOf(beat, numerator, denominator);

            timeText = Number.isFinite(beats) ? formatTime(toTime(beats)) : "";

            return;
        }

        const beats = parseTime(timeText);

        if (!Number.isFinite(beats)) return;

        const [b, n, d] = splitBeats(beats);

        beat = b;
        numerator = n;
        denominator = d;
    }

    function commit(): void {
        const ops = operationList;

        if (!ops) return;

        const beats = timeSingle
            ? parseTime(timeText)
            : beatsOf(beat, numerator, denominator);

        if (!Number.isFinite(beats)) {
            error = "时间格式不对（`3` / `3+1/4` / `3.25` 都行）";

            return;
        }

        const numeric = typeof node.value === "number";
        const next = numeric ? num(value) : value;

        if (numeric && !Number.isFinite(next)) {
            error = "值必须是数字";

            return;
        }

        error = null;

        const queue: any[] = [];

        if (Math.abs(beats - TC.toBeats(node.time)) > 1e-6)
            queue.push(new Op.EventNodeTimeChangeOperation(node, toTime(beats)));
        if (next !== node.value)
            queue.push(new Op.EventNodeValueChangeOperation(node, next));

        if (queue.length === 0) return;

        ops.tryDo(() =>
            queue.length === 1 ? queue[0] : new Op.ComplexOperation(...queue)
        );
    }

    /** 切换求值器：缓动 ↔ 表达式（各自保留已有配置） */
    function setEvalKind(kind: string): void {
        const ops = operationList;

        if (!ops) return;

        const current = node.evaluator;
        const eased = current instanceof EasedEvaluator;

        if ((kind === "eased") === eased) return;

        error = null;

        if (kind === "eased") {
            const easing = savedEasing ?? new NormalEasing((t: number) => t);

            ops.do(
                new Op.EventNodeEvaluatorChangeOperation(
                    node,
                    new NumericEasedEvaluator(easing)
                )
            );

            return;
        }

        if (eased) savedEasing = (current as any).easing;

        ops.do(
            new Op.EventNodeEvaluatorChangeOperation(
                node,
                new ExpressionEvaluator(exprText.trim() || "1")
            )
        );
    }

    /** 表达式源码写回（只有表达式求值器才有这回事） */
    function commitExpression(): void {
        const ops = operationList;

        if (!ops) return;

        const current = node.evaluator;

        if (!(current instanceof ExpressionEvaluator)) return;

        const next = exprText.trim() || "1";

        if (next === current.jsExpr) return;

        ops.do(
            new Op.EventNodeEvaluatorChangeOperation(
                node,
                new ExpressionEvaluator(next)
            )
        );
    }

    function remove(): void {
        if (!operationList) return;

        try {
            operationList.do(new Op.EventNodePairRemoveOperation(node));
        } catch {
            // 头 / 尾节点不能单独删
            error = "这个节点不能单独删除";

            return;
        }

        editor?.draw();
        onclose();
    }
</script>

<div class="head">
    <span class="kind">事件节点</span>

    <Switch
        bind:checked={
            get: () => timeSingle,
            set: (v: boolean) => {
                if (v === timeSingle) return;
                toggleTimeMode();
            }
        }
    />
</div>

<div class="body" onchange={commit} onblur={commit}>
    <div class="col">
        <div class="field">
            <span>时间</span>
            {#if timeSingle}
                <input class="num" type="text" placeholder="3:1/4" bind:value={timeText} />
            {:else}
                <div class="triple">
                    <input class="num" type="text" inputmode="numeric" placeholder="拍" bind:value={beat} />
                    <span class="sep">:</span>
                    <input class="num" type="text" inputmode="numeric" placeholder="分子" bind:value={numerator} />
                    <span class="sep">/</span>
                    <input class="num" type="text" inputmode="numeric" placeholder="分母" bind:value={denominator} />
                </div>
            {/if}
        </div>
    </div>

    <div class="col">
        <label class="field">
            <span>值</span>
            <input type="text" bind:value={value} />
        </label>

        <div class="field">
            <span>求值器</span>
            <Segmented
                options={EVAL_OPTIONS}
                bind:value={
                    get: () => (evalKind === "eased" ? 0 : 1),
                    set: (v: number) =>
                        setEvalKind(v === 0 ? "eased" : "expression")
                }
            />
        </div>

        {#if evalKind === "expression"}
            <label class="field">
                <span>表达式</span>
                <input
                    class="num"
                    type="text"
                    placeholder="a * b"
                    bind:value={exprText}
                    onchange={commitExpression}
                />
            </label>
        {/if}
    </div>
</div>

{#if error}
    <p class="error">{error}</p>
{/if}

<div class="actions">
    <button class="btn danger" onclick={remove}>删除</button>
</div>

<style>
    .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .kind {
        font-size: 14px;
        opacity: 0.8;
    }

    .body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .col {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
        font-size: 12px;
        color: var(--text-dim);
    }

    .field input {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 8px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        appearance: none;
        -webkit-appearance: none;
    }

    .triple {
        display: flex;
        gap: 6px;
        min-width: 0;
    }

    .triple .num {
        flex: 1 1 0;
        min-width: 0;
        text-align: center;
    }

    .triple .sep {
        align-self: center;
        color: var(--text-dim);
        font-size: 13px;
        line-height: 1;
    }

    /* 开关的样式在组件里（Switch.grain） */

    .error {
        margin: 0;
        color: #ff7b72;
        font-size: 12px;
    }

    .actions {
        display: flex;
        gap: 10px;
    }

    .btn {
        flex: 1;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        cursor: pointer;
    }

    .btn.danger {
        color: #ff7b72;
        border-color: rgba(255, 123, 114, 0.45);
    }
</style>
