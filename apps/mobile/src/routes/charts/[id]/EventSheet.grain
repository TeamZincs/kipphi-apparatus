<script>
    /*
     * 事件节点面板（底部面板的内容部分）。
     *
     * 只给最常用的两项：时间、值。缓动 / 求值器 / 宏那一套桌面端才有完整 UI，
     * 手机上塞不下，先不做。
     */
    import {
        BezierEasing,
        Easing,
        EasedEvaluator,
        easingArray,
        ExpressionEvaluator,
        NormalEasing,
        NumericEasedEvaluator,
        Op,
        SegmentedEasing,
        TC,
        TemplateEasing
    } from "kipphi";

    import { EasingCanvas as EasingCanvasImpl } from "@kpa/canvas";

    import BezierEditor from "#/components/BezierEditor.grain";
    import EasingBox from "#/components/EasingBox.grain";
    import Segmented from "#/components/Segmented.grain";
    import Switch from "#/components/Switch.grain";

    import { operationList } from "#/store";
    import {
        beatsOf,
        formatTime,
        num,
        parseTime,
        splitBeats,
        toTime
    } from "#/time";

    let { node, editor, onclose } = $props<{
        node: any;
        editor: any;
        onclose: () => void;
    }>();

    let timeSingle = $state(false);
    let error = $state<string | null>(null);

    let beat = $state("0");
    let numerator = $state("0");
    let denominator = $state("1");
    let timeText = $state("");
    let value = $state("");

    /** 求值器只有两种：缓动 / 表达式（宏求值器留给桌面端） */
    const EVAL_OPTIONS: [number, string][] = [
        [0, "缓动"],
        [1, "表达式"]
    ];

    /**
     * 当前节点的求值器种类。
     *
     * `evaluator` 是普通对象字段，读它不产生编译期依赖 —— 靠 `operationList`
     * 的通知驱动重算（和 `$lsprop` 同一套）。
     */
    let evalKind = $state<"eased" | "expression">("eased");

    /** 表达式求值器的源码草稿（只在表达式模式下可编辑） */
    let exprText = $state("");

    /** 三种缓动并列（普通在最左，和桌面端 tabs 顺序一致） */
    const EASING_KINDS = ["normal", "bezier", "template"] as const;
    const EASING_OPTIONS: [number, string][] = [
        [0, "普通"],
        [1, "贝塞尔"],
        [2, "模板"]
    ];

    /**
     * 当前缓动属于哪一种（不是缓动求值器时是 `other`）。
     *
     * 用 `$state` 而不是 `$node`：这两个值决定模板里 `{#if}` 走哪一支，
     * `$node` 的通知只刷新它所在的那个槽位，分支切换时旧分支的组件 / 画布
     * 会留在 DOM 里（"切到表达式，缓动的控件还在"）。改成在 `pull()` 里赋值
     * 之后，分支切换和其它表单字段走同一条可靠的路径。
     */
    let easingKind = $state("normal");

    /** 贝塞尔控制点草稿：`(x1, y1)` 与 `(x2, y2)` */
    let cp1x = $state("0.25");
    let cp1y = $state("0.1");
    let cp2x = $state("0.25");
    let cp2y = $state("1");

    //#region 缓动曲线画布
    let curveCanvas: HTMLCanvasElement | null = null;
    /** 正在拖哪个把手 */
    let draggingCurve: "cp1" | "cp2" | null = null;
    const CURVE_PAD = 12;

    /** 三次贝塞尔：首尾固定 (0,0) / (1,1)，只由两个控制点决定 */
    function bezierAt(
        cp1: [number, number],
        cp2: [number, number],
        t: number
    ): [number, number] {
        const s = 1 - t;

        return [
            3 * cp1[0] * s * s * t + 3 * cp2[0] * s * t * t + t * t * t,
            3 * cp1[1] * s * s * t + 3 * cp2[1] * s * t * t + t * t * t
        ];
    }

    /**
     * 重画曲线。
     *
     * 整个函数包 try/catch：绘制出错只让画布空着，绝不打断面板渲染
     *（之前把绘制代码直接塞进面板，一次异常就把整块内容带没了）。
     */
    function drawCurve(): void {
        try {
            const canvas = curveCanvas;

            if (!canvas) return;

            const context = canvas.getContext("2d");

            if (!context) return;

            const rect = canvas.getBoundingClientRect();
            const width = Math.max(1, Math.round(rect.width));
            const height = Math.max(1, Math.round(rect.height));
            const ratio = window.devicePixelRatio || 1;

            canvas.width = Math.round(width * ratio);
            canvas.height = Math.round(height * ratio);
            context.setTransform(ratio, 0, 0, ratio, 0, 0);
            context.clearRect(0, 0, width, height);

            const left = CURVE_PAD;
            const right = width - CURVE_PAD;
            const bottom = height - CURVE_PAD;
            const top = CURVE_PAD;
            const toX = (t: number): number => left + t * (right - left);
            const toY = (v: number): number => bottom - v * (bottom - top);

            // 田字格
            context.strokeStyle = "rgba(255, 255, 255, 0.08)";
            context.lineWidth = 1;

            for (let i = 1; i < 4; i += 1) {
                const gridX = left + ((right - left) * i) / 4;
                const gridY = top + ((bottom - top) * i) / 4;

                context.beginPath();
                context.moveTo(gridX, top);
                context.lineTo(gridX, bottom);
                context.moveTo(left, gridY);
                context.lineTo(right, gridY);
                context.stroke();
            }

            const evaluator = node.evaluator;
            const easing =
                evaluator instanceof EasedEvaluator ? evaluator.easing : null;

            /*
             * 贝塞尔要画**草稿值**，不是对象上的旧值。
             *
             * 拖动过程中操作还没提交（松手才发），如果这里读 `easing.cp1`，
             * 每帧画的都是上一次提交后的曲线 —— 表现就是"拖了不跟手、
             * 松手才跳一下"。普通缓动没有草稿，照旧读对象。
             */
            const draft = [cp1x, cp1y, cp2x, cp2y].map((text) => Number(text));
            const useDraft =
                easing instanceof BezierEasing &&
                draft.every((value) => Number.isFinite(value));
            const cp1 = (
                useDraft ? [draft[0], draft[1]] : easing?.cp1
            ) as [number, number];
            const cp2 = (
                useDraft ? [draft[2], draft[3]] : easing?.cp2
            ) as [number, number];
            const steps = 48;

            context.strokeStyle = "#4c8dff";
            context.lineWidth = 2;
            context.beginPath();

            for (let i = 0; i <= steps; i += 1) {
                const t = i / steps;
                let px: number;
                let py: number;

                if (useDraft) {
                    const [x, y] = bezierAt(cp1, cp2, t);

                    px = toX(x);
                    py = toY(y);
                } else {
                    const v = easing ? easing.getValue(t) : t;

                    px = toX(t);
                    py = toY(v);
                }

                if (i === 0) context.moveTo(px, py);
                else context.lineTo(px, py);
            }

            context.stroke();

            if (!(easing instanceof BezierEasing)) return;

            // 把手：从端点连到控制点的一根线 + 一个圆
            // 把手也画草稿位置 —— 否则拖的时候圆点不跟着走
            const handles: [[number, number], [number, number]][] = [
                [[0, 0], cp1],
                [[1, 1], cp2]
            ];

            for (const [anchor, cp] of handles) {
                context.strokeStyle = "rgba(76, 141, 255, 0.5)";
                context.beginPath();
                context.moveTo(toX(anchor[0]), toY(anchor[1]));
                context.lineTo(toX(cp[0]), toY(cp[1]));
                context.stroke();

                context.fillStyle = "#4c8dff";
                context.beginPath();
                context.arc(toX(cp[0]), toY(cp[1]), 6, 0, Math.PI * 2);
                context.fill();
            }
        } catch {
            // 画不出来就空着，不影响面板本身
        }
    }

    /** 画布像素 → 归一化坐标（x 夹在 0..1，y 不夹） */
    function curvePoint(event: PointerEvent): [number, number] {
        const canvas = curveCanvas;

        if (!canvas) return [0, 0];

        const rect = canvas.getBoundingClientRect();
        const left = CURVE_PAD;
        const right = Math.max(left + 1, rect.width - CURVE_PAD);
        const bottom = Math.max(CURVE_PAD + 1, rect.height - CURVE_PAD);
        const top = CURVE_PAD;
        const x = (event.clientX - rect.left - left) / (right - left);
        const y = (bottom - (event.clientY - rect.top)) / (bottom - top);

        return [Math.min(1, Math.max(0, x)), y];
    }

    /** 按下：落在把手 24px 内才开始拖 */
    function onCurveDown(event: PointerEvent): void {
        const easing = node.evaluator?.easing;

        if (!(easing instanceof BezierEasing) || !curveCanvas) return;

        const rect = curveCanvas.getBoundingClientRect();
        const left = CURVE_PAD;
        const right = Math.max(left + 1, rect.width - CURVE_PAD);
        const bottom = Math.max(CURVE_PAD + 1, rect.height - CURVE_PAD);
        const top = CURVE_PAD;
        const near = (cp: [number, number]): boolean => {
            const px = left + cp[0] * (right - left);
            const py = bottom - cp[1] * (bottom - top);
            const dx = event.clientX - rect.left - px;
            const dy = event.clientY - rect.top - py;

            return dx * dx + dy * dy <= 24 * 24;
        };

        if (near(easing.cp1 as [number, number])) draggingCurve = "cp1";
        else if (near(easing.cp2 as [number, number])) draggingCurve = "cp2";
        else return;

        curveCanvas.setPointerCapture?.(event.pointerId);
        event.preventDefault();
    }

    function onCurveMove(event: PointerEvent): void {
        if (!draggingCurve) return;

        const [x, y] = curvePoint(event);
        const round = (value: number): string => String(Number(value.toFixed(3)));

        if (draggingCurve === "cp1") {
            cp1x = round(x);
            cp1y = round(y);
        } else {
            cp2x = round(x);
            cp2y = round(y);
        }

        event.preventDefault();
        drawCurve();
    }

    function onCurveUp(): void {
        if (!draggingCurve) return;

        draggingCurve = null;
        commitBezier();
    }
    //#endregion

    /** 从缓动切走时把 easing 记住 —— 切回来还是原来那条曲线 */
    let savedEasing: any = null;

    /** 四个控制点草稿 → 元组（模板里直接写数组字面量会被绑定值解析器拆坏） */
    const cpValue = (): number[] => [
        Number(cp1x),
        Number(cp1y),
        Number(cp2x),
        Number(cp2y)
    ];

    /** 普通缓动当前用的 `easingArray` 下标（预设表是共享的） */
    let normalId = $state(0);

    //#region 普通缓动的分段画布（共享包里的 EasingCanvas）
    let easeCanvasEl: HTMLCanvasElement | null = null;
    let easeEditor: any = null;

    /** 当前缓动对象（给画布用） */
    function currentEasing(): any {
        const evaluator = node.evaluator;

        return evaluator instanceof EasedEvaluator ? evaluator.easing : null;
    }

    /** 画布拖完左右边界 → 换成分段缓动 */
    function commitSegmented(next: any): void {
        const ops = operationList;

        if (!ops || !next) return;

        /*
         * 只有真正的 `Easing` 才能当求值器的底。
         *
         * 这里曾经把 `SegmentedEasing` 拆成 `.easing` 再包一层 `NumericEasedEvaluator`
         * —— 区间丢了不说，如果 `next` 不是缓动对象（比如画布还没画过、`detail`
         * 是空），就会把 `undefined` 写进 `node.evaluator`，
         * 后面 `getValueAt` 里 `this.evaluator.eval` 直接炸。
         */
        if (!(next instanceof Easing)) return;

        ops.do(
            new Op.EventNodeEvaluatorChangeOperation(
                node,
                new NumericEasedEvaluator(next)
            )
        );
    }

    /** 上一次绑定的元素（`{#if}` 换分支会换一个 canvas 元素） */
    let easeEditorEl: HTMLCanvasElement | null = null;

    /**
     * 建画布 / 同步内容。
     *
     * 元素身份变了就重建：`{#if}` 从贝塞尔切回普通时，canvas 是一个**新元素**，
     * 旧的 `easeEditor` 还指着已经卸载的那个 —— 只判断 `easeEditor` 是否为空
     * 会导致新画布永远没人画（表现就是"普通缓动里啥也没有"）。
     */
    function mountEasingCanvas(): void {
        const el = easeCanvasEl;

        if (!el) return;

        if (easeEditorEl !== el) {
            easeEditorEl = el;

            /*
             * 和桌面端完全一致：位图固定 300×600，`rect` 也用这个尺寸。
             * 画布里的坐标（把手位置、`elementMatrix`）全按这套算，
             * 用 CSS 的显示尺寸去建会把曲线压扁。
             */
            easeEditor = new EasingCanvasImpl(el, [0, 0, 300, 600]);
            easeEditor.addEventListener("change", (event: any) =>
                commitSegmented(event.detail)
            );
        }

        const easing = currentEasing();

        if (easing) easeEditor?.draw(easing);
    }
    //#endregion

    /** 换成预设表里的某一条普通缓动 */
    function setNormalId(id: number): void {
        const preset = easingArray[id];

        // 预设表里得真的是个 `Easing`，否则求值器会拿到空底
        if (!preset || !(preset instanceof Easing)) return;

        normalId = id;

        operationList?.do(
            new Op.EventNodeEvaluatorChangeOperation(
                node,
                new NumericEasedEvaluator(preset)
            )
        );
    }

    function pull(): void {
        beat = String(node.time[0]);
        numerator = String(node.time[1]);
        denominator = String(node.time[2]);
        timeText = formatTime(node.time);
        value = String(node.value);
        exprText =
            node.evaluator instanceof ExpressionEvaluator
                ? node.evaluator.jsExpr
                : "";

        const evaluator = node.evaluator;
        const easing =
            evaluator instanceof EasedEvaluator ? evaluator.easing : null;

        // 求值器 / 缓动种类：模板里的 `{#if}` 靠这两个值选分支
        evalKind = evaluator instanceof EasedEvaluator ? "eased" : "expression";

        if (easing instanceof BezierEasing) easingKind = "bezier";
        else if (easing instanceof NormalEasing) easingKind = "normal";
        else if (easing instanceof TemplateEasing) easingKind = "template";
        else easingKind = "other";

        if (easing instanceof BezierEasing) {
            cp1x = String(easing.cp1[0]);
            cp1y = String(easing.cp1[1]);
            cp2x = String(easing.cp2[0]);
            cp2y = String(easing.cp2[1]);
        }

        // 普通缓动：把当前预设的 id 同步回选择器（撤销 / 换节点之后才不会错位）
        const innerEasing =
            easing instanceof SegmentedEasing ? easing.easing : easing;

        if (innerEasing instanceof NormalEasing) {
            normalId = innerEasing.id;
        }

        // 曲线跟着重画（换分支时元素会变，交给 mount 判断重建）
        requestAnimationFrame(() => {
            drawCurve();
            mountEasingCanvas();
        });
    }

    pull();

    // 画布要等元素挂上去才有尺寸：下一个宏任务再建/画一次
    setTimeout(() => {
        drawCurve();
        mountEasingCanvas();
    }, 0);

    // 撤销 / 重做 / 别处改了同一个节点 → 回灌
    const onOperation = (): void => pull();

    operationList?.addEventListener("needsupdate", onOperation);

    function toggleTimeMode(): void {
        timeSingle = !timeSingle;

        if (timeSingle) {
            const beats = beatsOf(beat, numerator, denominator);

            timeText = Number.isFinite(beats) ? formatTime(toTime(beats)) : "";

            return;
        }

        const beats = parseTime(timeText);

        if (!Number.isFinite(beats)) return;

        const [b, n, d] = splitBeats(beats);

        beat = b;
        numerator = n;
        denominator = d;
    }

    function commit(): void {
        const ops = operationList;

        if (!ops) return;

        const beats = timeSingle
            ? parseTime(timeText)
            : beatsOf(beat, numerator, denominator);

        if (!Number.isFinite(beats)) {
            error = "时间格式不对（`3` / `3+1/4` / `3.25` 都行）";

            return;
        }

        const numeric = typeof node.value === "number";
        const next = numeric ? num(value) : value;

        if (numeric && !Number.isFinite(next)) {
            error = "值必须是数字";

            return;
        }

        error = null;

        const queue: any[] = [];

        if (Math.abs(beats - TC.toBeats(node.time)) > 1e-6)
            queue.push(new Op.EventNodeTimeChangeOperation(node, toTime(beats)));
        if (next !== node.value)
            queue.push(new Op.EventNodeValueChangeOperation(node, next));

        if (queue.length === 0) return;

        ops.tryDo(() =>
            queue.length === 1 ? queue[0] : new Op.ComplexOperation(...queue)
        );
    }

    /** 切换求值器：缓动 ↔ 表达式（各自保留已有配置） */
    function setEvalKind(kind: string): void {
        const ops = operationList;

        if (!ops) return;

        const current = node.evaluator;
        const eased = current instanceof EasedEvaluator;

        if ((kind === "eased") === eased) return;

        error = null;

        if (kind === "eased") {
            const easing = savedEasing ?? new NormalEasing((t: number) => t);

            ops.do(
                new Op.EventNodeEvaluatorChangeOperation(
                    node,
                    new NumericEasedEvaluator(easing)
                )
            );

            return;
        }

        if (eased) savedEasing = (current as any).easing;

        ops.do(
            new Op.EventNodeEvaluatorChangeOperation(
                node,
                new ExpressionEvaluator(exprText.trim() || "1")
            )
        );
    }

    /**
     * 贝塞尔控制点写回。
     *
     * 只接受 x ∈ [0, 1]（超出会让曲线在时间轴上折返）；y 不限制。
     * 值没变就不发操作。
     */
    function commitBezier(): void {
        const ops = operationList;

        if (!ops) return;

        const values = [cp1x, cp1y, cp2x, cp2y].map((text) => Number(text));

        if (!values.every((value) => Number.isFinite(value))) {
            error = "控制点必须是数字";

            return;
        }

        const [x1, y1, x2, y2] = values as [number, number, number, number];

        if (x1 < 0 || x1 > 1 || x2 < 0 || x2 > 1) {
            error = "控制点的 x 必须在 0 到 1 之间";

            return;
        }

        const current = node.evaluator?.easing;

        if (current instanceof BezierEasing) {
            const same =
                current.cp1[0] === x1 &&
                current.cp1[1] === y1 &&
                current.cp2[0] === x2 &&
                current.cp2[1] === y2;

            if (same) return;
        }

        error = null;

        ops.do(
            new Op.EventNodeEvaluatorChangeOperation(
                node,
                new NumericEasedEvaluator(new BezierEasing([x1, y1], [x2, y2]))
            )
        );
    }

    /**
     * 切换缓动种类。
     *
     * 贝塞尔 / 普通都能凭空造出来（默认控制点、线性），模板不行 ——
     * 它得引用谱面里的模板缓动，手机上还没做那个管理界面，所以先拒绝并提示。
     */
    function setEasingKind(kind: string): void {
        const ops = operationList;

        if (!ops || kind === easingKind) return;

        if (kind === "template") {
            error = "谱面里还没有可选的模板缓动";

            return;
        }

        error = null;

        const easing =
            kind === "bezier"
                ? new BezierEasing([0.25, 0.1], [0.25, 1])
                : new NormalEasing((t: number) => t);

        ops.do(
            new Op.EventNodeEvaluatorChangeOperation(
                node,
                new NumericEasedEvaluator(easing)
            )
        );
    }

    /** 表达式源码写回（只有表达式求值器才有这回事） */
    function commitExpression(): void {
        const ops = operationList;

        if (!ops) return;

        const current = node.evaluator;

        if (!(current instanceof ExpressionEvaluator)) return;

        const next = exprText.trim() || "1";

        if (next === current.jsExpr) return;

        ops.do(
            new Op.EventNodeEvaluatorChangeOperation(
                node,
                new ExpressionEvaluator(next)
            )
        );
    }

    function remove(): void {
        if (!operationList) return;

        try {
            operationList.do(new Op.EventNodePairRemoveOperation(node));
        } catch {
            // 头 / 尾节点不能单独删
            error = "这个节点不能单独删除";

            return;
        }

        editor?.draw();
        onclose();
    }
</script>

<div class="head">
    <span class="kind">事件节点</span>

    <Switch
        bind:checked={
            get: () => timeSingle,
            set: (v: boolean) => {
                if (v === timeSingle) return;
                toggleTimeMode();
            }
        }
    />
</div>

<div class="body" onchange={commit} onblur={commit}>
    <div class="col">
        <div class="field">
            <span>时间</span>
            {#if timeSingle}
                <input class="num" type="text" placeholder="3:1/4" bind:value={timeText} />
            {:else}
                <div class="triple">
                    <input class="num" type="text" inputmode="numeric" placeholder="拍" bind:value={beat} />
                    <span class="sep">:</span>
                    <input class="num" type="text" inputmode="numeric" placeholder="分子" bind:value={numerator} />
                    <span class="sep">/</span>
                    <input class="num" type="text" inputmode="numeric" placeholder="分母" bind:value={denominator} />
                </div>
            {/if}
        </div>
    </div>

    <div class="col">
        <label class="field">
            <span>值</span>
            <input type="text" bind:value={value} />
        </label>
    </div>
</div>

<!--
    求值器通栏：占满面板宽度，不和"时间 / 值"挤在同一列里。
    里面依次是：求值器种类 → 表达式源码 / 缓动种类 → 贝塞尔控制点。
-->
<div class="eval" onchange={commit} onblur={commit}>
    <div class="field">
        <span>求值器</span>
        <Segmented
            options={EVAL_OPTIONS}
            bind:value={
                get: () => (evalKind === "eased" ? 0 : 1),
                set: (v: number) => setEvalKind(v === 0 ? "eased" : "expression")
            }
        />
    </div>

    {#if evalKind === "expression"}
        <label class="field">
            <span>表达式</span>
            <input
                class="num"
                type="text"
                placeholder="a * b"
                bind:value={exprText}
                onchange={commitExpression}
            />
        </label>
    {:else}
        <div class="field">
            <span>缓动</span>
            <Segmented
                options={EASING_OPTIONS}
                bind:value={
                    get: () => EASING_KINDS.indexOf(easingKind),
                    set: (v: number) =>
                        setEasingKind(EASING_KINDS[v] ?? "other")
                }
            />
        </div>

        {#if easingKind === "bezier"}
            <!-- 画布与四个控制点都在组件里（画布本体来自 `@kpa/canvas`） -->
            <BezierEditor
                bind:value={
                    get: () => cpValue(),
                    set: (v: number[]) => {
                        cp1x = String(v[0]);
                        cp1y = String(v[1]);
                        cp2x = String(v[2]);
                        cp2y = String(v[3]);
                        commitBezier();
                    }
                }
            />
        {:else if easingKind === "normal"}
            <!-- 普通缓动：序号 / 方向 / 函数，和桌面端 EasingBox 同一套数据 -->
            <EasingBox
                bind:value={
                    get: () => normalId,
                    set: (v: number) => setNormalId(v)
                }
            />

            <!-- 分段画布：拖左右边界产生 SegmentedEasing（共享包的 EasingCanvas） -->
            <canvas
                class="curve seg"
                width="300"
                height="600"
                bind:this={easeCanvasEl}
            ></canvas>
        {:else if easingKind === "template"}
            <p class="hint">模板缓动：跟谱面的模板走，只在桌面端编辑</p>
        {:else}
            <p class="hint">这个节点的缓动类型还没识别</p>
        {/if}
    {/if}
</div>

{#if error}
    <p class="error">{error}</p>
{/if}

<div class="actions">
    <button class="btn danger" onclick={remove}>删除</button>
</div>

<style>
    .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .kind {
        font-size: 14px;
        opacity: 0.8;
    }

    /*
     * 两列不再吃"剩余空间"：面板是 `max-height: 60vh` 的自动高度容器，
     * `flex: 1` + `min-height: 0` 在内容超高时会把这一块压成 0 高，
     * 里面的输入框就"看不见"了（不报错，就是高度为 0）。
     * 现在按内容自然排，超高由下面的 `.eval` 各自滚动。
     */
    .body {
        flex: 0 0 auto;
        width: 100%;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .col {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* 求值器通栏：与上面两列分开，占满面板宽度；高度按内容，不参与压缩 */
    .eval {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 100%;
        padding-top: 8px;
        border-top: 1px solid var(--border);
    }

    .hint {
        margin: 0;
        font-size: 12px;
        color: var(--text-dim);
    }

    /* 贝塞尔四个控制点：一行四个等宽框 */
    .quad {
        display: flex;
        gap: 6px;
        min-width: 0;
    }

    /* 四个控制点不在 `.field` 里，样式要自己写一份（和 `.field input` 一致） */
    .quad .num {
        flex: 1 1 0;
        min-width: 0;
        box-sizing: border-box;
        padding: 8px 6px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        text-align: center;
        appearance: none;
        -webkit-appearance: none;
    }

    /* 缓动曲线画布 */
    .curve {
        display: block;
        width: 100%;
        height: 140px;
        box-sizing: border-box;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        touch-action: none;
    }

    /*
     * 分段缓动那张：位图是 300×600，**必须按 1:2 显示**，
     * 用 `width:100%` 会被拉成扁平（曲线和把手都变形）。
     */
    /*
     * 分段缓动那张：位图 300×600（1:2），显示宽度至少 60vw，
     * 高度按比例就是 120vw —— 面板放不下时由骨架内部滚动。
     */
    .curve.seg {
        width: 60vw;
        height: 120vw;
        margin: 0 auto;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
        font-size: 12px;
        color: var(--text-dim);
    }

    .field input {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 8px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        appearance: none;
        -webkit-appearance: none;
    }

    .triple {
        display: flex;
        gap: 6px;
        min-width: 0;
    }

    .triple .num {
        flex: 1 1 0;
        min-width: 0;
        text-align: center;
    }

    .triple .sep {
        align-self: center;
        color: var(--text-dim);
        font-size: 13px;
        line-height: 1;
    }

    /* 开关的样式在组件里（Switch.grain） */

    .error {
        margin: 0;
        color: #ff7b72;
        font-size: 12px;
    }

    .actions {
        display: flex;
        gap: 10px;
    }

    .btn {
        flex: 1;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        cursor: pointer;
    }

    .btn.danger {
        color: #ff7b72;
        border-color: rgba(255, 123, 114, 0.45);
    }
</style>
