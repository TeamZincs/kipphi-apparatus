<script>
    /*
     * 判定线列表：工具栏（布局下拉框）+ 三种布局的容器。
     *
     * 每一行都是递归组件 `JudgeLineRow`（含子树），跟桌面端
     * `JudgeLinesManager` → `JudgeLineManager` 的结构一致。
     */
    import Select from "#/components/Select.grain";

    import { chart, chartLoaded, registerReflow } from "#/store";

    import JudgeLineRow from "./JudgeLineRow.grain";

    /** 三种布局，跟桌面端 `JudgeLinesManager` 一致 */
    type Layout = "ordered" | "tree" | "grouped";

    let layout = $state<Layout>("ordered");
    let foldedGroups = $state<string[]>([]);

    const layoutOptions = [
        { value: "ordered", label: "顺序" },
        { value: "tree", label: "树形" },
        { value: "grouped", label: "分组" }
    ];

    /*
     * 注意：`listen` 必须**内联成箭头函数**。
     * 编译器只认 `listen: (update) => …` 这种字面写法，写成
     * `listen: someConst` 会被直接丢掉（产物里 $node 就只剩 get，
     * 于是谱面加载完也不会重算 —— 列表永远是空的）。
     */

    /** 顺序：平铺，不展开子线 */
    const orderedLines = $node({
        get: () => (chart ? [...chart.judgeLines].sort((a, b) => a.id - b.id) : []),
        listen: (update) => {
            chartLoaded.subscribe(update);
            registerReflow(update);
        }
    });

    /** 树形：只给根判定线，子线由行组件自己递归 */
    const treeLines = $node({
        get: () => (chart ? [...chart.orphanLines].sort((a, b) => a.id - b.id) : []),
        listen: (update) => {
            chartLoaded.subscribe(update);
            registerReflow(update);
        }
    });

    /** 分组 */
    const groups = $node({
        get: () => (chart ? [...chart.judgeLineGroups] : []),
        listen: (update) => {
            chartLoaded.subscribe(update);
            registerReflow(update);
        }
    });

    function toggleGroup(name: string): void {
        foldedGroups = foldedGroups.includes(name)
            ? foldedGroups.filter((item) => item !== name)
            : [...foldedGroups, name];
    }

    /**
     * 组标题的点击走**事件委托**。
     *
     * 不在 `{#for}` 里直接写 `onclick={() => toggleGroup(group.name)}`：编译器对
     * `{#for}` 内的事件处理器会生成 `__handler$N` 并要求把定义填回行内的占位符，
     * 但那个占位符（`/*@row:N*\/`）目前没有写入点，定义被丢掉之后就成了
     * `ReferenceError: __handler$N is not defined`。
     */
    function onListClick(event: MouseEvent): void {
        const element = (event.target as HTMLElement).closest<HTMLElement>("[data-group]");

        if (!element) return;

        const name = element.dataset.group;

        if (name !== undefined) toggleGroup(name);
    }
</script>

<div class="pane">
    <div class="toolbar">
        <span class="hint">布局</span>
        <Select options={layoutOptions} bind:value={layout} />
    </div>

    <div class="list" onclick={onListClick}>
        {#if layout === "ordered"}
            {#for line of orderedLines with key = line}
                <JudgeLineRow target={line} flat />
            {/for}
        {:else if layout === "tree"}
            {#for line of treeLines with key = line}
                <JudgeLineRow target={line} />
            {/for}
        {:else}
            {#for group of groups with key = group}
                <div class="group" data-group={group.name}>
                    <span class="caret {foldedGroups.includes(group.name) ? 'folded' : ''}">▾</span>
                    <span class="group-name">{group.name}</span>
                    <span class="count">{group.judgeLines.length}</span>
                </div>

                {#if !foldedGroups.includes(group.name)}
                    {#for line of group.judgeLines with key = line}
                        <JudgeLineRow target={line} level={1} />
                    {/for}
                {/if}
            {/for}
        {/if}
    </div>
</div>

<style>
.pane {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
}

.toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
}

.hint {
    color: var(--text-dim);
    font-size: 12px;
}

.list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0;
}

.group {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 12px;
}

.group-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.count {
    color: var(--text-dim);
}

.caret {
    flex: none;
    width: 14px;
    font-size: 11px;
    text-align: center;
    transition: transform 0.15s ease;
}

.caret.folded {
    transform: rotate(-90deg);
}
</style>
