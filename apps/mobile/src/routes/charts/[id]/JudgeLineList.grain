<script>
    import { chart, chartLoaded, operationList, selectedLineId } from "#/store";

    const lines = $node({
        get: () => (chart ? [...chart.judgeLines] : []),
        listen: (update) => {
            // 谱面是异步加载的（`chart` 只是个 let，赋值不会通知任何人），
            // 靠这个信号重算一次；之后增删判定线走 operationList 的 needsreflow
            chartLoaded.subscribe(update);
            operationList?.addEventListener("needsreflow", update);
        }
    });

    const currentId = $node({
        get: () => selectedLineId.get(),
        listen: (update) => selectedLineId.subscribe(update)
    });

    function pick(id: number) {
        selectedLineId.set(id);
    }
</script>

<div class="list">
    {#for line of lines with key = line}
        <button class="row {line.id === currentId ? 'active' : ''}" onclick={() => pick(line.id)}>
            <span class="id">#{line.id}</span>
            <span class="name">{line.name ?? ""}</span>
        </button>
    {/for}
</div>

<style>
.list {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    overflow-y: auto;
    height: 100%;
    overscroll-behavior: contain;
}

.row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    text-align: left;
}

.row.active {
    border-color: var(--accent);
    background: var(--surface-2);
}

.id {
    color: var(--text-dim);
    font-size: 12px;
    min-width: 34px;
}

.name {
    font-size: 14px;
}
</style>
