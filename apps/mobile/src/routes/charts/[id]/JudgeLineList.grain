<script>
    import { Op, type JudgeLine } from "kipphi";

    import Select from "#/components/Select.grain";

    import { chart, chartLoaded, operationList, playbackTick, selectedLineId } from "#/store";

    /**
     * 三种布局，跟桌面端 `JudgeLinesManager` 一致：
     *   ordered —— `chart.judgeLines` 平铺（不展开子判定线）
     *   tree    —— 从 `orphanLines` 递归展开 children
     *   grouped —— 按 `judgeLineGroups` 分组
     */
    type Layout = "ordered" | "tree" | "grouped";

    interface Row {
        kind: "line" | "group";
        id?: number;
        text: string;
        level: number;
        /** 树形：有没有子判定线（决定显不显示折叠三角） */
        hasChildren?: boolean;
        folded?: boolean;
        /** 组的成员数 */
        count?: number;
        x?: string;
        y?: string;
        rotate?: string;
        alpha?: string;
        speed?: string;
    }

    /** 两个按钮的总宽（要和 CSS 里 `.row.open` 的位移一致） */
    const ACTION_WIDTH = 132;
    /** 滑过这个距离就停成展开态（越小越容易呼出） */
    const OPEN_THRESHOLD = 28;

    let layout = $state<Layout>("ordered");

    /** 折叠起来的判定线 id 与组名（用数组，改了直接换引用才能触发刷新） */
    let foldedIds = $state<number[]>([]);
    let foldedGroups = $state<string[]>([]);

    /** 当前左滑展开操作的那一行 */
    let openId = $state<number | null>(null);
    let dragId: number | null = null;
    /** 普通变量：拖拽过程中不要触发任何重渲染（位移是直接写 DOM 的） */
    let dragOffset = 0;
    let dragStartX = 0;
    let dragStartY = 0;
    /** 这一次手势是不是竖向滚动（是的话就不做左滑） */
    let vertical = false;
    /** 滑动结束后紧跟的那次 click 要吞掉（否则刚滑开就被自己关掉） */
    let suppressClick = false;

    const layoutOptions = [
        { value: "ordered", label: "顺序" },
        { value: "tree", label: "树形" },
        { value: "grouped", label: "分组" }
    ];

    const byId = (a: JudgeLine, b: JudgeLine) => a.id - b.id;

    const num = (value: number | undefined, digits = 1): string =>
        typeof value === "number" && Number.isFinite(value) ? value.toFixed(digits) : "—";

    const stats = (line: JudgeLine) => ({
        x: num(line.moveX),
        y: num(line.moveY),
        rotate: num(((line.rotate ?? 0) * 180) / Math.PI),
        alpha: num(line.alpha, 0),
        speed: num(line.speed)
    });

    /** 树形：从根判定线往下递归，遇到折叠的就不往下走 */
    function walk(lines: Iterable<JudgeLine>, level: number, out: Row[]): void {
        for (const line of [...lines].sort(byId)) {
            const children = [...line.children];
            const folded = foldedIds.includes(line.id);

            out.push({
                kind: "line",
                id: line.id,
                text: line.name ?? "",
                level,
                hasChildren: children.length > 0,
                folded,
                ...stats(line)
            });

            if (!folded && children.length > 0) walk(children, level + 1, out);
        }
    }

    const rows = $node({
        get: () => {
            const target = chart;
            const out: Row[] = [];

            if (!target) return out;

            if (layout === "ordered") {
                for (const line of [...target.judgeLines].sort(byId)) {
                    out.push({ kind: "line", id: line.id, text: line.name ?? "", level: 0, ...stats(line) });
                }
            } else if (layout === "tree") {
                walk(target.orphanLines, 0, out);
            } else {
                for (const group of target.judgeLineGroups) {
                    const folded = foldedGroups.includes(group.name);

                    out.push({
                        kind: "group",
                        text: group.name,
                        level: 0,
                        count: group.judgeLines.length,
                        folded
                    });

                    if (folded) continue;

                    for (const line of group.judgeLines) {
                        out.push({ kind: "line", id: line.id, text: line.name ?? "", level: 1, ...stats(line) });
                    }
                }
            }

            return out;
        },
        listen: (update) => {
            // 谱面是异步加载的（`chart` 只是个 let，赋值不会通知任何人）
            chartLoaded.subscribe(update);
            // 播放时 x / y / θ / α / 速度都在变，跟着页面的节流信号重算
            playbackTick.subscribe(update);
            operationList?.addEventListener("needsreflow", update);
        }
    });

    const currentId = $node({
        get: () => selectedLineId.get(),
        listen: (update) => selectedLineId.subscribe(update)
    });

    function pick(id: number): void {
        // 刚滑开（或刚收起）时那次 click 不能当成"点选"，否则一滑就被立刻关掉
        if (suppressClick) {
            suppressClick = false;

            return;
        }

        if (openId !== null) {
            openId = null;

            return;
        }

        selectedLineId.set(id);
    }

    function toggleFold(id: number): void {
        foldedIds = foldedIds.includes(id) ? foldedIds.filter((item) => item !== id) : [...foldedIds, id];
    }

    function toggleGroup(name: string): void {
        foldedGroups = foldedGroups.includes(name)
            ? foldedGroups.filter((item) => item !== name)
            : [...foldedGroups, name];
    }

    //#region 左滑露出操作
    /**
     * 拖拽期间**直接改 DOM**，不经过响应式状态：
     * 每次 pointermove 走一遍状态会让整个列表重渲染，手指就跟不上了。
     * 松手时清掉内联样式，交给 `.row.open` 的 `transition` 做动画。
     */
    let dragElement: HTMLElement | null = null;

    function onRowDown(event: PointerEvent, id: number): void {
        dragId = id;
        dragStartX = event.clientX;
        dragStartY = event.clientY;
        dragOffset = 0;
        vertical = false;
        dragElement = event.currentTarget as HTMLElement;

        // 拖的时候不要过渡，否则跟手有延迟
        if (dragElement) dragElement.style.transition = "none";
    }

    function onRowMove(event: PointerEvent, id: number): void {
        if (dragId !== id || !dragElement) return;

        const dx = Math.min(0, event.clientX - dragStartX);
        const dy = event.clientY - dragStartY;

        // 先判方向：竖着滑是要滚列表，不要让行跟着动
        if (!vertical && dragOffset === 0 && Math.abs(dy) > Math.abs(dx) + 4) {
            vertical = true;
        }

        if (vertical) return;

        dragOffset = Math.max(-ACTION_WIDTH, dx);
        dragElement.style.transform = `translateX(${dragOffset}px)`;
    }

    function onRowUp(id: number): void {
        if (dragId !== id) return;

        const scrolled = vertical;

        // 稍微滑一点就算"滑过"，免得和小幅抖动打架
        if (dragOffset < -6) suppressClick = true;

        if (dragElement) {
            // 内联的 transition / transform 都撤掉，让 `.open` 的过渡接管
            dragElement.style.transition = "";
            dragElement.style.transform = "";
        }

        if (!scrolled) openId = dragOffset < -OPEN_THRESHOLD ? id : null;

        dragId = null;
        dragElement = null;
        dragOffset = 0;
        vertical = false;
    }

    function removeLine(id: number): void {
        const line = chart?.judgeLines.find((item) => item.id === id);

        if (!line || !operationList) return;

        operationList.do(new Op.JudgeLineDeleteOperation(line));
        openId = null;
    }

    /** 预留：判定线设定面板还没做 */
    function openSettings(): void {
        openId = null;
    }

    //#endregion
</script>

<div class="pane">
    <div class="toolbar">
        <span class="hint">布局</span>
        <Select options={layoutOptions} bind:value={layout} />
    </div>

    <div class="list">
        {#for row of rows with key = row}
            {#if row.kind === "group"}
                <div class="group" onclick={() => toggleGroup(row.text)}>
                    <span class="caret {row.folded ? 'folded' : ''}">▾</span>
                    <span class="group-name">{row.text}</span>
                    <span class="count">{row.count}</span>
                </div>
            {:else}
                <div class="item">
                    <div class="actions">
                        <button class="action settings" onclick={openSettings}>设定</button>
                        <button class="action danger" onclick={() => removeLine(row.id)}>删除</button>
                    </div>

                    <div
                        class="row {row.id === currentId ? 'active' : ''} {openId === row.id ? 'open' : ''}"
                        style="padding-left: {12 + row.level * 16}px"
                        onpointerdown={(event) => onRowDown(event, row.id)}
                        onpointermove={(event) => onRowMove(event, row.id)}
                        onpointerup={() => onRowUp(row.id)}
                        onpointercancel={() => onRowUp(row.id)}
                        onclick={() => pick(row.id)}
                    >
                        <span
                            class="caret {row.folded ? 'folded' : ''} {row.hasChildren ? '' : 'hidden'}"
                            onclick={(event) => {
                                event.stopPropagation();
                                toggleFold(row.id);
                            }}
                        >▾</span>

                        <span class="id">#{row.id}</span>
                        <span class="name">{row.text}</span>

                        <!-- 状态紧跟在名字右边；挤不下时只有这些数值折行，名字不缩不折 -->
                        <span class="stats">
                            <span>x {row.x}</span>
                            <span>y {row.y}</span>
                            <span>θ {row.rotate}°</span>
                            <span>α {row.alpha}</span>
                            <span>v {row.speed}</span>
                        </span>
                    </div>
                </div>
            {/if}
        {/for}
    </div>
</div>

<style>
.pane {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
}

.toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
}

.hint {
    color: var(--text-dim);
    font-size: 12px;
}

.list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0;
}

.group {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 12px;
}

.group-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.count {
    color: var(--text-dim);
}

/* 一行：下面垫着操作按钮，内容层左滑露出 */
.item {
    position: relative;
    overflow: hidden;
    background: var(--bg);
}

.actions {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
}

.action {
    width: 66px;
    border: none;
    border-radius: 0;
    font-size: 13px;
    color: #fff;
}

.action.settings {
    background: #6b7280;
}

.action.danger {
    background: #d9534f;
}

.row {
    position: relative;
    display: flex;
    /* 名字不换行；要折的是右边那串状态 */
    flex-wrap: nowrap;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    touch-action: pan-y;
    transition: transform 0.16s ease;
    will-change: transform;
}

.row.active {
    background: var(--surface-2);
    box-shadow: inset 3px 0 0 var(--accent);
}

/* 展开操作：位移交给过渡做动画（132px = 两个按钮宽） */
.row.open {
    transform: translateX(-132px);
}

.caret {
    flex: none;
    width: 14px;
    color: var(--text-dim);
    font-size: 11px;
    text-align: center;
    transition: transform 0.15s ease;
}

.caret.folded {
    transform: rotate(-90deg);
}

.caret.hidden {
    visibility: hidden;
}

.id {
    color: var(--text-dim);
    font-size: 12px;
    flex: none;
}

/* 线号 + 线名是最重要的信息：保持原字号，不收缩、不折行 */
.name {
    flex: 0 0 auto;
    font-size: 14px;
    white-space: nowrap;
}

/* 状态跟着名字后面，空间不够时**这一块内部**折行 */
.stats {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 8px;
    color: var(--text-dim);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
}
</style>
