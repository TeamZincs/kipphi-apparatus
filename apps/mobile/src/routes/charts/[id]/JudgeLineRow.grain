<script>
    /*
     * 一条判定线（递归组件）：桌面端 `JudgeLineManager.grain` 的移动端版本。
     *
     * 子判定线直接 `<Self>` 递归渲染，不再像之前那样把树拍平成数组。
     */
    import { Op, type JudgeLine } from "kipphi";

    import Self from "./JudgeLineRow.grain";

    import {
        chart,
        chartLoaded,
        openLineId,
        operationList,
        reflowAll,
        registerRefresh,
        selectedLineId
    } from "#/store";

    let {
        target,
        level = 0,
        /** 平铺模式：不展开子判定线（顺序 / 分组布局用）*/
        flat = false,
        /** 父级折叠时置 false，整棵子树隐藏 */
        show = true
    } = $props<{
        target: JudgeLine;
        level?: number;
        flat?: boolean;
        show?: boolean;
    }>();

    //#region 状态数值：钩子里从 target 读，不用 refreshKey 那套
    let moveX = $state(target.moveX);
    let moveY = $state(target.moveY);
    let rotate = $state(target.rotate);
    let alpha = $state(target.alpha);
    let speed = $state(target.speed);

    /** 刷新钩子（`refreshAll()` 时被调用，见 store 的 registerRefresh） */
    function refreshValues(): void {
        moveX = target.moveX;
        moveY = target.moveY;
        rotate = target.rotate;
        alpha = target.alpha;
        speed = target.speed;
    }

    registerRefresh(refreshValues);
    //#endregion

    let folded = $state(false);

    /** 子判定线（按 id 排序）；内容没变就返回同一份，别每次都造新数组 */
    let lastSource: JudgeLine[] = [];
    let lastSorted: JudgeLine[] = [];

    const childRows = $node({
        get: () => {
            const source = [...target.children];

            if (source.length === lastSource.length && source.every((child, index) => child === lastSource[index])) {
                return lastSorted;
            }

            lastSource = source;
            lastSorted = [...source].sort((a, b) => a.id - b.id);

            return lastSorted;
        },
        // 增删子线 / 换父子关系后要重算（同样必须内联成箭头函数）
        listen: (update) => {
            chartLoaded.subscribe(update);
            registerReflow(update);
        }
    });

    const selected = $node({
        get: () => selectedLineId.get() === target.id,
        listen: (update) => selectedLineId.subscribe(update)
    });

    const open = $node({
        get: () => openLineId.get() === target.id,
        listen: (update) => openLineId.subscribe(update)
    });

    function pick(): void {
        if (suppressClick) {
            suppressClick = false;

            return;
        }

        if (open) {
            closeSelf();

            return;
        }

        selectedLineId.set(target.id);
    }

    function toggleFold(event: MouseEvent): void {
        event.stopPropagation();
        folded = !folded;
    }

    //#region 左滑：按钮从右侧滑入，id/名字向左小幅让位
    const ACTION_WIDTH = 132;
    const BASE_DURATION = 160;
    const MAX_DURATION = 320;
    const OPEN_PROGRESS = 0.35;
    const EASE = "cubic-bezier(0.22, 0.61, 0.36, 1)";

    let item: HTMLDivElement;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let startProgress = 0;
    let progress = 0;
    let vertical = false;
    let suppressClick = false;
    let lastX = 0;
    let lastTime = 0;
    let velocity = 0;

    function parts() {
        return {
            actions: item?.querySelector<HTMLElement>(".actions") ?? null,
            head: item?.querySelector<HTMLElement>(".head") ?? null
        };
    }

    function paint(value: number): void {
        const { actions, head } = parts();

        if (actions) actions.style.transform = `translateX(${(1 - value) * 100}%)`;
        if (head) head.style.transform = `translateX(${-value * 8}px)`;
    }

    function clearInline(): void {
        const { actions, head } = parts();

        if (actions) actions.style.transform = "";
        if (head) head.style.transform = "";
    }

    /**
     * 从当前进度动画到目标进度。
     *
     * 时长 `max(基础时长, 剩余距离 / 速度)`：慢拖松手时按速度算出来的更长，
     * 不会"啪"一下跳过去；快甩时更短、跟手。
     */
    function animateProgress(from: number, to: number, speedOfDrag: number): void {
        const remaining = Math.abs(to - from) * ACTION_WIDTH;
        const derived = speedOfDrag > 0.05 ? remaining / speedOfDrag : MAX_DURATION;
        const duration = Math.min(MAX_DURATION, Math.max(BASE_DURATION, derived));
        const { actions, head } = parts();
        const options: KeyframeAnimationOptions = { duration, easing: EASE };

        clearInline();

        actions?.animate(
            [
                { transform: `translateX(${(1 - from) * 100}%)` },
                { transform: `translateX(${(1 - to) * 100}%)` }
            ],
            options
        );

        head?.animate(
            [{ transform: `translateX(${-from * 8}px)` }, { transform: "translateX(0px)" }],
            options
        );
    }

    function closeSelf(): void {
        if (openLineId.get() !== target.id) return;

        openLineId.set(null);
        animateProgress(1, 0, 0);
    }

    function onRowDown(event: PointerEvent): void {
        // 滑别的行时，当前展开的那行立刻收回
        const currentOpen = openLineId.get();

        if (currentOpen !== null && currentOpen !== target.id) openLineId.set(null);

        dragging = true;
        startX = event.clientX;
        startY = event.clientY;
        startProgress = currentOpen === target.id ? 1 : 0;
        progress = startProgress;
        vertical = false;
        velocity = 0;
        suppressClick = false;
        lastX = event.clientX;
        lastTime = performance.now();

        paint(progress);
    }

    function onRowMove(event: PointerEvent): void {
        if (!dragging) return;

        const dx = event.clientX - startX;
        const dy = event.clientY - startY;

        if (!vertical && Math.abs(dy) > Math.abs(dx) + 4) {
            vertical = true;
            paint(startProgress);

            return;
        }

        if (vertical) return;

        const now = performance.now();
        const elapsed = Math.max(1, now - lastTime);

        velocity = (event.clientX - lastX) / elapsed;
        lastX = event.clientX;
        lastTime = now;

        progress = Math.min(1, Math.max(0, startProgress - dx / ACTION_WIDTH));
        paint(progress);
    }

    function onRowUp(): void {
        if (!dragging) return;

        const scrolled = vertical;
        const speedOfDrag = Math.abs(velocity);

        if (Math.abs(progress - startProgress) > 0.03) suppressClick = true;

        dragging = false;
        vertical = false;

        if (scrolled) {
            paint(startProgress);

            return;
        }

        // 甩得快就按方向定，否则看是否过半
        const willOpen = speedOfDrag > 0.5 ? velocity < 0 : progress > OPEN_PROGRESS;

        openLineId.set(willOpen ? target.id : null);
        animateProgress(progress, willOpen ? 1 : 0, speedOfDrag);
    }

    /** 预留：判定线设定面板还没做 */
    function openSettings(): void {
        openLineId.set(null);
    }

    function removeLine(): void {
        // 有子判定线的先不让删（删了子线会失去父级）
        if (!chart || !operationList || target.children.size > 0) return;

        operationList.do(new Op.JudgeLineDeleteOperation(chart, target));

        // 删除会连带改后面所有线的 id，直接要一次全量回流
        openLineId.set(null);
        reflowAll();
    }
    //#endregion
</script>

<div
    class="item {open ? 'open' : ''}"
    style="display: {show ? '' : 'none'}"
    bind:this={item}
>
    <div class="actions">
        <button class="action settings" onclick={openSettings}>设定</button>
        <button
            class="action danger {target.children.size > 0 ? 'disabled' : ''}"
            onclick={removeLine}
        >删除</button>
    </div>

    <div
        class="row {selected ? 'active' : ''}"
        style="padding-left: {12 + level * 16}px"
        onpointerdown={onRowDown}
        onpointermove={onRowMove}
        onpointerup={onRowUp}
        onpointercancel={onRowUp}
        onclick={pick}
    >
        <span
            class="caret {folded ? 'folded' : ''} {!flat && childRows.length > 0 ? '' : 'hidden'}"
            onclick={toggleFold}
        >▾</span>

        <span class="head">
            <span class="id">#{target.id}</span>
            <span class="name">{target.name ?? ""}</span>
        </span>

        <span class="stats">
            <span>x {moveX?.toFixed?.(1) ?? "—"}</span>
            <span>y {moveY?.toFixed?.(1) ?? "—"}</span>
            <span>θ {rotate !== undefined ? ((rotate * 180) / Math.PI).toFixed(1) : "—"}°</span>
            <span>α {alpha !== undefined ? Math.round(alpha) : "—"}</span>
            <span>v {speed?.toFixed?.(1) ?? "—"}</span>
        </span>
    </div>
</div>

{#if !flat && childRows.length > 0}
    <!-- 用判定线对象当 key：行复用时不会因为数组重建而整片重刷 -->
    {#for child of childRows with key = child}
        <Self target={child} level={level + 1} show={!folded} />
    {/for}
{/if}

<style>
.item {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
}

/* 按钮层压在上面：行是不透明的，放下面会被整片盖住 */
.actions {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    width: 132px;
    transform: translateX(100%);
    transition: transform 0.16s ease;
}

.item.open .actions {
    transform: translateX(0);
}

.action {
    flex: 1;
    border: none;
    border-radius: 0;
    font-size: 13px;
    color: #fff;
}

.action.settings {
    background: #6b7280;
}

.action.danger {
    background: #d9534f;
}

.action.danger.disabled {
    background: #9aa1ab;
}

.row {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: var(--surface);
    color: var(--text);
    touch-action: pan-y;
}

.row.active {
    background: var(--surface-2);
    box-shadow: inset 3px 0 0 var(--accent);
}

/* id + 名字：拖拽时向左让位，松手回弹 */
.head {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
}

.caret {
    flex: none;
    width: 14px;
    color: var(--text-dim);
    font-size: 11px;
    text-align: center;
    transition: transform 0.15s ease;
}

.caret.folded {
    transform: rotate(-90deg);
}

.caret.hidden {
    visibility: hidden;
}

.id {
    color: var(--text-dim);
    font-size: 12px;
    flex: none;
}

.name {
    font-size: 14px;
    white-space: nowrap;
}

.stats {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 8px;
    color: var(--text-dim);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
}
</style>
