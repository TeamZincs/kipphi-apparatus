<script>
    /*
     * 多音符批量编辑（移动端）。
     *
     * 和桌面 `MultiNoteEditor.grain` 的区别：那边用 JS 代码框任意算值，移动端
     * 键盘敲代码体验太差，所以改成**相对偏移 / 绝对值**两种输入，点「应用」
     * 一次性提交。
     *
     * 只做最常用、最安全的几项：横位置偏移、大小、透明度。时间 / 速度涉及
     * NNN 结构（`NoteTimeChangeOperation` 要 `getNodeOf`），单独一轮再做。
     */
    import { Op, type Note } from "kipphi";

    import NumField from "#/components/NumField.grain";

    import { operationList, refreshAll } from "#/store";

    let { notes, onclose } = $props<{
        notes: Note[];
        onclose: () => void;
    }>();

    /** 横位置增量（相对） */
    let offsetX = $state("0");
    /** 大小（绝对，留空不改） */
    let size = $state("");
    /** 透明度（绝对，0~255，留空不改） */
    let alpha = $state("");

    function apply(): void {
        if (!operationList || !notes.length) return;

        const dx = Number(offsetX);
        const sizeValue = size.trim() === "" ? null : Number(size);
        const alphaValue = alpha.trim() === "" ? null : Number(alpha);

        const operations: Op.Operation[] = [];

        for (const note of notes) {
            if (Number.isFinite(dx) && dx !== 0) {
                operations.push(
                    new Op.NotePropChangeOperation(
                        note,
                        "positionX",
                        note.positionX + dx,
                    ),
                );
            }

            if (sizeValue !== null && Number.isFinite(sizeValue)) {
                operations.push(
                    new Op.NotePropChangeOperation(note, "size", sizeValue),
                );
            }

            if (alphaValue !== null && Number.isFinite(alphaValue)) {
                // 透明度是 0~255 的整数
                operations.push(
                    new Op.NotePropChangeOperation(
                        note,
                        "alpha",
                        Math.min(255, Math.max(0, Math.round(alphaValue))),
                    ),
                );
            }
        }

        if (!operations.length) return;

        operationList.do(new Op.ComplexOperation(...operations));
        refreshAll();
        onclose();
    }
</script>

<div class="panel">
    <header class="head">
        <span class="title">{notes.length} 个音符</span>
        <button class="done" onclick={onclose}>关闭</button>
    </header>

    <div class="field">
        <span>横位置增量</span>
        <NumField
            bind:value={{
                get: () => offsetX,
                set: (value: string) => {
                    offsetX = value;
                }
            }}
        />
    </div>

    <div class="field">
        <span>大小</span>
        <NumField
            placeholder="不改"
            bind:value={{
                get: () => size,
                set: (value: string) => {
                    size = value;
                }
            }}
        />
    </div>

    <div class="field">
        <span>透明度（0~255）</span>
        <NumField
            placeholder="不改"
            inputmode="numeric"
            bind:value={{
                get: () => alpha,
                set: (value: string) => {
                    alpha = value;
                }
            }}
        />
    </div>

    <button class="apply" onclick={apply}>应用</button>

    <p class="hint">
        只填要改的项；「横位置增量」相对每个音符各自的位置，0 表示不动。
    </p>
</div>

<style>
    .panel {
        padding: 4px 16px 18px;
    }

    .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0 14px;
    }

    .title {
        font-size: 16px;
        font-weight: 600;
        color: var(--text);
    }

    .done {
        padding: 6px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--surface-2);
        color: var(--text);
        font: inherit;
        font-size: 13px;
    }

    .field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 9px 0;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        color: var(--text);
    }

    .apply {
        width: 100%;
        margin-top: 16px;
        padding: 11px 0;
        border: none;
        border-radius: 10px;
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-size: 15px;
        font-weight: 600;
    }

    .hint {
        margin: 12px 0 0;
        font-size: 12px;
        line-height: 1.6;
        color: var(--text-dim);
    }
</style>
