<script>
    /*
     * 排形按钮组：组内密接、无圆角，只有整组圆角；选中填强调色。
     *
     * `value` 用 `bind:value={ get: …, set: … }` 传，写回时由父级负责落操作。
     */
    /*
     * 值由 `bind:value={ get: …, set: … }` 传进来；它的 `listen` 通知由运行时
     * 接到组件的 `setProps`，这里不需要自己订阅。
     */
    let { options, value } = $props<{
        /** `[值, 显示文字]` 列表 */
        options: [number, string][];
        value: { get: () => number; set: (v: number) => void };
    }>();
</script>

<div class="segmented">
    {#for option of options with key = option[0]}
        <button
            class="seg {value.get() === option[0] ? "on" : ""}"
            onclick={() => value.set(option[0])}
        >{option[1]}</button>
    {/for}
</div>

<style>
    .segmented {
        display: flex;
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
    }

    .seg {
        flex: 1 1 0;
        min-width: 0;
        padding: 8px 12px;
        border: none;
        border-right: 1px solid var(--border);
        background: var(--bg);
        color: var(--text-dim);
        font: inherit;
        font-size: 12px;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer;
    }

    .seg:last-child {
        border-right: none;
    }

    .seg.on {
        background: var(--accent, #4c8dff);
        color: #fff;
    }
</style>
