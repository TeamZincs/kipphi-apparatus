{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
        "strict": true,
        "strictNullChecks": false,
        "noUnusedLocals": false,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        // `$state` / `$props` / `$bindable` / `$node` / `*.grain` 来自这里（runtime 自带的全局声明）
        "types": ["@graints/runtime"],
        "paths": {
            "#/*": ["./src/*"]
        }
    },
    "include": ["src", "vite.config.mts", "dependency.ts"],
    // `defs.d.ts` 是喂给 monaco 的脚本文本（用 `?raw` 读进来），里面是自定义的
    // `declare __GLOBAL__ {}` 语法，不是合法的 TS，别让 tsc 去解析它
    "exclude": ["node_modules", "src/routes/charts/[id]/defs.d.ts"]
}
