{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
        "strict": true,
        "strictNullChecks": false,
        "noUnusedLocals": false,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        // `$state` / `$props` / `$bindable` / `$node` / `*.grain` 来自这里（runtime 自带的全局声明）
        "types": ["@graints/runtime"],
        "paths": {
            "#/*": ["./src/*"]
        }
    },
    "include": ["src", "electron", "vite.config.mts", "dependency.ts"]
}
