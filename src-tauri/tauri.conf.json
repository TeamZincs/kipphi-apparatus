{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "kipphi-apparatus",
    "version": "2.2.0-alpha.5",
    "identifier": "com.zincs.kpa",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "kipphi-apparatus",
                "width": 800,
                "height": 600
            }
        ],
        "security": {
            "csp": {
                "img-src": [
                    "'self'",
                    "asset:",
                    "data:",
                    "blob:"
                ],
                "script-src": [
                    "'self'",
                    "https://esm.sh",
                    "blob:",
                    "'unsafe-eval'"
                ],
                "connect-src": [
                    "'self'",
                    "ipc:",
                    "https://esm.sh",
                    "http://ipc.localhost",
                    "http://tauri.localhost"
                ]
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$RESOURCE/**",
                    "$APPDATA/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "app",
            "appimage",
            "deb",
            "dmg",
            "nsis",
            "rpm"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "displayLanguageSelector": true,
                "languages": [
                    "SimpChinese",
                    "TradChinese",
                    "English"
                ]
            }
        },
        "licenseFile": "../LICENSE"
    },
    "plugins": {
        "fs": {}
    }
}