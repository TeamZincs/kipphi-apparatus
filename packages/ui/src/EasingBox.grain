<script>
    import { Easing, easingArray, easingMap } from "kipphi";

    /*
     * 用包内的**自引用**而不是 `./Segmented.grain`：
     * 测试会把单个组件编译到临时目录，相对路径在那儿解析不到。
     */
    import Segmented from "@kpa/ui/Segmented.grain";

    /*
     * 普通缓动选择器（桌面端 `EasingBox` 的移动版）。
     *
     * `value` 是 `easingArray` 的下标（桌面端同一套数据）：
     *   · 一个 id 输入框（0..29/31）
     *   · `in / out / IO` 三档
     *   · 函数名（linear / ease / quad …）
     * 三种改法最终都落到同一个 id 上，互相保持同步。
     */
    let { value } = $props<{
        value: { get: () => number; set: (v: number) => void };
    }>();

    const EASE_OPTIONS: [number, string][] = [
        [0, "in"],
        [1, "out"],
        [2, "IO"]
    ];

    const EASE_KINDS = ["in", "out", "inout"] as const;

    /*
     * 三段信息都做成**函数**，模板每次重算时从 `value.get()` 现读。
     * 用 `$node` 又没给 `listen` 的话，外部改了 id 它不会重算，
     * 方向 / 函数会停在旧值上。
     */
    const easeKind = (): string =>
        easingArray[value.get()]?.easeType ?? "in";
    const funcKind = (): string =>
        easingArray[value.get()]?.funcType ?? "linear";
    const funcOptions = (): [number, string][] =>
        Object.keys(easingMap).map(
            (name, index) => [index, name] as [number, string]
        );

    /** 只把"确实在预设表里"的 id 交出去，避免写出无法反序列化的缓动 */
    function applyId(id: number): void {
        if (!Number.isInteger(id) || id < 0 || id >= easingArray.length) return;
        if (!(easingArray[id] instanceof Easing)) return;

        value.set(id);
    }

    function setEaseKind(kind: number): void {
        const name = EASE_KINDS[kind] ?? "in";
        const target = (easingMap as any)[funcKind()]?.[name];

        if (target) applyId(target.id);
    }

    function setFuncKindByName(name: string): void {
        const target = (easingMap as any)[name]?.[easeKind()];

        if (target) applyId(target.id);
    }

    /** 直接填 id（0..31），越界就当没输入 */
    function setId(text: string): void {
        applyId(Number(text));
    }
</script>

<div class="row">
    <span class="label">序号</span>
    <input
        class="num"
        type="text"
        inputmode="numeric"
        bind:value={
            get: () => (Number.isInteger(value.get()) ? String(value.get()) : ""),
            set: setId
        }
    />
</div>

<div class="row">
    <span class="label">方向</span>
    <Segmented
        options={EASE_OPTIONS}
        bind:value={
            get: () => EASE_KINDS.indexOf(easeKind() as "in" | "out" | "inout"),
            set: (v: number) => setEaseKind(v)
        }
    />
</div>

<div class="row">
    <span class="label">函数</span>
    <!-- 函数种类太多（linear / ease / quad / …），按钮排塞不下，用圆角下拉框 -->
    <select
        class="pick"
        bind:value={
            get: () => funcKind(),
            set: (v: string) => setFuncKindByName(v)
        }
    >
        {#for option of funcOptions()}
            <option value={option[1]}>{option[1]}</option>
        {/for}
    </select>
</div>

<style>
    .row {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .label {
        flex: 0 0 34px;
        font-size: 12px;
        color: var(--text-dim);
    }

    .num,
    .pick {
        flex: 1 1 0;
        min-width: 0;
        box-sizing: border-box;
        padding: 8px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        appearance: none;
        -webkit-appearance: none;
    }

    .row :global(.segmented) {
        flex: 1 1 0;
        min-width: 0;
    }
</style>
