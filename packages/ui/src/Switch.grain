<script>
    /*
     * 圆角矩形开关（滑块那种），圆角半径和输入框一致。
     *
     * `checked` 是 `$bindable`：父级 `bind:checked={...}` 传进来，编译期生成
     * `__binding$checked` —— 外部变化时重新赋值并刷新用它的属性，`checked = v`
     * 也会被改写成 `__binding$checked.set(v)` 写回父级。
     */
    let { checked = $bindable(false), disabled = false } = $props<{
        checked?: boolean;
        disabled?: boolean;
    }>();

    function toggle(): void {
        if (disabled) return;

        checked = !checked;
    }
</script>

<button
    class="switch {checked ? "on" : ""} {disabled ? "disabled" : ""}"
    role="switch"
    aria-checked={checked}
    onclick={toggle}
>
    <span class="knob"></span>
</button>

<style>
    .switch {
        width: 46px;
        height: 26px;
        padding: 3px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        display: flex;
        align-items: center;
        cursor: pointer;
        transition: background 0.16s ease, border-color 0.16s ease;
    }

    .switch .knob {
        width: 18px;
        height: 18px;
        border-radius: 6px;
        background: var(--text-dim);
        transition: transform 0.16s ease, background 0.16s ease;
    }

    .switch.on {
        background: var(--accent, #4c8dff);
        border-color: transparent;
    }

    .switch.on .knob {
        transform: translateX(20px);
        background: #fff;
    }

    .switch.disabled {
        opacity: 0.4;
        cursor: default;
    }
</style>
