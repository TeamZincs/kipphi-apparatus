<script>
    /*
     * 文本输入框，样式和 `NumField` 保持一致（同一个 padding / 圆角 / 配色）。
     *
     * `value` 是 `$bindable` —— 父级 `bind:value={某个 $node}` 传进来。
     * 编译器会为它生成 `__binding$value`，外部变化时自动重新赋值并刷新
     * 用到它的属性；`value = next` 也会被改写成 `__binding$value.set(next)`。
     *
     * 所以**不要**再给 value 加 `{ get, set }` 那种包装，也**不要**在 input 上
     * 同时写 `bind:value={text}` —— `bind:` 的 getter 会盖掉 `value` 属性，
     * 输入框就只剩本地 `text`（初值空串），表现是"点一下才出现"。
     */
    let { value = $bindable(""), placeholder = "", disabled = false } = $props<{
        value?: string;
        placeholder?: string;
        disabled?: boolean;
    }>();

    /** 聚焦期间用本地草稿，失焦才写回 `value` */
    let text = $state("");
    let focused = $state(false);

    function onFocus(): void {
        focused = true;
        text = value;
    }

    function onInput(event: Event): void {
        text = (event.currentTarget as HTMLInputElement).value;
    }

    function commit(): void {
        focused = false;

        const next = text.trim();

        // 没变就不写回；空值也不写，免得把已有内容清掉
        if (next.length > 0 && next !== value) value = next;
        console.log(value);
    }
</script>

<!--
    属性必须写成 `name={值}`：`{placeholder}` 这种简写在这个编译器版本里
    不会展开，产物是 `<input {placeholder}="true" ...>`。
-->
<input
    class="text"
    type="text"
    placeholder={placeholder}
    disabled={disabled}
    value={focused ? text : value}
    onfocus={onFocus}
    oninput={onInput}
    onblur={commit}
    onkeydown={(event) => {
        if (event.key === "Enter") {
            (event.currentTarget as HTMLInputElement).blur();
        }
    }}
/>

<style>
    .text {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        /* 和 `NumField` 的 `.num` 完全一致 */
        padding: 8px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        appearance: none;
        -webkit-appearance: none;
    }
</style>
