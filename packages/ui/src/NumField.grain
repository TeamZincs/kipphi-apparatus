<script>
    /*
     * 文本/数字输入框。
     *
     * `value` 是 `$bindable` —— 父级 `bind:value={某个 $node}` 传进来。
     * 编译器为它生成 `__binding$value`：外部变化时重新赋值并刷新用到它的
     * 属性，`value = next` 也被改写成 `__binding$value.set(next)`。
     *
     * **只有失焦才回传**：输入过程中值留在草稿里，父组件不会被打字触发重算
     * （面板里那十来个字段，每敲一个字符都跑一遍操作比对太浪费）。
     *
     * 外部变化（撤销 / 从操作列表回灌）时：没聚焦就显示 `value`，聚焦中
     * 以本地草稿为准，免得把用户正在打的字冲掉。
     */
    let { value = $bindable(""), placeholder = "", inputmode = "decimal", oncommit } = $props<{
        value?: string;
        placeholder?: string;
        /** `decimal` / `numeric` / `text`，只影响手机键盘 */
        inputmode?: string;
        /** 回传之后的通知（面板用它去发对应的操作） */
        oncommit?: () => void;
    }>();

    let text = $state(value);
    let focused = $state(false);

    function onFocus(): void {
        focused = true;
        text = value;
    }

    /*
     * 不能写 `bind:value={text}`：它会盖掉上面的 `value` 属性，
     * 输入框的显示就只剩 `text`（初值是创建那一刻读到的值）——
     * 外部数据后来才到的话输入框一直空着，聚焦一次才补上。
     */
    function onInput(event: Event): void {
        text = (event.currentTarget as HTMLInputElement).value;
    }

    function commit(): void {
        focused = false;

        if (text !== value) value = text;

        oncommit?.();
    }
</script>

<input
    class="num"
    type="text"
    inputmode={inputmode}
    placeholder={placeholder}
    value={focused ? text : value}
    onfocus={onFocus}
    oninput={onInput}
    onblur={commit}
    onkeydown={(event) => {
        if (event.key === "Enter") {
            (event.currentTarget as HTMLInputElement).blur();
        }
    }}
/>

<style>
    .num {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 8px 10px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        color: var(--text);
        font: inherit;
        /* 不要浏览器那对上下箭头 */
        appearance: none;
        -webkit-appearance: none;
    }
</style>
